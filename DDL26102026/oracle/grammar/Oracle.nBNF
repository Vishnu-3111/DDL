// 
// This file is conversion of the syntax from following web site:
// https://docs.oracle.com/en/database/oracle/oracle-database/21/sqlrf/index.html#Oracle%C2%AE-Database
//

CaseInsensitive();

delimiters(<DELIMITER>);
lex(<TOKENS>);

parse(<language>);

// Lexer rules
<TOKENS>							::= <WHITESPACE> |
										<COMMENT> |
										token(<NUMBER>) |
											<STRING> |
										token(<IDENTIFIER>) |
										token(keywords());

<DELIMITER>							::= "\n" | "\r" | "\t" | " "  | "~"  |
										"`"  | "!"  | "@"  | "#"  | "$"  |
										"%"  | "^"  | "&"  | "*"  | "("  |
										")"  | "-"  | "+"  | "="  | "("  | 
										"["  | ")"  | "]"  | ";"  | ":"  | 
										"\\" | "\'" | "\"" | ","  | "<"  | 
										">"  | "/"  | "?"  | "|"  | ".";

<WHITESPACE>						::= " "  | "\r" | "\n" | "\t";

// Not sure about comment like /*...*/?
<COMMENT>							::= ("--"  skip(<eol>) <eol> )| 	
										("//" skip(<eol>) <eol> )|
										("/*" skip("*/") "*/") ;

<EOL>								::= "\r" "\n" |
										"\n";

<NUMBER>							::= ["-"]"0".."9"+;

<DECIMAL>							::= <NUMBER> ("." <NUMBER>)* ;


// Not sure about string wrapped by double quota (i.e. ")
<STRING>			::= token("\"") token(<STRINGDBODY>) token("\"") | 
						token("\'") token(<STRINGSBODY>) token("\'");
<STRINGSBODY>		::= skip("\'", "\\\'");
<STRINGDBODY>		::= skip("\"", "\\\"");

<StringAsName>		::= ( "\"" attribute("NAME", <STRINGDBODY>) "\"" )| 
						("\'" attribute("NAME", <STRINGSBODY>) "\'");
						
<StringAsValue>		::= "\"" attribute("VALUE", <STRINGDBODY>) "\"" | 
						"\'" attribute("VALUE", <STRINGSBODY>) "\'";
						



<IDENTIFIER>				::= ("a".."z" | "_"|"-") ("a".."z" | "0".."9" | "_"|"-"|"$")*;

// Parser rules
<language>					::= attributeEx("EAGENTYPE", "Oracle") attributeEx("EAMAPPING", "DDL") <statement>*;

<statement> 				::= <create_commands>
								|<administer_key_management>
								|<alter_commands>
								|<drop_commands>
								|<other_commands>
								|<SelectQuery>;


<create_commands>			::= <create_table>
								| <create_view>
								| <create_sequence>
								| <create_function>	
								| <create_procedure>	
								| <create_index>
								| <create_trigger>
								| <create_attribute_dimension>
								| <create_audit_policy>
								|<create_cluster>
								|<create_context>
								|<create_controlfile>
								|<create_data_grant>
								|<create_data_role>
								|<create_database_link>
								|<create_dimension>
								|<create_database>
								|<create_directory>
								|<create_directive>
								|<create_diskgroup>
								|<create_edition>
								|<create_flashback_archive>
								|<create_hierarchy>
								|<create_indextype>
								|<create_inmemory_join_group>
								|<create_java>
								|<create_library>
								|<create_lockdown_profile>
								|<create_materialized_zonemap>
								|<create_operation>
								|<create_outline>
								|<create_pfile>
								|<create_package_body>
								|<create_package>
								|<create_pluggable_database>
								|<create_pmem_filestore>
								|<create_profile>
								|<create_restore_point>	
								|<create_role>
								|<create_rollback_segment>
								|<create_schema>
								|<create_spfile>
								|<create_synonym>
								|<create_tablespace_set>
								|<create_tablespace>
								|<create_type_body>
								|<create_type>
								|<create_application_Identity>
								|<create_assertion>
								|<create_domain>
								|<create_json_duality_view>
								|<create_property_graph>
								|<create_mle_env>
								|<create_mle_module>
								|<create_vector_index>
								|<create_iceberg_table>
								|<create_logical_partition_tracking>
								|<create_macro>
								|<create_true_cache>
								|<create_hybrid_vector_index>
								|<create_end_user_context>
								|<create_end_user>
								|<create_user>
								;
								
<administer_key_management>	::= "ADMINISTER" "KEY" "MANAGEMENT" (<key_management_clauses>
																|<secret_management_clauses>
																|<zero_down_time_software_patching_clauses>
																|<keystore_manamagement_clauses>)
																;
																
<alter_commands>			::=<alter_analytic_view>
								|<alter_json_duality_view>
								|<alter_macro>
								|<alter_assertion>
								|<alter_atribute_dimension>
								|<alter_audit_policy>
								|<alter_cluster>
								|<alter_database_dictionary>
								|<alter_database_link>
								|<alter_database>
								|<alter_dimension>
								|<alter_directive>
								|<alter_disk_group>
								|<alter_domain>
								|<alter_end_user>
								|<alter_flashback_archive>
								|<alter_function>
								|<alter_hierarchy>
								|<alter_index>
								|<alter_index_type>
								|<alter_inmemory_join_group>
								|<alter_java>
								|<alter_library>
								|<alter_lockdown_profile>
								|<alter_materialized_view_log>
								|<alter_materialized_view>
								|<alter_materialized_zonemap>
								|<alter_mle_env>
								|<alter_mle_module>
								|<alter_operator>
								|<alter_outline>
								|<alter_package>
								|<alter_pluggable_database>
								|<alter_pmem_filestore>
								|<alter_procedure>
								|<alter_profile>
								|<alter_property_graph>
								|<alter_resource_cost>
								|<alter_role>
								|<alter_rollback_segment>
								|<alter_sequence>
								|<alter_session>
								|<alter_system>
								|<alter_table>
								|<alter_tablespace>
								|<alter_tablespace_set>
								|<alter_trigger>
								|<alter_type>
								|<alter_user>
								|<alter_view>
								|<alter_synonym>
								;
								
<drop_commands>				::=	<drop_common>
								|<drop_edition>
								|<drop_domain>
								|<drop_iceberg_table>
								|<drop_cluster>
								|("DROP" "DATABASE" [";"])
								|<drop_databaselink>
								|<drop_diskgroup>
								|<drop_index>
								|<drop_java>
								|<drop_materialized_view>
								|<drop_pluggable_database>
								|<drop_pmem_filestore>
								|<drop_table>
								|<drop_synonym>
								|<drop_restore_point>
								|<drop_tablespace>
								|<drop_type>
								|<drop_view>
								;		
											
								
								
<other_commands>				::=	<analyze_command>
									|<associate_statistics>
									|<comment_command>
									|<commit_command>
									|<call_command>
									|<disassociate_statistics>
									|<explain_plan>
									|<flashback_table>
									|<audit_command>
									|<noaudit_command>
									|<savepoint_command>
									|<grant_data_role>
									|<revoke_data_role>
									|<set_use_data_grants_only>
									|<update_end_user_context>
									|<grand_commands>
									|<insert_command>
									|<lock_table_command>
									|<merge_command>
									|<rename_command>
									|<pure_command>
									|<revoke_command>
									|<rollback_command>
									|<set_constraint>
									|<set_role>
									|<set_transaction>
									|<truncate_cluster>
									|<truncate_table>
									|<update_command>
									|<flashback_database>
									|<delete_command>
									;
								
//Vis_26112026_[261101068]_Updated CREATE TABLE: added JSON COLLECTION table type and JSON collection table body; [schema.]name and SHARING moved to <create_table_name>
//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE TABLE
<create_table>				::=  node("ELEMENT", 
										attributeEx("EATYPE", "Class")
										attributeEx("EASTEREOTYPE", "Oracle::table")
										"CREATE"  
										[( (  (("GLOBAL" node("Table Type" , attributeEx("VALUE" , "Global Temporary")))
												| ("PRIVATE" node("Table Type" , attributeEx("VALUE" , "Private Temporary")))) 
											 "TEMPORARY") 
											
											| ("SHARDED" node("Table Type" , attributeEx("VALUE" , "Shared")))
											| ("DUPLICATED" node("Table Type" , attributeEx("VALUE" , "Duplicated")))
											| ("IMMUTABLE" "BLOCKCHAIN" node("Table Type" , attributeEx("VALUE" , "Immutable Blockchain")))
											| ("BLOCKCHAIN" node("Table Type" , attributeEx("VALUE" , "Blockchain")))
											| ("IMMUTABLE" node("Table Type" , attributeEx("VALUE" , "Immutable")))		
											| ("JSON" "COLLECTION" node("Table Type" , attributeEx("VALUE" , "Json Collection")))							
										
										
										)]
										
									   "TABLE"
									   ["IF" "NOT" "EXISTS" node( "Not Exists", attributeEx("VALUE","True"))]
									  <create_table_name>
									  ( <XMLType_table> |<object_table> |<json_collection_table>| <relational_table> )
										 
									  [ "MEMOPTIMIZE" "FOR" "READ"  node("For Read" , attributeEx("VALUE" , "True"))]
									  [ "MEMOPTIMIZE" "FOR" "WRITE" node("For Write" , attributeEx("VALUE" , "True"))]
									  [ "PARENT"  node("Parent" , attribute("VALUE" , ([ <schema> "." ] <table>))) ]
									[";"]
								);
								
<XMLType_table>			::=  "OF" "XMLTYPE"  (node("Table Formats" , attributeEx("VALUE" , "XmlType")))							
							 [ "(" <obj_table_properties> ")" ]
							  [ "XMLTYPE" node("XMLType Storage" , attribute("VALUE" , <XMLType_storage>))  ]
							  [  node("XMLSchema Spec" , attribute("VALUE" , <XMLSchema_spec>))  ]
							  [ node("XMLType Virtual Columns" , attribute("VALUE" ,  <XMLType_virtual_columns>)) ]
							  [ "ON" "COMMIT" 
								( ("DELETE" node("On Commit Rows" , attributeEx("VALUE" , "Delete"))) 
									| ("PRESERVE" node("On Commit Rows" , attributeEx("VALUE" , "Preserve"))) 
									)
								"ROWS" ]
							  [ <OID_clause> ]
							 [ node("OID Index", attribute("VALUE" , <OID_index_clause>))  ]
							 [ node("Physical Properties" , attribute("VALUE" , <physical_properties>))  ]
							 [ <table_properties> ];
							  
<XMLType_virtual_columns>	::= "VIRTUAL" "COLUMNS" "("  (<column_or_string> "AS" "(" <expr> ")" ) ("," (<column_or_string> "AS" "(" <expr> ")" )  )* ")";

<column_or_string>			::=	(<column>|<StringValue>);			
								
<schema>					::= <IDENTIFIER>;
<table>					::= <IDENTIFIER>;
<table_or_string>		::=<table>|<StringValue> ;

<object_table> 			::= "OF" (node("Table Formats" , attributeEx("VALUE" , "Object")))
							   node("Object Type" , attribute("VALUE",[(<schema>|<StringValue>) "."] <table_or_string>) )
							   [ <object_table_substitution> ]							   
							   [ "(" <obj_table_properties> ")" ]	
							     [ "ON" "COMMIT" 
								( ("DELETE" node("On Commit Rows" , attributeEx("VALUE" , "Delete"))) 
									| ("PRESERVE" node("On Commit Rows" , attributeEx("VALUE" , "Preserve"))) 
									)
								"ROWS" ]
								[ <OID_clause> ]
							   [ node("OID Index", attribute("VALUE" , <OID_index_clause>))  ]
							   [ node("Physical Properties" , attribute("VALUE" , <physical_properties>))  ]
							   [<table_properties> ] ;
							   
<obj_table_properties>		::= <obj_table_memeber> ("," <obj_table_memeber>)* ;	

<obj_table_memeber>			::= (
									(<out_of_line_constraint> | <foreign_key> | ( node("Outline Reference Constraint", attribute("VALUE" ,<out_of_line_ref_constraint>))) ) 
																		
									| (node("Supplemental Log" , attribute("VALUE" , <supplemental_logging_props>) ))									
									
									|  (<obj_column_definition>)
								);
								
<obj_column_definition>		::= node("ATTRIBUTE" , attributeEx("EASTEREOTYPE", "Oracle::column")									
									((attribute("NAME" , <column> ))|<StringAsName>)
									
									[ "DEFAULT" attribute("DEFAULT" ,<expr>) ]
																		
									[ (<inline_constraint_node>) | ( node("Inline Reference Constraint" , attribute("VALUE" , <inline_ref_constraint> )))]
								);
							   
<inline_constraint_node>		::= 
									( ([ "CONSTRAINT" <constraint_name> ]( attribute("NOTNULL","NOT" "NULL"))|("NULL"))
										| ( node("CONSTRAINT",[ "CONSTRAINT" ((attribute("NAME",<constraint_name>))|(<StringAsName>)) ] "UNIQUE" attributeEx("EASTEREOTYPE","Oracle::unique") ))
										| (node("CONSTRAINT",[ "CONSTRAINT" ((attribute("NAME",<constraint_name>))|(<StringAsName>)) ] "PRIMARY" "KEY" attributeEx("EASTEREOTYPE","Oracle::PK") ))
										| (<InlineForeignkey>)
										| ( node("OPERATION", [ "CONSTRAINT" ((attribute("NAME",<constraint_name>))|(<StringAsName>)) ] "CHECK" attributeEx("EASTEREOTYPE","Oracle::check") "(" attribute("CODE", <boolean_condition>) ")"))
									)
									[ <constraint_state> ]
									;
							   
<InlineForeignkey>			::=	node("CONSTRAINT",
									"REFERENCES"
									attributeEx("EASTEREOTYPE", "Oracle::FK")
									node("TARGET",[ (<schema>|<StringValue>) "." ] ((attribute("NAME", <ref_table_name>))|<StringAsName>) [ "(" <singleColumnConstraint> ("," <singleColumnConstraint>)*  ")" ] )
									["ON" "DELETE" 
										( ("CASCADE" node("Delete" , attributeEx("VALUE" , "Cascade"))) 
										| ("SET" "NULL" node("Delete" , attributeEx("VALUE" ,"Set Null")))								
										) ] 
								);
								
								
<ref_table_name>			::=  <IDENTIFIER> ;

<singleColumnConstraint>	::=   node("PARAMETER", ((attribute("NAME", <IDENTIFIER>))|<StringAsName>)) ;


<OID_index_clause>			::= "OIDINDEX" [ <index> ]
								"(" ( <physical_attributes_clause> | ("TABLESPACE" <tablespace>) )* ")";
							   
<OID_clause>			::= "OBJECT" "IDENTIFIER" "IS"
							( ("SYSTEM" "GENERATED" node("Object Identifier" , attributeEx("VALUE" ,"System Generated"))) 
							| ("PRIMARY" "KEY" node("Object Identifier" , attributeEx("VALUE" ,"Primary Key"))) );
					   
<object_table_substitution>	::= ("NOT" "SUBSTITUTABLE" "AT" "ALL" "LEVELS" node("Table Substitution" , attributeEx("VALUE" , "No")))
								| ("SUBSTITUTABLE" "AT" "ALL" "LEVELS" node("Table Substitution" , attributeEx("VALUE" , "Yes")));
							   
<object_type>			::= <IDENTIFIER>|<StringValue> ;


// JSON_Collection_table (26ai): [ WITH ETAG ] [ ( expression_column [, ...], constraint [, ...] ) ] ...
// Without WITH ETAG the body has the same shape as a relational table, so <relational_table> covers it.
// [schema.] table [SHARING = ...], shared by every CREATE TABLE form. Attributes land on the table ELEMENT.
//Vis_26112026_[261101068]_Helper: [schema.]table name and SHARING clause shared by every CREATE TABLE form
<create_table_name>		::= [ node("Database and Schema" , ((attribute("VALUE",<schema>  ))|<StringAsValue>)".") ]
							  (attribute("NAME" , <table>)|<StringAsName>)
							  [ "SHARING" "=" ( 
								("METADATA" node("Sharing Clause", attributeEx("VALUE" , "Metadata"))) 
								| ("DATA" node("Sharing Clause", attributeEx("VALUE" , "Data"))) 
								| ("EXTENDED" "DATA" node("Sharing Clause", attributeEx("VALUE" , "Extended Data"))) 
								| ("NONE" node("Sharing Clause", attributeEx("VALUE" , "None"))) 
								) ] ;

// JSON_Collection_table (26ai): WITH ETAG [ ( columns / constraints ) ] [ physical_properties ] [ table_properties ].
// WITH ETAG is required here: this rule is tried before <relational_table>, and an all-optional rule would
// always match empty and stop every CREATE TABLE before its column list. Without WITH ETAG a JSON
// collection table is parsed by <relational_table>.
//Vis_26112026_[261101068]_Added JSON collection table body (WITH ETAG followed by relational table body)
<json_collection_table>	::= "WITH" "ETAG" node("Etag",attributeEx("VALUE", "With Etag"))
							<relational_table> ;

//Vis_26112026_[261101070]_Added ANNOTATIONS clause to relational table properties (after column list and at end of table)
//Vis_26112026_[261101071]_Fixed ROW ARCHIVAL keyword literal split into separate tokens
<relational_table>		::= 
							[ "(" <relational_properties> ")" ]
							[ (node("Annotations clause",attribute("VALUE",<annotations_clause>))) ]							
							[ node("Immutable Table" , attribute("VALUE" , <immutable_table_clauses>)) ]
							[ node("Blockchain Table" , attribute("VALUE" , <blockchain_table_clauses>)) ]
							[ "DEFAULT" "COLLATION"  node("Collation" , attribute("VALUE" , <collation_name>)) ]
							[ "ON" "COMMIT" 
								( ("DROP" node("On Commit Definition" , attributeEx("VALUE" , "Drop")))
								| ("PRESERVE" node("On Commit Definition" , attributeEx("VALUE" , "Preserve"))) 
								) 
							"DEFINITION" ]
							[ "ON" "COMMIT" 
								( ("DELETE" node("On Commit Rows" , attributeEx("VALUE" , "Delete"))) 
								| ("PRESERVE" node("On Commit Rows" , attributeEx("VALUE" , "Preserve"))) 
								)
							"ROWS" ]
							
							 [ (node("Physical Properties" , attribute("VALUE" , <physical_properties>)))  ]
							
							[ "OPAQUE" "TYPE" node("Opaque Type", attribute("VALUE","(" <column_or_string> ")" "STORE" "AS" ("SECUREFILE"|"BASICFILE") "LOB" "(" skipBalanced( "(",")" ) ")" ["UNPACKED"]))]
							[ <table_properties> ]
							;


<table_properties>		::= [ node("Column Properties" , attribute("VALUE" , (<column_properties>*))) ]
							[ <read_only_clause> ]
							[ <indexing_clause> ]
							[ node("Table Partition" , attribute("VALUE" , <table_partitioning_clauses>)) ]							
							[ node("Attribute Clustering" , attribute("VALUE" , <attribute_clustering_clause>)) ]
							[ ("CACHE" node("Caching Option", attributeEx("VALUE"  , "Cache"))) 
								| ("NOCACHE"  node("Caching Option", attributeEx("VALUE"  , "No Cache"))) ]
							[ node("Result Cache" , attribute("VALUE" ,<result_cache_clause>)) ] 
							[ <parallel_clause> ]
							[ ("ROWDEPENDENCIES"  node("Row Dependencies" , attributeEx("VALUE" , "Yes"))) 
								| ("NOROWDEPENDENCIES" node("Row Dependencies" , attributeEx("VALUE" , "No"))) ]
							[ node("Enable Disable Clause" , attribute("VALUE", (<enable_disable_clause>*)))]
							[ <row_movement_clause>  ]
							[ node("Logical Replication" , attribute("VALUE" , <logical_replication_clause>)) ]
							[ <flashback_archive_clause> ]
							[ "ROW" "ARCHIVAL"  node("Row Archival" , attributeEx("VALUE" , "True"))]
							[ <annotations_clause> ]
							[ ("AS"  node("Select Query" , attribute("VALUE" , <subquery>)) )
							| ( "FOR" "EXCHANGE" "WITH" "TABLE" 
								node("Exchange with" , attribute("VALUE" , ([ (<schema>|<StringValue>) "."] <table_or_string> )))) ]
							[ node("OID Index", attribute("VALUE" , <OID_index_clause>))  ]
							[ ( "ALLOW" | "DISALLOW" ) "NONSCHEMA" ]
							[ ( "ALLOW" | "DISALLOW" ) "ANYSCHEMA" ]
							
							;
							
<flashback_archive_clause>	::= ("FLASHBACK" "ARCHIVE" node("Flashback Archive" , attributeEx("VALUE","Yes")) 
									[node("Flashback Archive Value" , attribute("VALUE" ,<flashback_archive> ))]) 
									| ("NO" "FLASHBACK" "ARCHIVE"  node("Flashback Archive" , attributeEx("VALUE","No"))  );

<flashback_archive>			::= <IDENTIFIER> ;
							
<logical_replication_clause>	::= ( ("DISABLE" "LOGICAL" "REPLICATION") | ("ENABLE" "LOGICAL" "REPLICATION" [ ("ALL" "KEYS") | ("ALLOW" "NOVALIDATE" "KEYS") ] )) ;
							
<row_movement_clause>		::= ( ("ENABLE" node("Row Movement" , attributeEx("VALUE" , "Enable"))) 
								| ("DISABLE" node("Row Movement" , attributeEx("VALUE" , "Disable"))) ) "ROW" "MOVEMENT";
							
<enable_disable_clause>		::= ( "ENABLE" | "DISABLE" )
								[ "VALIDATE" | "NOVALIDATE" ]
								( ("UNIQUE" "("<column_or_string> ("," <column_or_string>)* ")" )
									| ("PRIMARY" "KEY")
									| ("CONSTRAINT" (<constraint_name>|<StringValue>))
								)
								[ <using_index_clause> ]
								[ <exceptions_clause> ]
								[ "CASCADE" ]
								[ ( "KEEP" | "DROP" ) "INDEX" ];
							
		
							
<result_cache_clause>	::= "RESULT_CACHE"  ( "(" 
							( [ "MODE" ("DEFAULT" | "FORCE") ] [ "," "STANDBY" ("ENABLE" | "DISABLE") ] )
							|
							( [ "STANDBY" ("ENABLE" | "DISABLE") ] [ "," "MODE" ("DEFAULT" | "FORCE") ] )    
						   ")" ) ;
							
<attribute_clustering_clause>	::= "CLUSTERING" [ <clustering_join> ] <cluster_clause>
											[ <clustering_when> ] [ <zonemap_clause> ];
											
<zonemap_clause>			::= ( "WITH" "MATERIALIZED" "ZONEMAP" [ "(" <zonemap_name> ")" ] )
								|
								( "WITHOUT" "MATERIALIZED" "ZONEMAP" );
								
<zonemap_name>				::= <IDENTIFIER>;
											
<clustering_when>			::= [ ( "YES" | "NO" ) "ON" "LOAD" ] [ ( "YES" | "NO" ) "ON" "DATA" "MOVEMENT" ] ;
											
<cluster_clause>			::= "BY" [ "LINEAR" | "INTERLEAVED" ] "ORDER" <clustering_columns> ;

<clustering_columns>		::=  ["("] <clustering_column_group> ("," <clustering_column_group> )* [")"];

<clustering_column_group>	::= "(" <column_or_string> ("," <column_or_string>)* ")";
											
<clustering_join>			::= [ (<schema>|<StringValue>)"." ] <table_or_string> <clustering_join_values> ("," <clustering_join_values>)* ; 
											
<clustering_join_values>	::= "JOIN" [ (<schema>|<StringValue>) "." ] <table_or_string> "ON" "(" <join_condition> ")"  ;
							
<table_partitioning_clauses>	::= ( <composite_range_partitions>
										| <range_partitions>
										| <list_partitions>
										| <hash_partitions> 
										| <composite_list_partitions>
										| <composite_hash_partitions>
										| <reference_partitioning>
										| <system_partitioning>
										| <consistent_hash_partitions>
										| <consistent_hash_with_subpartitions>
										| <partitionset_clauses>
										
									);
									
<partitionset_clauses>				::= ( <range_partitionset_clause> | <list_partitionset_clause> );

<list_partitionset_clause>			::= "PARTITIONSET" "BY" "LIST" "(" <column_or_string> ")"
										  "PARTITION" "BY" "CONSISTENT" "HASH" "(" <column_or_string> ("," <column_or_string>)* ")"
										  [ "SUBPARTITION" "BY" ( (( "RANGE" | "HASH" ) "(" <column_or_string> ("," <column_or_string>)* ")")
																| ("LIST" "(" <column_or_string> ")" )
															)
											[ <subpartition_template> ]
										  ]
										  "PARTITIONS" "AUTO" "(" <list_partitionset_desc> ("," <list_partitionset_desc>)* ")";
										  
<list_partitionset_desc>			::= "PARTITIONSET" <partition_set> <list_values_clause>
										  [ "TABLESPACE" "SET" <tablespace_set> ]
										  [ <LOB_storage_clause> ]
										  [ "SUBPARTITIONS" "STORE" "IN" "(" <tablespace_set> ("," <tablespace_set>)* ")" ];
										  
<partition_set>						::= <IDENTIFIER> ;

<range_partitionset_clause>			::= "PARTITIONSET" "BY" "RANGE" "(" <column_or_string> ("," <column_or_string>)* ")"
										  "PARTITION" "BY" "CONSISTENT" "HASH" "(" <column_or_string> ("," <column_or_string>)* ")"
										  [ "SUBPARTITION" "BY" ( (( "RANGE" | "HASH" ) "(" <column_or_string> ("," <column_or_string>)* ")")
															| ("LIST" "(" <column_or_string> ")")
															)
											[ <subpartition_template> ]
										  ]
										  "PARTITIONS" "AUTO" "(" <range_partitionset_desc> ("," <range_partitionset_desc>)* ")";
										  
<range_partitionset_desc>				::= "PARTITIONSET" <partition_set> <range_values_clause>
											  [ "TABLESPACE" "SET" <tablespace_set> ]
											  [ <LOB_storage_clause> ]
											  [ "SUBPARTITIONS" "STORE" "IN" "(" <tablespace_set> ("," <tablespace_set>)* ")" ];
									
<consistent_hash_with_subpartitions>	::= "PARTITION" "BY" "CONSISTENT" "HASH" "(" <column_or_string> ("," <column_or_string> )* ")"
											  ( <subpartition_by_range>
												  | <subpartition_by_list>
												  | <subpartition_by_hash>
											  )
											  [ "PARTITIONS" "AUTO" ];
									
<consistent_hash_partitions>	::= "PARTITION" "BY" "CONSISTENT" "HASH" "(" <column_or_string> ("," <column_or_string>)* ")"
									[ "PARTITIONS" "AUTO" ] "TABLESPACE" "SET" <tablespace_set>;
									
<system_partitioning>			::= "PARTITION" "BY" "SYSTEM" [ ("PARTITIONS" <NUMBER>)
										| (<reference_partition_desc> ("," <reference_partition_desc>)* )
										];
									

<reference_partitioning>		::= "PARTITION" "BY" "REFERENCE" "(" <constraint> ")" 
									[ "(" <reference_partition_desc>* ")" ];
									
<reference_partition_desc>		::= "PARTITION" [<partition>] [<table_partition_description>] ;
									
<constraint>					::= <IDENTIFIER>|<StringValue>;
									
<composite_hash_partitions>		::= "PARTITION" "BY" "HASH" "(" <column_or_string> ("," <column_or_string> )* ")"
									  ( <subpartition_by_range>| <subpartition_by_list> | <subpartition_by_hash> )
									  ( <individual_hash_partitions>| <hash_partitions_by_quantity> );
									
<composite_list_partitions>			::= "PARTITION" "BY" "LIST" "(" <column_or_string> ("," <column_or_string>)* ")"
										[ "AUTOMATIC" [ "STORE" "IN" "(" <tablespace> ("," <tablespace> )* ")" ] ]
										 [ ( <subpartition_by_range>
											| <subpartition_by_list>
											| <subpartition_by_hash>
										  )]
										"(" <list_partition_desc> ("," <list_partition_desc>)* ")";
										
<list_partition_desc>			::= "PARTITION" [<partition>]
									<list_values_clause>
									<table_partition_description>
									  [ ("(" ( (<range_subpartition_desc> ("," <range_subpartition_desc>)* )
											  | (<list_subpartition_desc> ("," <list_subpartition_desc>)*)
											  | (<individual_hash_subparts> ("," <individual_hash_subparts>)*)
										)")")
										| (<hash_subparts_by_quantity>)
									  ];
									
<composite_range_partitions>	::= "PARTITION" "BY" "RANGE" "(" <column_or_string> ("," <column_or_string>)* ")"
								  [ "INTERVAL" "(" <expr> ")" [ "STORE" "IN" "(" <tablespace> ("," <tablespace>)* ")" ]]
								  ( <subpartition_by_range> | <subpartition_by_list> | <subpartition_by_hash> )
								"(" <range_partition_desc> ("," <range_partition_desc>)* ")";
								
<range_partition_desc>			::= "PARTITION" [<partition>]
									<range_values_clause>
									<table_partition_description>
									(
										[ ("(" ( (<range_subpartition_desc> ("," <range_subpartition_desc>)*)
													| (<list_subpartition_desc> ("," <list_subpartition_desc>)*)
													| (<individual_hash_subparts> ("," <individual_hash_subparts>)* )
												)
										  ")" )| (<hash_subparts_by_quantity>) ]									  
									  );

<hash_subparts_by_quantity>		::= <NUMBER>;						  	
								
<subpartition_by_hash>			::= "SUBPARTITION" "BY" "HASH" "(" <column_or_string> ("," <column_or_string> )* ")"
									   [ ("SUBPARTITIONS" <NUMBER>
											[ "STORE" "IN" "(" <tablespace> ("," <tablespace> )* ")" ])
									   |(<subpartition_template>)
									   ]; 
								
<subpartition_by_list>			::= "SUBPARTITION" "BY" "LIST" "(" <column_or_string> ("," <column_or_string>)* ")" [ <subpartition_template> ] ;
								
<subpartition_by_range>			::= "SUBPARTITION" "BY" "RANGE" "(" <column_or_string> ("," <column_or_string>)* ")" [<subpartition_template>];		

<subpartition_template>			::= "SUBPARTITION" "TEMPLATE"
									  ("(" ( ( <range_subpartition_desc> ("," <range_subpartition_desc>)*)
											| (<list_subpartition_desc> ("," <list_subpartition_desc>)*)
											| (<individual_hash_subparts> ("," <individual_hash_subparts>)*)
										)
									  ")") | ( <hash_subpartition_quantity> )	;	
									  
<individual_hash_subparts>		::= "SUBPARTITION" [<subpartition>] [<read_only_clause>] [<indexing_clause>] [<partitioning_storage_clause>] ;
									  
<hash_subpartition_quantity>	::= <NUMBER> ;
									  
<list_subpartition_desc>		::= "SUBPARTITION" [<subpartition>] <list_values_clause>
									  [<read_only_clause>] [<indexing_clause>] [<partitioning_storage_clause>]
									  [<external_part_subpart_data_props>]
									  ;
									  
<list_values_clause>			::= "VALUES" "(" <list_values> | "DEFAULT" ")";

<list_values>					::= <list_values_in_comma> ("," <list_values_in_comma>)*;

<list_values_in_comma>			::=  ["("] (<literal> | "NULL")  [")"] ;
									  
<range_subpartition_desc>		::= "SUBPARTITION" [<subpartition>] <range_values_clause>
									  [<read_only_clause>] [<indexing_clause>] [<partitioning_storage_clause>]
									  [<external_part_subpart_data_props>];
									
<hash_partitions>			::= "PARTITION" "BY" "HASH" "(" <column_or_string> ("," <column_or_string>)* ")"
									( <individual_hash_partitions> | <hash_partitions_by_quantity> );
									
<list_partitions>			::= "PARTITION" "BY" "LIST" "(" <column_or_string> ("," <column_or_string>)* ")"
									[ "AUTOMATIC" [ "STORE" "IN" "(" <tablespace> ("," <tablespace>)* ")" ] ]
									"(" <range_partition_value>	 ("," <range_partition_value>)* ")";
									
<range_partitions>			::= "PARTITION" "BY" "RANGE" "(" <column_or_string> ("," <column_or_string>)* ")"
								  [ "INTERVAL" "(" skipBalanced("(",")") ")" [ "STORE" "IN" "(" <tablespace> ("," <tablespace>)* ")" ]]
								"(" skipBalanced("(",")")")";
								
								
<range_partition_value>		::= "PARTITION" [ <partition> ] <range_values_clause> <table_partition_description> [ <external_part_subpart_data_props> ] ;

<external_part_subpart_data_props>	::= [ "DEFAULT" "DIRECTORY" <directory> ]
										[ "LOCATION"  "(" ([ <directory> ":" ] <location_specifier>)  ("," ([ <directory> ":" ] <location_specifier>))* ")" ];

<table_partition_description>	::=  [ ( "INTERNAL" | "EXTERNAL" ) ]
										[ <deferred_segment_creation> ]
										[ <read_only_clause> ]
										[ <indexing_clause> ]
										[( <segment_attributes_clause>|
										 <table_compression> | <prefix_compression>) *]
										[ <inmemory_clause> ]
										[ <ilm_clause> ]
										[ "OVERFLOW" [ <segment_attributes_clause> ] ]
										[ ( <LOB_storage_clause> | <varray_col_properties> | <nested_table_col_properties> )* ];
										
<inmemory_clause>			::= ("INMEMORY" [ <inmemory_attributes> ] ["TEXT" ( ("(" <column_or_string> ")" ) | ( "(" <column_or_string> "USING" <policy_name> ")") )]) | ("NO" "INMEMORY");

<range_values_clause>		::= "VALUES" "LESS" "THAN" "(" ( <literal> | "MAXVALUE" ) ")";
							
<indexing_clause>		::= "INDEXING" ( (
											("ON" node("Indexing" , attributeEx("VALUE" , "On"))) 
											| ("OFF" node("Indexing" , attributeEx("VALUE" , "Off")))
											) );

<read_only_clause>		::= ( "READ" "ONLY"  node("Read Only Clause" , attributeEx("VALUE" , "Read Only")))
						| ( "READ" "WRITE" node("Read Only Clause" , attributeEx("VALUE" , "Read Write")) );						

<column_properties>		::= ( ( <object_type_col_properties> )
								| (<nested_table_col_properties>)
								| (( <varray_col_properties> | <LOB_storage_clause> )
									[ "(" <LOB_partition_storage>  ("," <LOB_partition_storage>)* ")" ])
								| (<XMLType_column_properties>)
							);	
							
<LOB_storage_clause>	::= "LOB"
							( "(" <LOB_item> ("," <LOB_item>)* ")" "STORE" "AS" 
								( (("SECUREFILE" | "BASICFILE" ) [<StringValue>]| ("(" <LOB_storage_parameters> ")" ))* | (<LOB_segname>))								
							);
							
<XMLType_column_properties>	::= "XMLTYPE" [ "COLUMN" ] <column_or_string>
							   [ <XMLType_storage> ]
							   [ <XMLSchema_spec> ];		
							   
<XMLSchema_spec>			::=   [ "XMLSCHEMA" <XMLSchema_URL> ]
									"ELEMENT" ( <element> | (<XMLSchema_URL> "#" <element>) )
									  [ "STORE" "ALL" "VARRAYS" "AS" ( "LOBS" | "TABLES" ) ]
									  [ ( "ALLOW" | "DISALLOW" ) "NONSCHEMA" ]
									  [ ( "ALLOW" | "DISALLOW" ) "ANYSCHEMA" ];
									  
<XMLSchema_URL>				::=  <StringValue>;

<element>				::= <IDENTIFIER> | <StringValue> ;

<XMLType_storage>			::= "STORE"
								( "AS"
									(( ( "OBJECT" "RELATIONAL")
										| ( ["SECUREFILE" | "BASICFILE"]
											( ("CLOB") |( "BINARY" "XML") )
										[ (( <LOB_segname> [ "(" <LOB_parameters> ")" ])| ("(" <LOB_parameters>* ")") )])
									)
									| ( "ALL" "VARRAYS" "AS" ( "LOBS" | "TABLES" ) ))
								);				   	
								
<LOB_parameters>			::= ( (( "ENABLE" | "DISABLE" ) "STORAGE" "IN" "ROW" [<NUMBER>])
								  | ("CHUNK" <NUMBER>)
								  | ("PCTVERSION" <NUMBER>)
								  | ("FREEPOOLS" <NUMBER>)
								  | (<LOB_retention_clause>)
								  | (<LOB_deduplicate_clause>)
								  | (<LOB_compression_clause>)
								  | ( ("ENCRYPT" <encryption_spec>) | "DECRYPT" )
								  | (( "CACHE" | "NOCACHE" | ("CACHE" "READS") ) [ <logging_clause> ] )
								  | ( ("TABLESPACE" <tablespace>) | ("TABLESPACE" "SET" <tablespace_set> ))
								  | (<storage_clause>)
								  
								  
								);
							
<LOB_partition_storage>		::= "PARTITION" <partition>
								( <LOB_storage_clause> | <varray_col_properties> )*
								[ "(" "SUBPARTITION" <subpartition>
										( <LOB_partitioning_storage> | <varray_col_properties> )*
									")"
								];
								
<subpartition>			::= <IDENTIFIER>|<StringValue>;
							
<varray_col_properties>	::= "VARRAY" <varray_item> 
								( [ <substitutable_column_clause> ] [<varray_storage_clause>]);
								
<varray_storage_clause>	::= "STORE" "AS" ["SECUREFILE" | "BASICFILE"] "LOB"
							( [<LOB_segname>] ["(" <LOB_storage_parameters> ")"] );
							

							
<LOB_storage_parameters>	::= ((  ( ("TABLESPACE" <tablespace>) | ("TABLESPACE" "SET" <tablespace_set> ))
									|(<LOB_parameters> [<storage_clause>])
								  
								) | (<storage_clause>))*;
								
<LOB_compression_clause>		::= ( ("COMPRESS" ["HIGH" | "MEDIUM" | "LOW" ] )| "NOCOMPRESS" );
								
<LOB_retention_clause>		::= "RETENTION" ["MAX" |( "MIN" <NUMBER>) | "AUTO" | "NONE" ] ;

<LOB_deduplicate_clause>	::=  ( "DEDUPLICATE" | "KEEP_DUPLICATES" );

<nested_table_col_properties>	::= ["("]  "NESTED" "TABLE"
									(  "COLUMN_VALUE" | <nested_item>  )
									[ <substitutable_column_clause> ]
									[ "LOCAL" | "GLOBAL" ]
									"STORE" "AS" <storage_table>
									[ "(" ( ("(" <object_properties> ")")
										| (<physical_properties> )
										| (<column_properties>)
										)
									  ")"
									]
									[ "RETURN" [ "AS" ]  ( "LOCATOR" | "VALUE" ) ] [")"] ;	
									
<storage_table>				::= <IDENTIFIER>|<StringValue>;
									
<object_properties>			::= ( (( <column_or_string> | <attributes> )
									[ "DEFAULT" <expr> ]
									[ ( <inline_constraint_tag> )*  | <inline_ref_constraint> ])
									| ( <out_of_line_constraint_tag>
										  | <out_of_line_ref_constraint>
										  | <supplemental_logging_props>
								  )
								);

<attributes>				::= <IDENTIFIER> ;									
<nested_item>				::= <IDENTIFIER>|<StringValue> ;									

<object_type_col_properties>	::= "COLUMN" <column_or_string> <substitutable_column_clause>;	

<substitutable_column_clause>	::= ( ([ "ELEMENT" ] "IS" "OF" [ "TYPE" ] "(" "ONLY" <type> ")" )
										| ([ "NOT" ] "SUBSTITUTABLE" "AT" "ALL" "LEVELS")
									);		

<type>				::= <IDENTIFIER>;									

<physical_properties>		::= ["USAGE"<IDENTIFIER>](([ <deferred_segment_creation> ] "ORGANIZATION"
										  ( ("HEAP" [ <segment_attributes_clause>* ] <heap_org_table_clause> )
											  | ( "INDEX" [ <segment_attributes_clause>* ] <index_org_table_clause>)
											  | ("EXTERNAL" ["PARTITION"] ["ATTRIBUTES"] <external_table_clause> [ "REJECT" "LIMIT" ])
										  )
									  ) 
																	  
									| ("CLUSTER" <cluster> "(" <column_or_string> ("," <column_or_string>)* ")")
									|( [ <deferred_segment_creation> ] (<segment_attributes_clause>  |<table_compression> )*
										[ <inmemory_table_clause> ] [ <ilm_clause> ] ))
								;
								
<external_table_clause>		::= "(" [ "TYPE" <access_driver_type> ] [ <external_table_data_props> ] ")"
								[ "REJECT" "LIMIT" ( <NUMBER> | "UNLIMITED" ) ]
								[ <inmemory_table_clause> ];	
								
<external_table_data_props>	::= [ "DEFAULT" "DIRECTORY" <directory> ]
								[ "ACCESS" "PARAMETERS"
								  ( ("(" skipBalanced("(",")") ")")
									| ("USING" "CLOB" <subquery>)
								  )
								]
								[ "LOCATION"  "(" [ <directory> ":" ] <location_specifier> ")" ];
								
<access_driver_type>		::= <IDENTIFIER>;							
<directory>		::= <IDENTIFIER> | <StringValue>;							
<subquery>		::= <SelectQuery>;							
<location_specifier>		::= <StringValue>;	

<opaque_format_spec>		::= ("RECORDS" "DELIMITED" "BY" <IDENTIFIER> ["CHARACTERSET" "UTF8"] )
								| ( "BADFILE" <StringValue>)
								| ( "DISCARDFILE" <StringValue>)
								| ( "LOGFILE" <StringValue>)
								| ("SKIP" <NUMBER>)
								| ( "FIELDS" "TERMINATED" "BY" <StringValue> "OPTIONALLY" "ENCLOSED" "BY" <StringValue>
									"(" ((<column_or_string> <uneffected_datatype> ["EXTERNAL" "("<NUMBER>")"]) ("," (<column_or_string> <uneffected_datatype> ["EXTERNAL" "("<NUMBER>")"]))*) ")"
								  )
								  |("DISABLE_DIRECTORY_LINK_CHECK")
								  |("READSIZE" <NUMBER>)
								;
								
<index_org_table_clause>	::= [ ((<mapping_table_clause>)
										| ("PCTTHRESHOLD" <NUMBER>)
										| (<prefix_compression>)
										| (<index_org_overflow_clause>)
									)*
								] ;
								
<index_org_overflow_clause>	::=   ( "INCLUDING" <column_or_string> ) | ("OVERFLOW")| 
									(  
										(( ("TABLESPACE" <tablespace>) | ("TABLESPACE" "SET" <tablespace_set>) )
											
											| (("PCTFREE" <NUMBER>)
												  | ("PCTUSED" <NUMBER>)
												  | ("INITRANS" <NUMBER>)
												  |	("MAXTRANS" <NUMBER>)
												  | ("STORAGE"
														"(" ( ("INITIAL" <size_clause>)
																 | ("NEXT" <size_clause>)
																 | ("MINEXTENTS" <NUMBER>)
																 | ("MAXEXTENTS" ( <NUMBER> | "UNLIMITED" ))
																 | (<maxsize_clause>)
																 | ("PCTINCREASE" <NUMBER>)
																 | ("FREELISTS" <NUMBER>)
																 | ("FREELIST" "GROUPS" <NUMBER>)
																 | ("OPTIMAL" [ <size_clause> | "NULL" ])
																 | ("BUFFER_POOL" ( "KEEP" | "RECYCLE" | "DEFAULT" ))
																 | ("FLASH_CACHE" ( "KEEP" | "NONE" | "DEFAULT" ))
																 | ("CELL_FLASH_CACHE" ( "KEEP" | "NONE" | "DEFAULT" ))
																 |("(" skipBalanced("(",")") ")")
																 | ("ENCRYPT")
															)*
														")")
												)
											| (<logging_clause>)
										) 
									);
								
<mapping_table_clause>		::= ( ("MAPPING" "TABLE") | ("NOMAPPING") );
								
<heap_org_table_clause>		::= [ <table_compression> ] [ <inmemory_table_clause> ] [ <ilm_clause> ];
								
<ilm_clause>				::= "ILM"
								( ("ADD" "POLICY" <ilm_policy_clause>)
									| (("DELETE" | "ENABLE" | "DISABLE" ) "POLICY" <ilm_policy_name>)
									| ("DELETE_ALL" | "ENABLE_ALL" | "DISABLE_ALL")
								);
								
<ilm_policy_clause>			::= ( <table_compression> ( "SEGMENT" | "GROUP" ) 
									 ( ( "AFTER" <ilm_time_period> "OF" ( ( "NO" "ACCESS" ) | ( "NO" "MODIFICATION" ) | "CREATION" ) ) | ( "ON" <function_name> ) )
								)
								| ( ( ("ROW" "STORE" "COMPRESS" "ADVANCED") | ("COLUMN" "STORE" "COMPRESS" "FOR" "QUERY") ) "ROW" "AFTER" <ilm_time_period> "OF" "NO" "MODIFICATION" );
								
<ilm_time_period>			::= <NUMBER>;

<ilm_policy_name>			::= <IDENTIFIER>;
//Vis_26112026_[261101072]_Removed <StringValue> alternative from <function_name> (quoted names in CREATE FUNCTION fall through to <StringAsName>)
<function_name>			::= <IDENTIFIER>;
								
<inmemory_table_clause>		::= [ ( "INMEMORY" [ <inmemory_attributes> ] ) | ( "NO" "INMEMORY" ) ]
								[ <inmemory_column_clause>* ];
								
<inmemory_column_clause>	::= ( ("INMEMORY" [ <inmemory_memcompress> ]) | ("NO" "INMEMORY") ) "(" <column_or_string> ("," <column_or_string> )* ")" ;
								
<inmemory_attributes>		::= [ <inmemory_memcompress> ] [ <inmemory_priority> ] [ <inmemory_distribute> ] 
								[ <inmemory_duplicate> ] [ <inmemory_spatial> ] ;
								
<inmemory_spatial>			::= "SPATIAL" <column_or_string> ;
								
<inmemory_duplicate>		::= ("DUPLICATE") | ("DUPLICATE" "ALL") | ("NO" "DUPLICATE");
								
								
<inmemory_distribute>		::= "DISTRIBUTE" [ "AUTO" | ("BY" ( ("ROWID" "RANGE") | "PARTITION" | "SUBPARTITION" )) ]
								[ "FOR" "SERVICE" ( "DEFAULT" | "ALL" | "NONE" | <service_name> ) ];
								
<service_name>				::= <IDENTIFIER> ;
								
<inmemory_memcompress>		::= ("MEMCOMPRESS" "FOR" ( "DML" | ("QUERY" [ "LOW" | "HIGH" ]) | ("CAPACITY" [ "LOW" | "HIGH" ]) ))
									| ("NO" "MEMCOMPRESS")
									| ("MEMCOMPRESS" "AUTO");
									
<inmemory_priority>			::= "PRIORITY" ( "NONE" | "LOW" | "MEDIUM" | "HIGH" | "CRITICAL" );
								
<table_compression>			::= ("COMPRESS")
								| ("ROW" "STORE" "COMPRESS" [ "BASIC" | "ADVANCED" ])
								|( "COLUMN" "STORE" "COMPRESS" [  "FOR" ( "QUERY" | "ARCHIVE" ) [ "LOW" | "HIGH" ] ]
								  [ ["NO"] "ROW" "LEVEL" "LOCKING" ])
								| ("NOCOMPRESS" ["LOGGING"]);
								
<deferred_segment_creation> ::= "SEGMENT" "CREATION" ( "IMMEDIATE" | "DEFERRED" );

							
<collation_name>		::= <IDENTIFIER> ;

<blockchain_table_clauses>	::=  <blockchain_drop_table_clause>  <blockchain_row_retention_clause>  <blockchain_hash_and_data_format_clause> ;

<blockchain_hash_and_data_format_clause>	::= "HASHING" "USING" <IDENTIFIER> "VERSION" <IDENTIFIER>;

<blockchain_drop_table_clause>	::=  "NO" "DROP" [ "UNTIL" <NUMBER> "DAYS" "IDLE" ];

<blockchain_row_retention_clause>	::= "NO" "DELETE" "(" ([ "LOCKED" ]) | ("(" "UNTIL" <NUMBER> "DAYS" "AFTER" "INSERT" ["LOCKED"] ")") ")";
							
<immutable_table_clauses>		::= [ <immutable_table_no_drop_clause> ] [ <immutable_table_no_delete_clause> ];

<immutable_table_no_drop_clause>	::=  "NO" "DROP" [ "UNTIL" <NUMBER> "DAYS" "IDLE" ];

<immutable_table_no_delete_clause>	::= "NO" "DELETE" "(" ([ "LOCKED" ]) | ("(" "UNTIL" <NUMBER> "DAYS" "AFTER" "INSERT" ["LOCKED"] ")") ")";
							
<relational_properties>		::= <table_member> ("," <table_member>)*;

//Vis_26112026_[261101073]_Added table-level DOMAIN clause to relational properties
<table_member>				::= (
									(node("Domain clause",attribute("VALUE",<table_domain_clause>)))
									| (<out_of_line_constraint> | <foreign_key> | ( node("Outline Reference Constraint", attribute("VALUE" ,<out_of_line_ref_constraint>))) ) 
									| (node("Period Definition" , attribute("VALUE" , <period_definition>)))									
									| (node("Supplemental Log" , attribute("VALUE" , <supplemental_logging_props>) ))									
									| (<virtual_column_definition>)
									|  (<column_definition>)
								);
								
// 26ai table-level domain_clause (inside relational_properties). Its img_text page is empty upstream;
// this follows the syntax diagram: DOMAIN [owner.]domain (column [, column]...) [USING (column [, column]...)]
//Vis_26112026_[261101073]_Added table-level DOMAIN clause: DOMAIN [owner.]domain (columns) [USING (columns)]
<table_domain_clause>			::= "DOMAIN" [ (<schema>|<StringValue>) "." ] <name> "(" <name_comma_list> ")"
									[ "USING" "(" <name_comma_list> ")" ] ;

<supplemental_id_key_clause>	::= "DATA"
									"("  <id_key_clause_values>  ("," <id_key_clause_values>)* ")"
									"COLUMNS";
									
<id_key_clause_values>			::= ("ALL") | ("PRIMARY" "KEY") | ("UNIQUE") | ("FOREIGN" "KEY") ;
								
<supplemental_logging_props>	::= "SUPPLEMENTAL" "LOG" ( <supplemental_log_grp_clause> | <supplemental_id_key_clause> );

<supplemental_log_grp_clause>	::= "GROUP" <log_group>
									"(" (<column_or_string> [ "NO" "LOG" ]) ("," (<column_or_string> [ "NO" "LOG" ]))*  ")"
									  [ "ALWAYS" ];
									  
<log_group>				::= <IDENTIFIER> ;
								
<out_of_line_ref_constraint>	::= ( ("SCOPE" "FOR" "("  (<ref_col> | <ref_attr>) ")"
											"IS" [ (<schema>|<StringValue>) "." ] <scope_table>)
										
										| ("REF" "("  (<ref_col> | <ref_attr>) ")" "WITH" "ROWID")
										
										| ([ "CONSTRAINT" (<constraint_name> |<StringValue>)] "FOREIGN" "KEY"
											"(" (<ref_col> | <ref_attr>) ("," (<ref_col> | <ref_attr>))* ")" <references_clause>
											[ <constraint_state> ])
									);
									

									
<ref_col>				::= <IDENTIFIER>|<StringValue>;
<ref_attr>				::= <IDENTIFIER>|<StringValue>;

								
<foreign_key>				::= node("FOREIGNKEY" ,
									[ "CONSTRAINT" ((attribute("NAME", <constraint_name>))|<StringAsName>) ] 
										"FOREIGN" "KEY" attributeEx("EASTEREOTYPE", "Oracle::FK") [<constraint_columns>]
										<foreign_reference>
									);
									
									
<foreign_reference>			::= "REFERENCES" node("TARGET" , [ (<schema>|<StringValue>) "." ](( attribute("NAME", <IDENTIFIER>))| <StringAsName>) [<constraint_columns>] 
							 ) 	["ON" "DELETE" 
								( ("CASCADE" node("Delete" , attributeEx("VALUE" , "Cascade"))) 
								| ("SET" "NULL" node("Delete" , attributeEx("VALUE" ,"Set Null")))								
								) ] ;
								
<out_of_line_constraint>	::= node("OPERATION" ,
										[ "CONSTRAINT" ((attribute("NAME", <constraint_name>))|<StringAsName>) ]
										( 	(( ("PRIMARY" "KEY"  attributeEx("EASTEREOTYPE", "Oracle::PK") ) | ("UNIQUE" attributeEx("EASTEREOTYPE", "Oracle::unique")) )
											[<constraint_columns>])											
											| ("CHECK" attributeEx("EASTEREOTYPE", "Oracle::check" ) "(" attribute("CODE" , <boolean_condition>) ")")
										)[<constraint_state> ]
									);
									
<out_of_line_constraint_tag>	::= 	[ "CONSTRAINT" ((attribute("NAME", <constraint_name>))|<StringValue>) ]
										( 	(( ("PRIMARY" "KEY"  ) | ("UNIQUE") )
											["("<constraint_column_tag> ("," <constraint_column_tag>)* ")"])											
											| ("CHECK"  "("  <boolean_condition> ")")
										)[<constraint_state> ]
									;									
									
<constraint_column_tag>		::=  (<column_or_string> ["ASC" | "DESC"] ) ;									
									
<constraint_columns>				::= "(" <constraint_column> ("," <constraint_column>)* ")";
<constraint_column>					::= node("PARAMETER", ((attribute("NAME", <column> ))|<StringAsName>)  ["ASC" | "DESC"]);


								
<period_definition>			::= "PERIOD" "FOR" <valid_time_column> [ "("  <start_time_column> "," <end_time_column> ")" ] ;

<valid_time_column>			::= <NUMBER>;
<start_time_column>			::= <NUMBER>;
<end_time_column>			::= <NUMBER>;
								
//Vis_26112026_[261101074]_Virtual columns accept a domain datatype (datatype DOMAIN d, or DOMAIN d alone)
//Vis_26112026_[261101075]_Virtual columns accept MATERIALIZED as an alternative to VIRTUAL
//Vis_26112026_[261101070]_Added ANNOTATIONS clause to virtual columns
<virtual_column_definition> ::= node("ATTRIBUTE" , attributeEx("EASTEREOTYPE", "Oracle::column")
									((attribute("NAME" , <column>))|<StringAsName>)
									[ ( <column_domain_type> | ( <column_type> [ <column_domain_clause> ] ) )
									  [ "COLLATE" node("Collation" , attribute("VALUE" , <column_collation_name>)) ] ]
									[ ("VISIBLE" node("Visibility Specification" , attributeEx("VALUE" , "Visible"))) 
										| ("INVISIBLE" node("Visibility Specification" , attributeEx("VALUE" , "Invisible"))) 
									]
									[ "GENERATED" "ALWAYS"  node("Automatic Generation" , attributeEx("VALUE" , "True"))]
									"AS" "(" node("Column Expression" , attribute("VALUE" , <column_expression>)) ")" 
									[ ( "VIRTUAL" node("Virtual" , attributeEx("VALUE" , "True")) ) | "MATERIALIZED" ]
									 [ <evaluation_edition_clause> ]
									 [ node("Unusable Edition" , attribute("VALUE" , <unusable_editions_clause>))  ]
									 [([ "NOT"  attributeEx("NOTNULL", "true")] "NULL")]
									 [<inline_constraint_node>]
									 [ <annotations_clause> ]
								);
								
<unusable_editions_clause>		::= [ "UNUSABLE" "BEFORE" ( ("CURRENT" "EDITION") | ("EDITION" <edition>) ) ]
									[ "UNUSABLE" "BEGINNING" "WITH"( ("CURRENT" "EDITION") | ("EDITION" <edition>) | ("NULL" "EDITION") ) ];
								
<evaluation_edition_clause>		::= "EVALUATE" "USING" ( node("Evaluation Edition" , attribute("VALUE" , <evaluation_values>))  ) ;

<evaluation_values>				::= ("CURRENT" "EDITION") | ("EDITION" <edition>) | ("NULL" "EDITION") ;

<edition>				::= <IDENTIFIER> ;
									
//Vis_26112026_[261101074]_Columns accept a domain datatype (datatype DOMAIN d, or DOMAIN d alone)
//Vis_26112026_[261101070]_Added ANNOTATIONS clause to columns
<column_definition>			::= node("ATTRIBUTE" , attributeEx("EASTEREOTYPE", "Oracle::column")									
									((attribute("NAME" , <column> ))|<StringAsName>)
									// datatype_domain: { datatype [ DOMAIN [owner.]domain ] | [ DOMAIN ] [owner.]domain }
									[ ( <column_domain_type> | ( <column_type> [ <column_domain_clause> ] ) )
									  [ "COLLATE" node("Collation" , attribute("VALUE" , <column_collation_name>)) ] ]
									[ "SORT" node("Sorted Index" , attributeEx("VALUE" , "True")) ] 
									[ ("VISIBLE" node("Visibility Specification" , attributeEx("VALUE" , "Visible"))) 
										| ("INVISIBLE" node("Visibility Specification" , attributeEx("VALUE" , "Invisible"))) 
									]
									[ node("Column Initialization" , attribute("VALUE" ,<column_initialization>))]
									[ "ENCRYPT" node("Encrypt Specification" , attribute("VALUE" , <encryption_spec>)) ]  
									[([ "NOT"  attributeEx("NOTNULL", "true")] "NULL")]
									
									[ ( <inline_constraint_node>	) 
									| ( node("Inline Reference Constraint" , attribute("VALUE" , <inline_ref_constraint> )))]
									[ <annotations_clause> ]
								);

// DOMAIN after a datatype: parsed only (the datatype stays the column TYPE).
//Vis_26112026_[261101074]_Added DOMAIN [owner.]domain after a column datatype (parsed only)
<column_domain_clause>		::= "DOMAIN" [ (<schema>|<StringValue>) "." ] <name> ;

// Column declared by its domain alone ("col DOMAIN d"): the domain name becomes the column TYPE,
// the same as "col d" without the keyword, which <column_type> already models that way.
//Vis_26112026_[261101074]_Added column declared by DOMAIN alone; the domain name becomes the column TYPE
<column_domain_type>		::= "DOMAIN" node("TYPE", attribute("NAME", [ (<schema>|<StringValue>) "." ] <name>)) ;
								
//Vis_26112026_[261101076]_DEFAULT ON NULL accepts FOR INSERT ONLY and FOR INSERT AND UPDATE
<column_initialization>		::= ("DEFAULT" [ "ON" "NULL" [ "FOR" "INSERT" ( "ONLY" | ( "AND" "UPDATE" ) ) ] ] <expr>) | ( <identity_clause> );
								
//Vis_26112026_[261101077]_Fixed reference to undefined rule <Schema>, now <schema>
<column_type>				::= node("TYPE", attribute("NAME",[(<schema>|<StringValue>)"."] <datatype>)
								["(" ((attribute("PRECISION",<NUMBER>) "," attribute("SCALE" ,<NUMBER>) )|(attribute("LENGTH",<NUMBER>))) [ "BYTE" | "CHAR" ] ")"]) ;

<expr>						::= (   <grouped_expr>
									|<calc_meas_expression>
									| <case_expression>
									| <cursor_expression>
									| <datetime_expression>
									| <function_expression>
									| <interval_expression>
									| <JSON_object_access_expr>
									| <model_expression>
									| <object_access_expression>
									| <scalar_subquery_expression>
									| <type_constructor_expression>	
									| <simple_expression>
									| <compound_expression>
									| <variable_expression>
								);

<grouped_expr>				::= <IDENTIFIER> "(" <simple_expression> ("," <simple_expression>)*  ")" ["." <IDENTIFIER> ["(" ")"]];

								
<simple_expression> 			::= <IDENTIFIER> | <NUMBER> | <StringValue> | <DELIMITER> ;

<compound_expression> 			::=  <simple_expression> [<DELIMITER> <simple_expression>] ;

<calc_meas_expression> 			::= "CALC_MEAS" "(" <simple_expression> "," <simple_expression> ")" ;

//<case_expression> 				::= "CASE" <simple_expression> "WHEN" <simple_expression> "THEN" <simple_expression> "ELSE" <simple_expression> "END" ;

<case_expression> 				::= "CASE" (<searched_case_expression> | <simple_case_expression>) [<else_clause>] "END" ;

<searched_case_expression>		::= ( "WHEN" <condition> "THEN" <return_expr> )*;
<simple_case_expression>		::= <expr> ( "WHEN" <comparison_expr> "THEN" <return_expr> )*;
<else_clause>					::= "ELSE" <else_expr>;

<comparison_expr>			::= <condition>;
<return_expr>				::= <uneffected_datatype>;
<else_expr>					::= <IDENTIFIER>;

<cursor_expression> 			::= "CURSOR" "(" <simple_expression> ")" ;

<datetime_expression> 			::= "TO_DATE" "(" <simple_expression> "," "FORMAT_STRING" ")" ;

<function_expression> 			::= "FUNCTION" "(" <simple_expression> ")" ;

<interval_expression> 			::= "INTERVAL" <simple_expression> "UNIT" <simple_expression> ;

<JSON_object_access_expr> 		::= "JSON_ACCESS" "(" <simple_expression> "," <StringValue> ")" ;

<model_expression>				 ::= "MODEL" "(" <simple_expression> "," <simple_expression> "," <simple_expression> ")" ;

<object_access_expression> 		::= "OBJECT_ACCESS" "(" <simple_expression> "," <IDENTIFIER> ")" ;

<scalar_subquery_expression> 	::= "SELECT" <simple_expression> "FROM" <simple_expression> ;

<type_constructor_expression> 	::= "CONSTRUCT_TYPE" "(" <simple_expression> "," <simple_expression> "," <simple_expression> ")" ;

<variable_expression> 			::= <IDENTIFIER> ;


<identity_clause>				::= "GENERATED"
									[ "ALWAYS" | ("BY" "DEFAULT" [ "ON" "NULL" ]) ]
									"AS" "IDENTITY" [ "(" <identity_options> ")" ];
									
<identity_options>				::= ( ("START" "WITH" "(" (<NUMBER>) | ("LIMIT" "VALUE") ")")
										| ("INCREMENT" "BY" <NUMBER>)
										| ("(" ("MAXVALUE" <NUMBER>) | ("NOMAXVALUE") ")")
										| ( "(" ("MINVALUE" <NUMBER>) | ("NOMINVALUE") ")" )
										| ("(" "CYCLE" | "NOCYCLE" ")")
										| ("("  ("CACHE" <NUMBER> ) | ("NOCACHE") ")")
										| ( "(" "ORDER" | "NOORDER" ")" ) 
									);
									
<encryption_spec> 				::=   [ "USING" <encrypt_algorithm> ]
									  [ "IDENTIFIED" "BY" <password> ]
									  [ <integrity_algorithm> ]
									  [ [ "NO" ] "SALT" ] ;
									  
<encrypt_algorithm>				::= <StringValue>;
<password>						::= (<StringValue>|<IDENTIFIER>);
<integrity_algorithm>			::= <StringValue>;

<inline_ref_constraint>			::= ( ("SCOPE"  "IS" [ (<schema>|<StringValue>) "." ] <scope_table>)
											| ("WITH" "ROWID")
											| ([ "CONSTRAINT" <constraint_name> ] <references_clause> [ <constraint_state> ])
										);
										
<scope_table>					::= <IDENTIFIER>;

<inline_constraint_tag>				::= [ "CONSTRAINT" (<constraint_name>|<StringValue>) ]
									( ([ "NOT" ] "NULL")
										| ("UNIQUE")
										| ("PRIMARY" "KEY")
										| (<references_clause>)
										| ("CHECK" "(" <boolean_condition> ")")
									)
									[ <constraint_state> ]
									;

<boolean_condition>					::= <logical_Expression>;

<constraint_name>				::= <IDENTIFIER> ; 

<references_clause>				::= "REFERENCES" [ (<schema>|<StringValue>) "." ] <object> [ "(" <column_or_string> ("," <column_or_string>)*  ")" ] ["ON" "DELETE" ( "CASCADE" | ("SET" "NULL") ) ];
								  
<column>					::= [<IDENTIFIER>"."] <IDENTIFIER> ;
<column_collation_name>		::= <IDENTIFIER> ;


<constraint_state>			::= [ (( ["NOT"] "DEFERRABLE" ["INITIALLY" ("IMMEDIATE" | "DEFERRED")] )
									 | ( "INITIALLY" ( "IMMEDIATE" | "DEFERRED" ) [ "NOT" ] [ "DEFERRABLE" ]))]
									
									[  "RELY" | "NORELY"  ]
									[ <using_index_clause> ]
									[ "ENABLE" | "DISABLE" ]
									[ "VALIDATE" | "NOVALIDATE" ]
									[ <exceptions_clause> ]
									;
									
<exceptions_clause> 		::= "EXCEPTIONS" "INTO" [ (<schema>|<StringValue>) "." ] <table_or_string>;									
									
<using_index_clause>		::= "USING" "INDEX"
								  ( ([ (<schema>|<StringValue>) "." ] <index> )
									  | ("(" <create_index_statement> ")")
									 |( <index_properties> )
								  );
								  
<create_index_statement>	::= "CREATE" [ "UNIQUE" | "BITMAP" | "MULTIVALUE" ] "INDEX" [ (<schema>|<StringValue>) "." ] <index_name> [ <index_ilm_clause> ]
								  "ON" ( <cluster_index_clause>
										 | <table_index_clause>
										 | <bitmap_join_index_clause>
									 )
								[ "USABLE" | "UNUSABLE" ]
								[ ( "DEFERRED" | "IMMEDIATE" ) "INVALIDATION" ] ;

<object>				::= <IDENTIFIER>|<StringValue>;
<index>				::= <IDENTIFIER>;

<datatype>				::= ( <Oracle_built_in_datatypes>
								| <ANSI_supported_datatypes>								
								| <Oracle_supplied_types>
								| <user_defined_types>
							)
							;
							
<uneffected_datatype>		::=		( <Oracle_built_in_datatypes>
								| <ANSI_supported_datatypes>								
								| <Oracle_supplied_types>
								| <user_defined_types>
							)["(" <NUMBER>[","<NUMBER>] ")"] ;					
							
//Vis_26112026_[261101077]_Fixed reference to undefined rule <Schema>, now <schema>
<user_defined_types>		::= [<schema>"."](<IDENTIFIER>|<StringValue>);

<Oracle_built_in_datatypes>		::= ( <character_datatypes>
										| <number_datatypes>
										| <long_and_raw_datatypes>
										| <datetime_datatypes>
										| <large_object_datatypes>
										| <rowid_datatypes>
									)
									;
									
<character_datatypes>			::= ( ( "CHAR"  )
										| ( "VARCHAR2" )
										| ( "NCHAR"  )
										| ( "NVARCHAR2" )
									);	
									
<size>			::= <NUMBER> ;
<precision>			::= <NUMBER> ;
<scale>			::= <NUMBER> ;
<fractional_seconds_precision>		::= <NUMBER> ;
<year_precision>		::= <NUMBER> ;
<day_precision>		::= <NUMBER> ;

<number_datatypes>			::= ( ( "NUMBER")
									| ("FLOAT" )
									| ("BINARY_FLOAT")
									| ("BINARY_DOUBLE")
								);
								
<long_and_raw_datatypes>	::= ( ("LONG") | ("LONG" "RAW") | ("RAW" ) ) ;

<datetime_datatypes>		::= ( ("DATE")
									| ("TIMESTAMP" [ "(" <fractional_seconds_precision> ")" ] [ "WITH" [ "LOCAL" ] "TIME" "ZONE" ])
									| ("INTERVAL" "YEAR" [ "(" <year_precision> ")" ] "TO" "MONTH")
									| ( "INTERVAL" "DAY" [ "(" <day_precision> ")" ] "TO" "SECOND" [ "(" <fractional_seconds_precision> ")" ])
								);
								
<large_object_datatypes>	::= ( "BLOB" | "CLOB" | "NCLOB" | "BFILE" ) ;

<rowid_datatypes>			::= ( ("ROWID") | ("UROWID" [ "(" <size> ")" ]) );

<ANSI_supported_datatypes>	::=  ( ("CHARACTER" ["VARYING"] )
									| (( "CHAR" | "NCHAR" ) "VARYING" )
									| ("VARCHAR" )
									| ( "NATIONAL" ( "CHARACTER" | "CHAR" ) ["VARYING"] )
									| (( "NUMERIC" | "DECIMAL" | "DEC" ) )
									| (( "INTEGER" | "INT" | "SMALLINT" ))
									| ("FLOAT" )
									| ("DOUBLE" "PRECISION")
									| ("REAL")
								);
								
<Oracle_supplied_types>		::= ( <any_types>
									| <XML_types>
									| <spatial_types>									
								);
								
<any_types>					::= ( "SYS" "." <Any_Data_type_dataset> );
<Any_Data_type_dataset>		::= <IDENTIFIER>;

<XML_types>					::= ( "XMLType" | "URIType" );

<spatial_types>				::= ( "SDO_Geometry" | "SDO_Topo_Geometry" | "SDO_GeoRaster" );

//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE INDEX
<create_index>				::=node("OPERATION",
									attributeEx("EASTEREOTYPE", "Oracle::index")
									"CREATE" 
									[ ("UNIQUE" node("Index Type" , attributeEx("VALUE" , "Unique"))) 
										| ("BITMAP" node("Index Type" , attributeEx("VALUE" , "Bitmap")))
										| ("MULTIVALUE" node("Index Type" , attributeEx("VALUE" , "Multivalue"))) ] 
									"INDEX"  ["IF" "NOT" "EXISTS" node( "Not Exists", attributeEx("VALUE","True"))]
									 [ node("Database and Schema" , ((attribute("VALUE",<schema>  ))|<StringAsValue>)".") ]
									((attribute("NAME",  <index_name>)) |<StringAsName>)
									[ <index_ilm_clause> ]
									  "ON" ( <cluster_index_clause> | <table_index_clause>  | <bitmap_join_index_clause> )
									[ ("USABLE" node("Index Status" , attributeEx("VALUE" , "Usable")))
										| ("UNUSABLE" node("Index Status" , attributeEx("VALUE" , "Unsuable"))) ]
									[ ( ("DEFERRED" node("Invalidation", attributeEx("VALUE" , "Deferred")))
										| ("IMMEDIATE"  node("Invalidation", attributeEx("VALUE" , "Immediate")) ) ) "INVALIDATION" ] 
								)[";"];
								
<bitmap_join_index_clause>	::= node("Index Format" , attributeEx("VALUE" , "Bitmap Join"))
								[ node("Table Schema" ,((attribute("VALUE",<schema>  ))|<StringAsValue>)".") ]
								node("OWNER" , ((attribute("NAME" , <table>))|<StringAsName>))
							   <constraint_columns>
							   "FROM" ( node("Bitmap From" , attribute("VALUE" , (<bitmap_from_value> ("," <bitmap_from_value>)*))) ) 
							   "WHERE" node("Where Condition" , attribute("VALUE" , <condition> )) 
							   [ node("Local Partitioned" , attribute("VALUE" , <local_partitioned_index>)) ] 
							  node("Index Attributes" , attribute("VALUE" , <index_attributes>));
							   
<bitmap_from_value>			::= [ (<schema>|<StringValue>)"." ] <table_or_string> [ <t_alias> ] ;
								  
//<bitmap_join_index_values>	::= [ ([ (<schema>|<StringValue>) "." ] <table> "." ) | (<t_alias> ".")] <column> [ "ASC" | "DESC"  ];
								
<table_index_clause>		::= node("Index Format" , attributeEx("VALUE" , "Table"))
								[ node("Table Schema" , ((attribute("VALUE",<schema>  ))|<StringAsValue>)".") ] 
								node("OWNER" ,(( attribute("NAME" , <table> ))|<StringAsName>)) [ <t_alias> ]
								(<constraint_columns> | ("(" node("Index Expression" , attribute("VALUE" , (<index_expr> ("," <index_expr>)*)))  ")")) 
								  [ node("Index Properties" , attribute("VALUE" , <index_properties>)) ];
								  
<index_properties>		::= (<global_partitioned_index> | <local_partitioned_index>  |  <index_attributes> )
								| ("INDEXTYPE" "IS" 
									( <domain_index_clause> |   <XMLIndex_clause>)
									)
							;
							
<XMLIndex_clause>		::= ["XDB" "."] "XMLINDEX" [ <local_XMLIndex_clause> ]
											[ <parallel_clause> ]
							  [ <XMLIndex_parameters_clause> ];
							  
<local_XMLIndex_clause>		::= "LOCAL"
								  [ "(" <local_XMLIndex_values>	 ("," <local_XMLIndex_values>)* ")" ];
								  
<local_XMLIndex_values>		::= "PARTITION" <partition> [ <XMLIndex_parameters_clause> ];

<XMLIndex_parameters_clause>	::= "PARAMETERS"  "(" <StringValue> ")" ;
							
<domain_index_clause>	::= <indextype>
							   [ <local_domain_index_clause> ]
							   [ <parallel_clause> ]
							   [ "PARAMETERS" "(" <ODCI_parameters> ")" ];
							   
<ODCI_parameters>		::= <StringValue> ;

<indextype>				::= <IDENTIFIER>;



<local_domain_index_clause>	::= "LOCAL" [ "(" <local_domain_values> ("," <local_domain_values>)* ")"  ];
								  
<local_domain_values>		::= "PARTITION" <partition> [ "PARAMETERS" "(" <ODCI_parameters> ")" ] ;
							
<local_partitioned_index> 		::= "LOCAL"
									[ <on_range_partitioned_table>
										| <on_list_partitioned_table>
										| <on_hash_partitioned_table>
										| <on_comp_partitioned_table>
									];
									
<on_range_partitioned_table>	::= "(" <on_range_partitioned_values> ("," <on_range_partitioned_values>)* ")";

<on_range_partitioned_values>	::= "PARTITION" [ <partition> ] [ ( <segment_attributes_clause>  | <index_compression> )] [ "USABLE" | "UNUSABLE" ] ;

<on_list_partitioned_table>		::= "(" <on_range_partitioned_values> ("," <on_range_partitioned_values>)* ")";

<on_hash_partitioned_table>		::= ( ("STORE" "IN" "(" <tablespace> ("," <tablespace>)* ")") | ("(" <on_range_partitioned_values> ("," <on_range_partitioned_values>)* ")" ));

<on_comp_partitioned_table>		::= <on_hash_partitioned_table>	;

<global_partitioned_index>		::= "GLOBAL" "PARTITION" "BY"
								   ( ("RANGE" "(" <column_list> ")" "(" <index_partitioning_clause> ")")
										| (("HASH" "(" <column_list> ")" ) ( <individual_hash_partitions> |  <hash_partitions_by_quantity> ))
								   );
								   
<hash_partitions_by_quantity>	::= "PARTITIONS" <hash_partition_quantity>
									[ "STORE" "IN" "(" <tablespace> ("," <tablespace>)* ")" ]
									[ <index_compression> ]
									[ "OVERFLOW" "STORE" "IN" "(" <tablespace> ("," <tablespace>)* ")" ] ;
									
<hash_partition_quantity>		::= <NUMBER> ;
								   
<index_partitioning_clause>		::= "PARTITION" [ <partition> ] "VALUES" "LESS" "THAN" "(" <literal> ("," <literal>) ")" [ <segment_attributes_clause> ];

<individual_hash_partitions>	::= "(" <individual_hash_partitions_values> ("," <individual_hash_partitions_values>)* ")";

<individual_hash_partitions_values>  ::= "PARTITION" [<partition>]  [<partitioning_storage_clause>];

<partitioning_storage_clause>	::= [ ( ( ("TABLESPACE" <tablespace> )| ("TABLESPACE" "SET" <tablespace_set>) )
										| ( "OVERFLOW" [ ( ("TABLESPACE" <tablespace> )| ("TABLESPACE" "SET" <tablespace_set>) )] )										
										| ( <index_compression> )
										| ( <LOB_partitioning_storage> )
										| ( "VARRAY" <varray_item> "STORE" "AS" ["SECUREFILE" | "BASICFILE"] "LOB" <LOB_segname> )
									  )*
									];
									
<varray_item>					::= <IDENTIFIER>|<StringValue> ; 
									
<LOB_partitioning_storage>		::= "LOB" "(" <LOB_item> ")" "STORE" "AS" ["BASICFILE" | "SECUREFILE"]
									  [ (<LOB_segname> [ "(" (("TABLESPACE" <tablespace> )| ("TABLESPACE" "SET" <tablespace_set>) )")" ])
										| (("TABLESPACE" <tablespace> )| ("TABLESPACE" "SET" <tablespace_set>) )
									  ];
									  
<LOB_item>						::= (<IDENTIFIER>|<StringValue>);
<LOB_segname>						::= (<IDENTIFIER>|<StringValue>);

<segment_attributes_clause>		::= (
										( 
											("TABLESPACE" <tablespace>) 
											| ("TABLESPACE" "SET" <tablespace_set>)
										)
											//| (<physical_attributes_clause>)	
											| (("PCTFREE" <NUMBER>)
												  | ("PCTUSED" <NUMBER>)
												  | ("INITRANS" <NUMBER>)
												  | ("MAXTRANS" <NUMBER>)
												  | (<storage_clause>)
												)
											| (<logging_clause>)
											|("NOCOMPRESS" ["LOGGING"])
										|(("PCTTHRESHOLD" <NUMBER>) |("INCLUDING" <StringValue>) |"OVERFLOW")
										)
									;
									
								
<tablespace_set>				::= <IDENTIFIER>;

<literal>						::= <NUMBER>
									| ("TO_DATE" "(" <StringValue> ("," <StringValue>)* ")")
									| (<StringValue>)
									| ("DEFAULT");

<partition>					::= <IDENTIFIER> |<StringValue>;
								  
//<index_expr>				::= ( <column> | <column_expression> );
<index_expr>				::= ( <expr> );

<column_list>				::= <column_or_string> ("," <column_or_string>);

<column_expression>			::= <logical_Expression> ;
								  
<t_alias>					::= <IDENTIFIER>;
								
								
<cluster_index_clause>		::= "CLUSTER"  node("Index Format" , attributeEx("VALUE" , "Cluster"))
								[ node("Table Schema" , ((attribute("VALUE",<schema>  ))|<StringAsValue>)".") ]
								node("OWNER" , attribute("NAME" , <cluster> )) 
								[node("Index Attributes" , attribute("VALUE" , <index_attributes>))];

<cluster>					::=[(<schema>|<StringValue>)"."] (<IDENTIFIER>|<StringValue>) ;

<index_attributes>			::=  ( (<physical_attributes_clause>)
										| (<logging_clause>)
										| ("ONLINE")
										| ( "TABLESPACE" ( <tablespace> | "DEFAULT" ) )
										| ( <index_compression>)
										| ( "SORT" | "NOSORT" )
										| ("REVERSE")
										| ("VISIBLE" | "INVISIBLE")
										| (<partial_index_clause>)
										| (<parallel_clause>)
										| ("COMPUTE" "STATISTICS")
								  )*
								;
								
<parallel_clause>			::= ( ("NOPARALLEL" node("Parallel Clause" , attributeEx("VALUE" , "No Parallel" ))) 
							| ("PARALLEL" node("Parallel Clause" , attributeEx("VALUE" , "Parallel" ))
								[  node("Parallel Range" , attribute("VALUE" , <NUMBER> )) ]) );							
								
<partial_index_clause>		::= "INDEXING" ( "PARTIAL" | "FULL" );
										
<index_compression>			::= ( <prefix_compression>| <advanced_index_compression>);
								
<prefix_compression>		::= ("COMPRESS" [ <NUMBER> ] )|( "NOCOMPRESS" );

<advanced_index_compression>		::= ( "COMPRESS" "ADVANCED" [ "LOW" | "HIGH" ] ) | ("NOCOMPRESS");
								
<physical_attributes_clause>	::=  (("PCTFREE" <NUMBER>)
										  | ("PCTUSED" <NUMBER>)
										  | ("INITRANS" <NUMBER>)
										  | ("MAXTRANS" <NUMBER>)
										  | (<storage_clause>)
									  )
									;
									
<storage_clause>				::= "STORAGE"
										"(" ( ("INITIAL" <size_clause>)
												 | ("NEXT" <size_clause>)
												 | ("MINEXTENTS" <NUMBER>)
												 | ("MAXEXTENTS" ( <NUMBER> | "UNLIMITED" ))
												 | (<maxsize_clause>)
												 | ("PCTINCREASE" <NUMBER>)
												 | ("FREELISTS" <NUMBER>)
												 | ("FREELIST" "GROUPS" <NUMBER>)
												 | ("OPTIMAL" [ <size_clause> | "NULL" ])
												 | ("BUFFER_POOL" ( "KEEP" | "RECYCLE" | "DEFAULT" ))
												 | ("FLASH_CACHE" ( "KEEP" | "NONE" | "DEFAULT" ))
												 | ("CELL_FLASH_CACHE" ( "KEEP" | "NONE" | "DEFAULT" ))
												 |("(" skipBalanced("(",")") ")")
												 | ("ENCRYPT")
											)*
										")";
										
<size_clause>					::= <NUMBER> [ "K" | "M" | "G" | "T" | "P" | "E" ];

<maxsize_clause>				::= "MAXSIZE" ( "UNLIMITED" | <size_clause> );


<logging_clause>				::= ( "LOGGING" | "NOLOGGING" |  "FILESYSTEM_LIKE_LOGGING" ) ;

<StringValue>		::=( "\""  <STRINGDBODY> "\"" )| 
						("\'"  <STRINGSBODY> "\'");							

<tablespace>				::= <IDENTIFIER>|<StringValue>;
<index_name>				::= <IDENTIFIER>;

<index_ilm_clause>			::= "ILM"  "("  node("ILM Cluase" , attribute("VALUE" , <ilm_values>))  ")";
									 
<ilm_values>				::= ("ADD"  "POLICY" [ <policy_clause> ])
										  | (( "DELETE" | "ENABLE" | "DISABLE" ) "POLICY" <policy_name> ) 
										  | ( "DELETE_ALL" | "ENABLE_ALL" | "DISABLE_ALL" ) ;
									 
<policy_name>				::= <IDENTIFIER>;
									 
<policy_clause>				::= ( <optimize_clause> | (<tiering_clause> [<PLSQL_function_name>])) ;

<optimize_clause>			::= "OPTIMIZE" <condition_clause> ;

<PLSQL_function_name>		::= <IDENTIFIER>;

<condition_clause>			::= ( (<tracking_statistics_clause>) |  ( "(" "ON" <PLSQL_function_name> ")") );

<tracking_statistics_clause>	::= "AFTER" <time_interval> 
								   ( "DAYS" | "MONTHS"  | "YEARS" )
									"OF" [ "NO" ] ( "ACCESS" | "MODIFICATION" | "CREATION" );
									
<time_interval>				::= <NUMBER> ;

<tiering_clause>			::= "SEGMENT" "TIER" "TO" "LOW_COST_TBS";



<SelectQuery> 						::=  [<with_table_expression>	 ("," <with_table_expression>)*]
										("SELECT" | "SEL") 
										skip("FROM")										
										[<from>] 
										[<Join_value>*] 
										[<groupBy>]
										[<where_condition>] 
										[<having>]
										[<union_condition>] 
										["ORDER" "BY" (<order_expr> ("," <order_expr>)*)] 
										[ "NULLS" "FIRST" | "NULLS" "LAST" ]
										[ "OFFSET" <start> ]
										["START" "WITH" <condition>]										
										["CONNECT" "BY" <condition>]
										["START" "WITH" <condition>]
										[ "LIMIT" ( <NUMBER> | "ALL" ) ]  
										[<groupBy>] 
										[ "OPTION" "(" <option_clause> ")" ]   		
										["QUALIFY" <condition>]
										[ "WITH" "CHECK" "OPTION" ]
										[<sample_clause>]
										  ;	

<sample_clause>			::= "SAMPLE"
							  [ "WITH" "REPLACEMENT" ]
							  [ "RANDOMIZED" "LOCALIZATION" ]
							  [( ( <sample_descriptions> ("," <sample_descriptions>)* ) |
								<when_clause> 
							  )];
							  
<when_clause>			::= "WHEN" <condition> "THEN" ( <sample_descriptions> ("," <sample_descriptions>)* )  "END";
							  
<sample_descriptions>		::= <fraction_description> | <count_description> ;

<fraction_description>		::= (<NUMBER>("." <NUMBER>)* ) | (<NUMBER> "%");
<count_description>		::= <NUMBER>;
										  
<with_table_expression>			::=  "WITH" ["RECURSIVE" ] <with_column_expression> ("," <with_column_expression>)* ;

<with_column_expression>			::=(<col_names> "AS"  ["(" skipBalanced("(",")")")"]);

<col_name_def>					::=<column_or_string>[("(" skipBalanced("(",")")")")];
<col_names>						::= <col_name_def> ("," <col_name_def>)* ;

<from>								::= "FROM" (<rowset_function_limited>|<fromClause> | <from_sub>);		

<rowset_function_limited>	::=  <open_value> [[("AS" |".")] <IDENTIFIER>] ["(" skipBalanced("(" , ")")")"];

<open_value>			::= [<IDENTIFIER>] "(" skipBalanced("(" , ")")")";

<from_sub>							::= <from_tables> [ "NATURAL" ] ;

<fromClause>                        ::=  <from_tables>;	

<from_tables>						::= <from_table> ("," (<from_table>|("("  skipBalanced("(" , ")" ) ")"[<IDENTIFIER>])))*;

<from_table> 						::= [(<schema>|<StringValue>) "."] <table_or_string> ["@" <IDENTIFIER>] [ (<Join_value>[<Join_value>*])|<groupBy>| <where_condition> | <union_condition> | ("ORDER" "BY" (<order_expr> ("," <order_expr>)*))|( "LIMIT" ( <NUMBER> | "ALL" ) )| <having>| ("WITH" "CHECK" "OPTION")|("OPTION" "(" <option_clause>  ")")|("QUALIFY" <condition>)| <sample_clause> |(<logging_errors>)| <subquery_restriction_clause>|( ["AS"] <IDENTIFIER> ) ]  ;




<Join_value> 						::= <join_type> <table_or_string> ["." <IDENTIFIER>] 
										[ <join_on_value>|<groupBy>| <where_condition> | <union_condition> | ("ORDER" "BY" (<order_expr> ("," <order_expr>)*)| "LIMIT" ( <NUMBER> | "ALL" )) | <having>| ("OPTION" "(" <option_clause>  ")" )|( ["AS"] [ "[" | "(" ] <IDENTIFIER> [ "]" | ")" ]) ]
										[<join_on_value>] ;
										
<join_on_value>						::= ("ON" <join_con> ) |( "USING" "(" <column_or_string>  ("," <column_or_string>)* ")");
										
<join_type>							::= ("JOIN") |("INNER" "JOIN") | ("LEFT" "JOIN") | ("LEFT" "OUTER" "JOIN")	| ("RIGHT" "JOIN") | ("RIGHT" "OUTER" "JOIN") | ("FULL" "JOIN") |
										("FULL" "OUTER" "JOIN") | ("CROSS" "JOIN") ;
										
<join_con>							::= <logical_Expression> ;	

<logical_Expression>				::= <join_condition> (("AND"|"OR") (<join_condition>) )* ;

									//Raji_0710202601006_Updated the grammar file to support CHECK constraints in CREATE TABLE and ALTER TABLE statements.

<join_condition>					::= (("(" skipBalanced("(" , ")" ) ")")|([<table_or_string>][( ("." | "/"|"+")<column_or_string> ["#"]) 
										| ("(" <col_names> ")")] [ ("(" skipBalanced("(" , ")" ) ")") ] 
										["/" [<IDENTIFIER> "."] <IDENTIFIER>] [<NUMBER>] [<comparison_Operator>] [("AND"|"OR")]
										["NEW" <IDENTIFIER>"("  <StringValue> ")"]  ["(" "SUBSTRING" "(" skipBalanced("(" , ")" ) ")" ")"] 
										[ ("(" skipBalanced("(" , ")" ) ")") |("CONVERT" "("skipBalanced("(" , ")" )")" )  
										| ( [<table_or_string>  | <StringValue> | (<DECIMAL>)|(<NUMBER>) ] [<comparison_Operator>] [<NUMBER>]
										[("."  (<column_or_string>| <NUMBER>)["#"]  )] ["AND" (<DECIMAL> | <NUMBER>)] 
										[("(" skipBalanced("(" , ")" ) ")")] )| (<default_expr> )  ]));	

<comparison_Operator> 				::= "=" | 
										("!""=")|
										"+" |
										("<" [">"]["="]) | 										
										("OF") | 										
										(">" ["="])|										
										 ("BETWEEN") | 
										 ("IN") | 
										 ("NOT" "IN") |
										("IS" "NULL") | 
										("IS" "NOT" "NULL") |
										"LIKE"|
										("|" "|")
										;
										
<default_expr> 						::=  (<NUMBER> ["." <NUMBER>] )| [<StringValue>]  	;

<groupBy>							::= "GROUP" "BY" <group_condition>;

<group_condition>					::= ( ([ ["["] <IDENTIFIER> ["]"] "."]*  ["["]  <table_or_string> ["#"]  ["]"] | <NUMBER>)  ( "," ([ ["["] <IDENTIFIER> ["]"] "."]*  ["["] <table_or_string> ["]"] | <NUMBER>))*)
										["(" <column_or_string>  ("," <column_or_string>)* ")"] ;

<where_condition>					::= "WHERE" ["NOT" "EXISTS"] <condition>   ; 							
<condition>							::= <join_con> ;


<union_condition>					::= ( "UNION" [ "ALL" ] | "INTERSECT" | "EXCEPT" | "MINUS" )
										<SelectQuery>* ;	
										
<order_expr> 						::= <column_with_expression> [ "ASC" | "DESC" ];

<column_with_expression>			::= ["SUM" | "MAX" |"COUNT" |"LENGTH" |<table_or_string> "." | <SelectQuery>] ["("] (<column_or_string> ["/" <column_or_string>] | <NUMBER> | <StringValue> | <DELIMITER>) [")"] ["AS" <IDENTIFIER>] ;

<having>							::= "HAVING" <having_condition> ;

<having_condition>					::= <aggregate_function> "(" ("*"|<column_or_string>) ")" <comparison_Operator>  <value> ;

<value>				::= <NUMBER>|<StringValue>|<IDENTIFIER>;

<aggregate_function>				::= "SUM" | "AVG" | "COUNT" | "MAX" | "MIN" ;

<start> 							::= "START" "TRANSACTION" [ "ISOLATION" "LEVEL" <option> ] [ "READ" "WRITE" | "READ" "ONLY" ] ";" ;

//Vis_26112026_[261101071]_Fixed READ UNCOMMITTED keyword literal split into separate tokens
<option>							::= "SERIALIZABLE" | ("READ" "UNCOMMITTED") | "READ" "COMMITTED" | "REPEATABLE" "READ" ;

<option_clause>					::=  (<query_hint> |<boundary_value>) ([","] (<query_hint> |<boundary_value>) )* ;		

<query_hint> 					::=   "HASH" "JOIN"   
										| "LOOP" "JOIN"   
										| "MERGE" "JOIN"   
										| "FORCE" "ORDER"   
										| (( "FORCE" | "DISABLE" ) "EXTERNALPUSHDOWN" )
										| ( "LABEL" "=" <IDENTIFIER> <StringValue> )
										;
										
//Vis_26112026_[261101077]_Fixed references to undefined rule <string>, now <StringValue>
<boundary_value>				::= <NUMBER> [<StringValue>] | <IDENTIFIER> [<StringValue>] | <StringValue> | "="  ;	


<convert_expression> 			::= <convert_value> ("," <convert_value> )* ;		

<convert_value>					::= (("CONVERT"| (<IDENTIFIER> ["." <IDENTIFIER>])) "(" [<convert_expression>] ")");

<logging_errors>	::= "LOGGING" [ "ALL" ] "ERRORS" [ "WITH" ( ("NO" "LIMIT") | ("LIMIT" "OF"  <error_limit>) ) ];

<error_limit>		::= <NUMBER> ;

//Vis_26112026_[261101078]_Added JSON COLLECTION view type to CREATE VIEW
//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE VIEW and CREATE MATERIALIZED VIEW LOG
//Vis_26112026_[261101079]_Added ENABLE/DISABLE CONCURRENT REFRESH to CREATE MATERIALIZED VIEW
//Vis_26112026_[261101070]_Added ANNOTATIONS clause to CREATE VIEW
<create_view>		::= node("ELEMENT", 
								attributeEx("EATYPE", "Class")
								attributeEx("EASTEREOTYPE", "Oracle::view")
								"CREATE" 
								
								["OR" "REPLACE" node("Is Replace" , attributeEx("VALUE" , "True"))]
								
								[("NO" "FORCE" node("Force" , attributeEx("VALUE" , "No")) )
								 | ("FORCE" node("Force" , attributeEx("VALUE" , "Yes")))
								]
								
								[
									(  "EDITIONING" node("View Type" , attributeEx("VALUE" , "Editioning")))
									| ("EDITIONABLE" node("View Type" , attributeEx("VALUE" , "Editionable")))
									| ("EDITIONABLE" "EDITIONING" node("View Type" , attributeEx("VALUE" , "Editionable Editioning")) )
									| ("NONEDITIONABLE" node("View Type" , attributeEx("VALUE" , "Non Editionable"))) 
									| ("ANALYTIC" node("View Type" , attributeEx("VALUE" , "Analytic"))) 
									| ("MATERIALIZED" node("View Type" , attributeEx("VALUE" , "Materialized")))
								]
								
								// 26ai JSON collection view: parsed only (no "View Type" value exists for it in Oracle_MDG.xml)
								[ "JSON" "COLLECTION"  node("View Type" , attributeEx("VALUE" , "Json Collection")) ]

								"VIEW"  
								
								( ("LOG" ["IF" "NOT" "EXISTS" node( "Not Exists", attributeEx("VALUE","True"))] "ON" node("Log On" , attributeEx("VALUE" , "True" ))) | ["IF" "NOT" "EXISTS" node( "Not Exists", attributeEx("VALUE","True"))] )
								
								[node("Database and Schema" ,((attribute("VALUE",<schema>  ))|<StringAsValue>)".")] 
								
								((attribute("NAME" , <view>))|<StringAsName>)
								["CONTAINER_DATA"] 
								[ "(" node("Column Specification" , attribute("VALUE" , <view_column_specification>)) ")" ]
								
								[ (("(" node("View Parameters" , attribute("VALUE" , (<view_param> ("," <view_param>)*)))  ")")
									| ( node("XMLType View Clause" , attribute("VALUE" , <XMLType_view_clause>)))
									| (node("Object View" , attribute("VALUE", <object_view_clause>)) ) 
									) ]
								
								[ "DEFAULT" "COLLATION"  node("Collation" , attribute("VALUE" , <collation_name>)) ]
								[ "DEFAULT" "COLLATION"  node("Collation" , attribute("VALUE" , <collation_name>)) ]
								
								[  ( ("ON" "PREBUILT" "TABLE" node("Prebuilt Table" , attributeEx("VALUE" , "True"))
										[ ( ("WITH" node("Reduced Precision" , attributeEx("VALUE" , "Yes"))) 
										
										| ("WITHOUT" node("Reduced Precision" , attributeEx("VALUE" , "No"))) ) 
										
										"REDUCED" "PRECISION" ]
										
										)
										
									| ([(node("Physical Properties" , attribute("VALUE" , <physical_properties>)) ) ]
										[(<materialized_view_props>)])
									)
								]
								
								[ ("USING" "INDEX" node("Index Option" , attributeEx("VALUE" , "Yes"))  
										[ node("Index Clause" , attribute("VALUE" , (<physical_attributes_clause> | ("TABLESPACE" <tablespace>)))) ])
									| ("USING" "NO" "INDEX" node("Index Option" , attributeEx("VALUE" , "No")))]
									
								[ node("Refresh Clause" , attribute("VALUE" ,<create_mv_refresh> ))]
								
								[ <evaluation_edition_clause> ]
								
								
								[ ( ("ENABLE" node("Query Computation" , attributeEx("VALUE" , "Enable" ))) 
									| ("DISABLE" node("Query Computation" , attributeEx("VALUE" , "Disable" ))) ) "ON" "QUERY" "COMPUTATION" ]
									
								[ <query_rewrite_clause> ] 

								[ ( "ENABLE" | "DISABLE" ) "CONCURRENT" "REFRESH" ]
								
								 [ "SHARING" "=" ( 
												("METADATA" node("Sharing Clause", attributeEx("VALUE" , "Metadata"))) 
												| ("DATA" node("Sharing Clause", attributeEx("VALUE" , "Data"))) 
												| ("EXTENDED" "DATA" node("Sharing Clause", attributeEx("VALUE" , "Extended Data"))) 
												| ("NONE" node("Sharing Clause", attributeEx("VALUE" , "None"))) 
												) ]
												
								[ (<physical_attributes_clause>
									  | ("TABLESPACE" <tablespace>)
									  | <logging_clause>
									  | ( "CACHE" | "NOCACHE" ))
								]
								
								[ <parallel_clause> ]
								
								[ node("Table Partition" , attribute("VALUE" , <table_partitioning_clauses>)) ]
								
								[ "WITH" node("Materialized View Option" , attribute("VALUE" ,<mat_view_options>)) ] 
								
								[ <mv_log_purge_clause> ]
								
								[ <for_refresh_clause> ]
								
								[<classification_clause>]
								
								[ (("(" node("View Parameters" , attribute("VALUE" , (<view_param> ("," <view_param>)*)))  ")")
									| (node("Object View" , attribute("VALUE", <object_view_clause>)) ) 
									| ( node("XMLType View Clause" , attribute("VALUE" , <XMLType_view_clause>)))) ]
									
								[<using_clause>]
								
								[<dim_by_clause> ] 
								
								[ <measures_clause>]
								
								[ <default_measure_clause> ] 
								
								[ <default_aggregate_clause> ]
								
								[ <cache_clause> ]
								
								[ <fact_columns_clause> ]
								
								[ <qry_transform_clause> ]
								
								[ "DEFAULT" "COLLATION"  node("Collation" , attribute("VALUE" , <collation_name>)) ]
								
								[ "BEQUEATH" ( ("CURRENT_USER" node("Bequeath" , attributeEx("VALUE" , "Current User"))) 
									| ("DEFINER" node("Bequeath" , attributeEx("VALUE" , "Definer"))) ) ]
									
								[ <annotations_clause> ]

								[ "AS" node("viewdef" , attribute("VALUE" , <view_defintion>))]
								
								[ ("CONTAINER_MAP" node("Container Option" , attributeEx("VALUE" , "Map"))) 
									| ("CONTAINERS_DEFAULT" node("Container Option" , attributeEx("VALUE" , "Default"))) ] 
						)
						[";"]
						  ;
						  

						  
<view_defintion>		::= <subquery> [ <subquery_restriction_clause> ];
						  
						  
// MV log WITH list. Oracle's examples also put object types after the column list,
// e.g. WITH ROWID, SEQUENCE (list_price, min_price), PRIMARY KEY
//Vis_26112026_[261101080]_MV log WITH list accepts column lists between items, e.g. WITH ROWID, SEQUENCE (cols), PRIMARY KEY
<mat_view_options>		::= [ <mat_view_with_item> ( [","] <mat_view_with_item> )* ]
							[ <new_values_clause> ];

//Vis_26112026_[261101080]_Helper: one MV log WITH item (option or parenthesized column list)
<mat_view_with_item>		::= <mat_view_with_option>
							| ( "(" <column_or_string> ("," <column_or_string>)* ")" ) ;
						  
//Vis_26112026_[261101070]_Added ANNOTATIONS clause to view column aliases
<view_column_specification> 	::= ( <scoped_table_ref_constraint> | (<column_alias> ["ENCRYPT" [<encryption_spec>]] [ <annotations_clause> ]) ) ;
						  
<for_refresh_clause>	::= ( ("FOR" "SYNCHRONOUS" "REFRESH"  node("Refresh For" , attributeEx("VALUE" , "Synchronous"))  
								"USING"  node("Staging Log Name" , attribute("VALUE" ,<staging_log_name> )) )
								| ("FOR" "FAST" "REFRESH" node("Refresh For" , attributeEx("VALUE" , "Fast")))
							);						  

<staging_log_name>		::= <IDENTIFIER> ;

<mv_log_purge_clause>	::= "PURGE" node("Log Purge" , attribute("VALUE" ,<purge_expr>));	

<purge_expr>			::= ( ("IMMEDIATE" [ "SYNCHRONOUS" | "ASYNCHRONOUS" ])
							  | ( ["START" "WITH" <datetime_expression>] [ ("NEXT" <datetime_expression> )| ("REPEAT" "INTERVAL" <view_interval_expression>) ])
							  
							  );		

<view_interval_expression>	::= <StringValue> "DAY";							  
						  
<new_values_clause>		::= ( "INCLUDING" | "EXCLUDING" ) "NEW" "VALUES" ;
						  
<mat_view_with_option>	::= ("OBJECT" ("ID" | "OID")) 
									| ("PRIMARY" "KEY")
									| ("ROWID")
									| ("SEQUENCE")
									| ("COMMIT" "SCN");						  
						  
<column_alias>			::= <IDENTIFIER> ;						  
						  
<query_rewrite_clause>	::= ( ("ENABLE" node("Query Rewrite" , attributeEx("VALUE" , "Enable"))) 
								| ("DISABLE"  node("Query Rewrite" , attributeEx("VALUE" , "Disable"))) 
								) "QUERY" "REWRITE" 
								[ node("Unusable Edition" ,attribute("VALUE" , <unusable_editions_clause>)) ];						  
						  
<create_mv_refresh>		::= ( "REFRESH"
							  (( ( "FAST" | "COMPLETE" | "FORCE" )
								  | ( ("ON" "DEMAND")| ("ON" "COMMIT")| ("ON" "STATEMENT"))
								  | (( ("START" "WITH" <date>) | ("NEXT" <date>) ))
								  | ("WITH" ( ("PRIMARY" "KEY") | ("ROWID") ) )
								  |( "USING"
									 ( ("DEFAULT" [ "MASTER" | "LOCAL" ] "ROLLBACK" "SEGMENT")
										| ([ "MASTER" | "LOCAL" ] "ROLLBACK" "SEGMENT" <rollback_segment>)
									 ))
								  |( "USING" ( "ENFORCED" | "TRUSTED" ) "CONSTRAINTS")
								  )*)
							| ("NEVER" "REFRESH")
							);	

<rollback_segment>	::= <IDENTIFIER> ;							

<date>				::= ( "SYSDATE" ["+" <NUMBER> [ "/" <NUMBER>]] )
						| ("NEXT_DAY" "(" "TRUNC" "(" "SYSDATE" ")" "," <StringValue> ")" "+" <NUMBER> "/" <NUMBER> )	
						| ("ROUND" "(" "SYSDATE" "+" <NUMBER> ")" "+" <NUMBER> "/" <NUMBER> );							
						  
<materialized_view_props>	 ::= [ node("Column Properties" , attribute("VALUE" , <column_properties>)) ]
								[ node("Table Partition" , attribute("VALUE" , <table_partitioning_clauses>)) ]
								[ ( ("CACHE" node("Caching Option" , attributeEx("VALUE" , "Cache"))  node("Cache Value" , attribute("VALUE" ,<NUMBER> )) ) 
									| ("NOCACHE" node("Caching Option" , attributeEx("VALUE" , "No Cache")))
									) 
								]
								[ <parallel_clause> ]
								[ <build_clause> ]
								;					

<build_clause>			::= "BUILD" ( ("IMMEDIATE" node("Build Option" , attributeEx("VALUE" , "Immediate"))) 
								| ("DEFERRED" node("Build Option" , attributeEx("VALUE" , "Deferred"))) );									
						  
<scoped_table_ref_constraint>	::= ( "SCOPE" "FOR" "(" <ref_column>  ")"
									  "IS" [ (<schema>|<StringValue>) "." ] ( <scope_table_name> )
									);		

<ref_column>			::= <IDENTIFIER> ;
<scope_table_name>			::= <IDENTIFIER> ;
									
						  
<fact_columns_clause>	::= "FACT" "COLUMNS"  node("Fact Columns" , attribute("VALUE" , <fact_values>)) ;		

<fact_values>				::= <fact_column>  [(["AS"] <fact_alias>) ("," (["AS"] <fact_alias>))* ] ;

<fact_alias>			::= <IDENTIFIER> ;
						  
<qry_transform_clause>	::= "ENABLE" "QUERY" "TRANSFORM" node("Query Transform" , attributeEx("VALUE" , "True")) 
								[ ("RELY" node("Rely Option" , attributeEx("VALUE" , "Yes")))
								| ("NORELY" node("Rely Option" , attributeEx("VALUE" , "No"))) ];						  
						  
<cache_clause>		::= "CACHE" node("Cache Specification" , attribute("VALUE" , (<cache_specification> ("," <cache_specification>)*))) ;	

<cache_specification>	::= "MEASURE" "GROUP"
							 (   ( "ALL") 
							   | ( "(" <measure_name> ("," <measure_name> )* ")" [ (<levels_clause>  "MATERIALIZED")* ] )
							 );		
							 
							 
<levels_clause>			::= "LEVELS" "(" <level_specification> ("," <level_specification> )* ")" ;

<level_specification>	::= "(" [ [ <dim_name> "." ] <hier_name> "." ] <level_name> ")" ;

<dim_name>			::= <IDENTIFIER> ;
<hier_name>			::= <IDENTIFIER> ;
<level_name>			::= <IDENTIFIER> ;

							 

<measure_name>			::= <IDENTIFIER> ;							 
						  
<default_measure_clause>	::= "DEFAULT" "MEASURE" node("Default Measure" , attribute("VALUE" , <measure>)) ;		
	
<default_aggregate_clause>	::= "DEFAULT" "AGGREGATE" "BY"  node("Aggregate By" , attribute("VALUE" , <aggr_function>));			

<measure>				::= <IDENTIFIER> ;			  
						  
<measures_clause>		::= "MEASURES"  "(" node("Measure By" , attribute("VALUE" , (<av_measure> ("," <av_measure>)*)))  ")" ;

<av_measure>			::= <meas_name>  [( <base_meas_clause> | <calc_meas_clause> )]
							[ <classification_clause> ];
							
					
							
<calc_meas_clause>		::= "AS" "("  <expression> ")";		

<expression>			::= <logical_Expression> ;					
							
<base_meas_clause>		::= "FACT" <exposed_fact_column_name>  [<meas_aggregate_clause>]  ;
							
<meas_name>				::= <IDENTIFIER> ;
<exposed_fact_column_name>				::= <IDENTIFIER> ;

<meas_aggregate_clause>	::= "AGGREGATE" "BY"  <aggr_function> ;

<aggr_function>			::= <IDENTIFIER> ;
						  
<dim_by_clause>			::= "DIMENSION" "BY" "("  node("Dimension Key" , attribute("VALUE" , (<dim_key> ("," <dim_key> )*)))  ")";

<dim_key>				::= <dim_ref> 
							  [<classification_clause>]
							  "KEY"  
								(["("] ([<alias>"."] <fact_column>)  ("," (([<alias>"."] <fact_column>)))* [")"])
							  "REFERENCES" 
								 ( ["DISTINCT"]
								   ["("]  <attributes> ("," <attributes>)*  [")"] 
								)   
							  "HIERARCHIES" "(" <hier_ref> ("," <hier_ref>)* ")";
							  
<hier_ref>				::= [ (<schema>|<StringValue>) "." ] <hier_name> [ [ "AS" ] <hier_alias> ] [ "DEFAULT" ];


<hier_alias>				::= <IDENTIFIER> ;
							  
<dim_ref>				::= [ (<schema>|<StringValue>) "." ] <attr_dim_name> [ "AS" <dim__alias> ];
							  
<attr_dim_name>			::= <IDENTIFIER> ;
<dim__alias>			::= <IDENTIFIER> ;
<fact_column>			::= <IDENTIFIER> ;
						  
<using_clause>			::= "USING" node("Source Clause" , attribute("VALUE" , <source_clause>)) ;

<source_clause>			::= [ (<schema>|<StringValue>) "." ] <fact_table_or_view> [ "REMOTE" ] ["(" [ [ "AS" ] <alias> ] ")"];

<fact_table_or_view>	::= <IDENTIFIER>;
						  
<classification_clause>	::= ([ "CAPTION" node("Caption" , attribute("VALUE" , <caption>)) ]
							[ "DESCRIPTION" node("Description" , attribute("VALUE" , <description>)) ]
							[ ( "CLASSIFICATION" node("Classification Name" , attribute("VALUE" , <classification_name>))
							  [ "VALUE" node("Classification Value" , attribute("VALUE" ,<classification_value> ))  ] 
							  [ "LANGUAGE" node("Language" , attribute("VALUE" , <vlanguage>))])
							]);
	
	
<vlanguage>	::= <IDENTIFIER> ;
<classification_name>	::= <IDENTIFIER> ;
<classification_value>	::= (<StringValue>|<IDENTIFIER>) ;
							
<caption>				::= <IDENTIFIER> ;
<description>				::= <IDENTIFIER> ;
						  
<object_view_clause>	::= "OF" [ (<schema>|<StringValue>)"." ] <type_name>
							(( "WITH" "OBJECT" ( "IDENTIFIER" | "ID" | "OID" )
							  ( "DEFAULT" | ("(" <attributes> ("," <attributes> )* ")" ) ))
							| ("UNDER" [ (<schema>|<StringValue>) "." ] <superview>)
							)
							[ "(" <object_view_clause_values> ("," <object_view_clause_values>)*  ")" ];
						  
<view>				::= <IDENTIFIER>;
<alias>				::= <IDENTIFIER>|<StringValue> ;
<type_name>				::= <IDENTIFIER>|<StringValue> ;
<superview>				::= <IDENTIFIER> ;

//Vis_26112026_[261101070]_Added ANNOTATIONS clause to view parameters
<view_param>		::= (<out_of_line_constraint_tag>) 
						| (<alias> [ "VISIBLE" | "INVISIBLE" ] [ <annotations_clause> ] [ <inline_constraint_tag> ]);
								
<object_view_clause_values>	::= (<out_of_line_constraint_tag>) | (<attributes> <inline_constraint_tag>*);

<XMLType_view_clause>	::= "OF" "XMLTYPE" [ <XMLSchema_spec> ]
							"WITH" "OBJECT" ( "IDENTIFIER" | "ID" )
							  ( ("(" <expr> ("," <expr>)* ")") | ("DEFAULT")  );
							  
<subquery_restriction_clause>	::= "WITH" ( ("READ" "ONLY")
									 | ("CHECK" "OPTION") 
									 ) [ "CONSTRAINT" <constraint> ];
									 

//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE SEQUENCE
<create_sequence>			::= node("ELEMENT", 
							attributeEx("EATYPE", "Class")
							attributeEx("EASTEREOTYPE", "Oracle::sequence")
							"CREATE" "SEQUENCE" ["IF" "NOT" "EXISTS" node("Not Exists",attributeEx("VALUE","True"))] 
							[ node("Database and Schema" , ((attribute("VALUE",<schema>  ))|<StringAsValue>)".")  ]
							((attribute("NAME" , <sequence>))|<StringAsName>)
							  [ "SHARING" "=" ( 
										("METADATA" node("Sharing Clause", attributeEx("VALUE" , "Metadata"))) 
										| ("DATA" node("Sharing Clause", attributeEx("VALUE" , "Data"))) 
										| ("EXTENDED" "DATA" node("Sharing Clause", attributeEx("VALUE" , "Extended Data"))) 
										| ("NONE" node("Sharing Clause", attributeEx("VALUE" , "None"))) 
										) ]
							[ (
									( ( ("INCREMENT" "BY"  node("Increment By" , attribute("VALUE" , <NUMBER>)) )
										| ("START" "WITH"  node("Start With" , attribute("VALUE" , <NUMBER>))) ) 
									)
									| ( ("MAXVALUE" node("Maximum Value" , attributeEx("VALUE" , "Yes")) node("Maximum Number" , attribute("VALUE" , <NUMBER>))) 
										| ("NOMAXVALUE" node("Maximum Value" , attributeEx("VALUE" , "No"))) 
										)
									|( ("MINVALUE" node("Minimum Value" , attributeEx("VALUE" , "Yes")) node("Minimum Number" , attribute("VALUE" , <NUMBER>))) 
										| ("NOMINVALUE" node("Minimum Value" , attributeEx("VALUE" , "No"))) 
										)
									| ( ("CYCLE" node("Cycle" , attributeEx("VALUE" , "Yes")) ) 
										| ("NOCYCLE" node("Cycle" , attributeEx("VALUE" , "No"))) 
										)
									| ( ("CACHE" node("Caching Option" , attributeEx("VALUE" , "Cache"))  node("Cache Value" , attribute("VALUE" ,<NUMBER> )) ) 
										| ("NOCACHE" node("Caching Option" , attributeEx("VALUE" , "No Cache")))
										)
									| ( ("ORDER" node("Order" , attributeEx("VALUE" , "Yes"))) 
										| ("NOORDER" node("Order" , attributeEx("VALUE" , "No"))) 
										)
									| ( ("KEEP" node("Keep Option" , attributeEx("VALUE" , "Yes"))) 
										| ("NOKEEP" node("Keep Option" , attributeEx("VALUE" , "No"))) 
										)
									| ( ("SCALE" node("Scale Option" , attributeEx("VALUE" , "Yes")) 
											( ("EXTEND" node("Scale Value" ,attributeEx("VALUE","Extend"))) 
											 | ("NOEXTEND" node("Scale Value" , attributeEx("VALUE" , "NoExtend"))))
										) 
										| ("NOSCALE" node("Scale Option" , attributeEx("VALUE" , "No"))) 
									)
									| ( ("SESSION" node("Scope Specification" , attributeEx("VALUE" , "Session"))) 
										| ("GLOBAL" node("Scope Specification" , attributeEx("VALUE" , "Global"))) 
										)
								)*
							]
							[";"]
							);
							
<sequence>				::= <IDENTIFIER> ;

//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE FUNCTION
<create_function>		::= node("ELEMENT", 
							attributeEx("EATYPE", "Class")
							attributeEx("EASTEREOTYPE", "Oracle::function")
							"CREATE" 
							[ "OR" "REPLACE"  node("Is Replace" , attributeEx("VALUE" , "True"))]
							[ ("EDITIONABLE" node("Function Type" , attributeEx("VALUE" , "Editionable"))) 
								| ("NONEDITIONABLE" node("Function Type" , attributeEx("VALUE" , "Non Editionable"))) ]
							"FUNCTION" ["IF" "NOT" "EXISTS" node("Not Exists",attributeEx("VALUE","True"))] <plsql_function_source>
							[";"]
							);
							
<plsql_function_source>	::= [ node("Database and Schema" , ((attribute("VALUE",<schema>  ))|<StringAsValue>)".") ]
							((attribute("NAME" ,<function_name>) )|<StringAsName>)
							  [ "("  node("Parameter Declaration" , attribute("VALUE" , <function_parameters>)) ")" ] 
							  ("RETURN" node("Return Type" , attribute("VALUE" , <uneffected_datatype>)) )
							 [ "SHARING" "=" ( 
										("METADATA" node("Sharing Clause", attributeEx("VALUE" , "Metadata"))) 
										| ("DATA" node("Sharing Clause", attributeEx("VALUE" , "Data"))) 
										| ("EXTENDED" "DATA" node("Sharing Clause", attributeEx("VALUE" , "Extended Data"))) 
										| ("NONE" node("Sharing Clause", attributeEx("VALUE" , "None"))) 
										) ]
							  [ ( 
									(<invoker_rights_clause>)
									| (<accessible_by_clause>)
									| (<default_collation_clause>  )
									| (<deterministic_clause>)
									| (<parallel_enable_clause>)
									| (<func_result_cache_clause>) 
									| (<aggregate_clause>)
									| (<pipelined_clause>)
									| (<sql_macro_clause>)
								   )*
							  ]
							[( ("IS" node("Object Body Indicator" , attributeEx("VALUE" , "Is"))) 
								| ("AS" node("Object Body Indicator" , attributeEx("VALUE" , "As"))) ) ]
							[node("funcdef" , attribute("VALUE" , <function_body_defintion>))] ;	
							
<function_body_defintion>	::= ( ([ <declare_section> ] <body>)  | (<call_spec>));
							
<function_parameters> 		::= <parameter_declaration> ("," <parameter_declaration>)*;		
										
<call_spec>				::= ( <java_declaration> | <c_declaration> ) ;



<java_declaration>		::= "LANGUAGE" "JAVA" "NAME" <StringValue>;

<c_declaration>			::= ( ("LANGUAGE" "C") | ("EXTERNAL") ) ( [ "NAME" <name> ] "LIBRARY" <lib_name> [ "NAME" <name> ] )
							   [ "AGENT" "IN" "(" <argument> ("," <argument> )* ")" ]
							   [ "WITH" "CONTEXT" ]
							   [ "PARAMETERS" "(" <external_parameter> ("," <external_parameter> )* ")" ];
							   
<lib_name>				::= <IDENTIFIER> ;

<external_parameter>	::= ( ("CONTEXT")
								|( "SELF" [ "TDO" | <property> ])
								| (( <parameter> | "RETURN" ) [ <property> ] [ "BY" "REFERENCE" ] [ <uneffected_datatype> ])
							);
							
<property>				::= ( ("INDICATOR" [ "STRUCT" | "TDO" ])
								| "LENGTH"
								| "DURATION"
								| "MAXLEN"
								| "CHARSETID"
								| "CHARSETFORM"
							);
										
<declare_section>		::= ( (<item_list_1>  [<item_list_2> ]) | (<item_list_2>) );


<item_list_2>			::= ( <cursor_declaration>
								 | <cursor_definition>
								| <function_declaration>
								 |<function_definition>
								| <procedure_declaration>
								| <procedure_definition>
								)*;
								
<procedure_definition>		::= <procedure_declaration> ( "IS" | "AS" ) 
								  ( ([ <declare_section> ] <body>) | <call_spec> )
								;								
								

<function_definition>	::= <function_heading> [ ("DETERMINISTIC"
							| "PIPELINED"
							| <parallel_enable_clause>
							| ("RESULT_CACHE" [ <relies_on_clause> ]) )*
							]
							( "IS" | "AS" ) ( ([ <declare_section> ] <body>) | (<call_spec>) );
							
<body>					::=  ("BEGIN" <statement_clause>* [ "EXCEPTION" <exception_handler>*] "END" [ <name> ] ";") 
								| ( "BEGIN" skipBalanced("BEGIN" , "END") "END" [ <name> ] [";"])	 ;
							
<exception_handler>		::= "WHEN" ( "OTHERS"|(<exception> ("OR" <exception>)* ) )
							  "THEN" <statement_clause>*
							;
							
							
<statement_clause>		::= [ ("<" "<" <label> ">" ">") ]
							  ( 
								<case_statement>
															
								| <exit_statement>
								| <basic_loop_statement>							
								| <close_statement>
								| <continue_statement>
								| <cursor_for_loop_statement>
								| <execute_immediate_statement>
								| <fetch_statement>								
								| <forall_statement>
								| <goto_statement>
								| <if_statement>
								| <null_statement>
								| <open_statement>
								| <pipe_row_statement>
								| <plsql_block>
								| <raise_statement>
								| <return_statement>
								| <select_into_statement>							 
								| <while_loop_statement>
								|<assignment_statement>	
								
							 );
							 
<fetch_statement>				::= "FETCH" skipBalanced("FETCH" , ";") ";";

<exit_statement>				::= "EXIT" skipBalanced("EXIT" , ";") ";";
							 
<execute_immediate_statement>	::= "EXECUTE" skipBalanced("EXECUTE" , ";") ";";
							 
<assignment_statement>		::=  <table_or_string>("."|(":" "=")) (<column_or_string> "("skipBalanced("(",")")")") ";" ;

<basic_loop_statement>		::= "LOOP"  skipBalanced("LOOP" , ("END" "LOOP")) "END" "LOOP" [<label>] ";";

<case_statement>			::= [ "<" "<" <label> ">" ">" ] "CASE"  skipBalanced("CASE" , ("END" "CASE") ) "END" "CASE" ";" ;

<close_statement>			::= "CLOSE" skipBalanced("CLOSE" , ";") ";";

<continue_statement>			::= "CONTINUE" skipBalanced("CONTINUE" , ";") ";";

<cursor_for_loop_statement>	::=  "FOR"  skipBalanced("FOR" , ("END" "LOOP")) "END" "LOOP" [<label>] ";";

<forall_statement>			::= "FORALL" skipBalanced("FORALL" , ";") ";" ;

<goto_statement>			::= "GOTO" <label> ";";

<if_statement>				::= "IF" skipBalanced("IF" , ("END" "IF") ) "END" "IF" ";";

<null_statement>			::= "NULL" ";" ;

<open_statement>			::= "OPEN" skipBalanced("OPEN" , ";" ) ";";

<pipe_row_statement>			::= "PIPE" "ROW" "(" <IDENTIFIER> ")" ";";

<raise_statement>			::= "RISE" skipBalanced("RISE" , ";" ) ";";

<return_statement>		::= "RETURN" skipBalanced("RETURN" , ";" ) ";";

<select_into_statement>	::= "SELECT" skipBalanced("SELECT" , ";" ) ";";

<while_loop_statement>		::= "WHILE" skipBalanced("WHILE" , ("END" "LOOP")) "END" "LOOP" [<label>] ";";


<name>					::= <IDENTIFIER>|<StringValue>;
							

							
<relies_on_clause>		::= <IDENTIFIER> ;
								
<cursor_definition>		::= "CURSOR" <cursor>
							 [ "(" <cursor_parameter_dec> ("," <cursor_parameter_dec> )* ")"]
							   [ "RETURN" <rowtype>] "IS" <SelectQuery> ";" ;

<item_list_1>			::= ( <type_definition>
								| <cursor_declaration>
								| <item_declaration>
								| <function_declaration>
								| <procedure_declaration>
								| <pragma>
							)*;
							
<pragma>				::= "PRAGMA" skipBalanced("PRAGMA" , ";") ";" ;
							
							
<procedure_declaration>		::= <procedure_heading> [ <procedure_properties> ] ["IS" <name> <uneffected_datatype>] [ ";" ];				

<procedure_properties>			::=   [ ( <accessible_by_clause> 	| <default_collation_clause> | <invoker_rights_clause> )* ]   ;	

<accessible_by_clause>		::= "ACCESSIBLE" "BY" "(" node("Accesible By", attribute("VALUE" , (<accessor> ("," <accessor> )*))) ")";

<accessor>					::=  [ <unit_kind> ] [(<schema>|<StringValue>)"."] <unit_name> ;

<unit_name>					::= <IDENTIFIER> ;

<unit_kind>					::= "FUNCTION" | "PROCEDURE" | "PACKAGE" | "TRIGGER" | "TYPE"  ;

<procedure_heading>			::= "PROCEDURE" <procedure> [ "(" <parameter_declaration> ("," <parameter_declaration>)* ")" ] ;		

<procedure>					::= <IDENTIFIER>;
							
<function_declaration>		::= <function_heading>
								[ ("DETERMINISTIC" | "PIPELINED"| "PARALLEL_ENABLE" | "RESULT_CACHE")* ] ["IS" <name> <uneffected_datatype>] ";" ;
								
<function_heading>			::= "FUNCTION" <function_name> [ "(" <parameter_declaration> ("," <parameter_declaration>)* ")" ]
								"RETURN" <uneffected_datatype>;
							
<item_declaration>		::= ( <collection_variable_decl>
								| <constant_declaration>
								| <cursor_variable_declaration>
								| <exception_declaration>
								| <record_variable_declaration>
								| <variable_declaration>
							);	
							
<variable_declaration>		::= <variable> <uneffected_datatype> [ [ "NOT" "NULL"] ( (":" "=") | ("DEFAULT") ) <expression> ] ";" ;

<variable>					::= <IDENTIFIER>;
							
<record_variable_declaration>	::= <record_1> ( <record_type> | <rowtype_attribute> | (<record_2> "%" "TYPE") )";";

<record_1>					::= <IDENTIFIER>;
<record_2>					::= <IDENTIFIER>;
<record_type>					::= <IDENTIFIER>;

<rowtype_attribute>			::= <IDENTIFIER> "%" "ROWTYPE";
							
<exception_declaration>		::= <exception> "EXCEPTION" ";" ;

<exception>				::= <IDENTIFIER> ;
							
<cursor_variable_declaration>		::= <cursor_variable> <type> ";" ;

<constant_declaration>	::= <constant> "CONSTANT" <uneffected_datatype> ["NOT" "NULL"] ( (":" "=" ) | ("DEFAULT") ) ( (<NUMBER> ["." <NUMBER>])|<expression>) ";" ;						

<constant>				::= <IDENTIFIER> ;	
							

<collection_variable_decl>	::= <new_collection_var>

								(( <assoc_array_type> [ ":" "=" <qualified_expression> | <function_call> | <collection_var_1> ])

								| ( (<uneffected_datatype>) | (<uneffected_datatype> [ ":" "=" ( <collection_constructor> | <collection_var_1> ) ])| (<collection_var_2> "%" "TYPE") ))
								
								";";	
								
<collection_var_1>			::= <IDENTIFIER> ;
<collection_var_2>			::= <IDENTIFIER> ;
<collection_constructor>			::= <IDENTIFIER> ;
<function>			::= <IDENTIFIER> ;
								
<function_call>				::= <function> [ "(" [ <parameter> ("," <parameter> )*] ")" ];
								
<qualified_expression>		::= (<typemark> "(" ")") | (<typemark> "(" <expr> ")") | (<typemark> "(" <aggregate> ")" ) ;

<aggregate>					::= [<positional_choice_list>] [<explicit_choice_list>] [<others_choice>] ;

<others_choice>				::= "OTHERS" "=" ">" <expr>;
	
<explicit_choice_list>		::= <explicit_choice_list_values> ("," <explicit_choice_list_values>)* ;

<explicit_choice_list_values>	::=  <named_choice_list> | <indexed_choice_list> | <basic_iterator_choice> | <index_iterator_choice>;

<index_iterator_choice>			::= "FOR" <iterator> "INDEX" <expr> "=" ">" <expr>;

<named_choice_list>				::= ( <IDENTIFIER> [ "|" ] )* "=" ">" <expr>  ; 

<basic_iterator_choice>			::= "FOR" <iterator> "=" ">" <expr>;

<indexed_choice_list>		::= (<expr> [ "|" ])* "=" ">" <expr> ;

<positional_choice_list>	::= ( <expr> | <sequence_iterator_choice> ) (","  ( <expr> | <sequence_iterator_choice> ))* ;

<sequence_iterator_choice> ::= "FOR" <iterator> "SEQUENCE" "=" ">" <expr>;

<iterator>				::= <iterand_decl> ("," <iterand_decl>)* "IN" <iteration_ctl_seq> ;

<iterand_decl>			::= <IDENTIFIER> [ "MUTABLE" | "IMMUTABLE" ] [ <constrained_type> ];

<constrained_type>		::= <IDENTIFIER> ;

<iteration_ctl_seq>		::= <qual_iteration_ctl> ("," <qual_iteration_ctl>)*;

<qual_iteration_ctl>	::= [ "REVERSE" ] <iteration_control> <pred_clause_seq> ;

<pred_clause_seq>		::= [ "WHILE" <logical_Expression> ] ["WHEN" <logical_Expression> ];

<iteration_control>		::= ( <stepped_control> 
								 | <single_expression_control>
								 | <values_of_control> 
								 | <indices_of_control>
								 | <pairs_of_control>
								 | <cursor_iteration_control> );
								 
<cursor_object>			::= <IDENTIFIER> ;
								 
<cursor_iteration_control>	::=  "(" (<cursor_object>  | <cursor_variable>  | <dynamic_sql>  |  <sql_statement>) ")"  ;
								 
<pairs_of_control>		::=	"PAIRS" "OF" ( (<expr>)
							 |  (<cursor_variable>)             
							 | ("(" <cursor_object> ")" )   
							 | ("(" <dynamic_sql> ")")
							 | ("(" <sql_statement> ")") 
							 );
								 
<indices_of_control>	::= "INDICES" "OF" ( (<expr>)
							 |  (<cursor_variable>)             
							 | ("(" <cursor_object> ")" )   
							 | ("(" <dynamic_sql> ")")
							 | ("(" <sql_statement> ")") 
							 );
								 
<values_of_control>		::= "VALUES" "OF" ( (<expr>)
							 |  (<cursor_variable>)             
							 | ("(" <cursor_object> ")" )   
							 | ("(" <dynamic_sql> ")")
							 | ("(" <sql_statement> ")") 
							 );
							 
<sql_statement>			::= <StringValue>;
							 
<dynamic_sql>			::= "EXECUTE" "IMMEDIATE" <dynamic_sql_stmt> [ "USING" ["IN"] (<bind_argument> ("," <bind_argument>)* )  ] ;

<bind_argument>			::= <IDENTIFIER> ;

<dynamic_sql_stmt>		::= <IDENTIFIER>;
									
<single_expression_control>		::= [ "REPEAT" ] <expr>;
								 
<stepped_control>		::= <lower_bound> "." "." <upper_bound> [ "BY" <step> ] ;

<lower_bound>			::= <NUMBER>;

<upper_bound>			::= <NUMBER>;

<step>					::= <NUMBER>;



<typemark>					::= <type_name>;

<new_collection_var>		::= <IDENTIFIER> ;							
<assoc_array_type>		::= <uneffected_datatype> ;							
							
<cursor_declaration>	::= "CURSOR" <cursor>
						  ["(" <cursor_parameter_dec> ("," <cursor_parameter_dec> )* ")"]
							"RETURN" <rowtype> ";" ;
							
<rowtype>				::= ( ((<db_table_or_view> | <cursor> | <cursor_variable>) "%" "ROWTYPE")
											| (<record> "%" "TYPE")
											| (<record_type>)
											| (<ref_cursor_type>)
							);							
							
<cursor_parameter_dec>	::= <parameter> ["IN"] <uneffected_datatype> [ ( (":" "=") | ("DEFAULT") ) <expression> ];							
							
<type_definition>		::= ( <collection_type_definition>
								| <record_type_definition>
								| <ref_cursor_type_definition>
								| <subtype_definition>
							);
							
<subtype_definition>		::= "SUBTYPE" <subtype> "IS" <base_type> [ <fun_constraint> | ("CHARACTER" "SET" <character_set>) ]
								[ "NOT" "NULL" ];	

<subtype>					::= <IDENTIFIER> ;								
<base_type>					::= <IDENTIFIER> ;								
<fun_constraint>					::= ( (<precision> ["," <scale> ]) | ("RANGE" <low_value> ".." <high_value>) ) ;								
<character_set>					::= <IDENTIFIER> ;				

<low_value>					::= <NUMBER> ;
<high_value>					::= <NUMBER> ;
							
<ref_cursor_type_definition>	::= "TYPE" <type> "IS" "REF" "CURSOR"
									  [ "RETURN"
										( ((<db_table_or_view> | <cursor> | <cursor_variable>) "%" "ROWTYPE")
											| (<record> "%" "TYPE")
											| (<record_type>)
											| (<ref_cursor_type>)
										)
									  ] ";";
									  
<db_table_or_view>			::= <IDENTIFIER>;
<cursor>			::= <IDENTIFIER>;
<record>			::= <IDENTIFIER>;

<ref_cursor_type>			::= <IDENTIFIER>;

<cursor_variable>		::=  <IDENTIFIER> ;
							
<record_type_definition>	::= "TYPE" <record_type> "IS" "RECORD"  "(" <field_definition> ("," <field_definition>)* ")" ";";



<field_definition>				::= <field> <uneffected_datatype> [ [ "NOT" "NULL" ] ( (":" "=") | "DEFAULT" ) <expression> ];			

<field>						::= <IDENTIFIER> ;				
							
<collection_type_definition>	::= "TYPE" <type> "IS" 
								   ( <assoc_array_type_def> 
									| <varray_type_def> 
									| <nested_table_type_def>  
									) ";";
									
<nested_table_type_def>			::= "TABLE" "OF" <uneffected_datatype> [ "NOT" "NULL" ];								
									
<varray_type_def>			::= ( "VARRAY" | ([ "VARYING" ] "ARRAY") ) "(" <size_limit> ")"
								"OF" <uneffected_datatype> [ "NOT" "NULL" ];
								
<size_limit>			::= <NUMBER> ;
									
<assoc_array_type_def>	::= "TABLE" "OF" <uneffected_datatype> ["%" "ROWTYPE"] [ "NOT" "NULL" ]
							"INDEX" "BY" ( "PLS_INTEGER" | "BINARY_INTEGER" |( "VARCHAR2" "(" <v_size> ")" )| <uneffected_datatype> );
							
<v_size>				::= <NUMBER> ;
										
<sql_macro_clause>		::= "SQL_MACRO" ( "(" ( "TYPE" "="">" ) "(" (("SCALAR" node("Sql Macro" , attributeEx("VALUE" , "Scalar"))) 
								| ("TABLE" node("Sql Macro" , attributeEx("VALUE" , "Table")))) ")" ")" );										

										
<pipelined_clause>		::= "PIPELINED" node("Pipeline" , attribute("VALUE" , <pipeline_value>)) ;
							
<pipeline_value>		::= ( [ "USING" [(<schema>|<StringValue>)"."] <implementation_type> ]
								| ( ( "ROW" | "TABLE" ) "POLYMORPHIC" [ "USING" [(<schema>|<StringValue>)"."] <implementation_package> ])
							);
							
<implementation_package>	::= <IDENTIFIER> ;
										
<aggregate_clause>		::= "AGGREGATE" "USING" node("Aggregate By" , attribute("VALUE" , ([ (<schema>|<StringValue>) "." ] <implementation_type>))) ;	

<implementation_type>	::= <IDENTIFIER> ;									
										
<func_result_cache_clause>	::= "RESULT_CACHE" [ node("Result Cache" , attribute("VALUE" , <relies_on>)) ];	

<relies_on>				::= "RELIES_ON" "(" [ <data_source> ("," <data_source>)* ] ")";

<data_source>			::= <IDENTIFIER> ;									
										
<parallel_enable_clause>	::= "PARALLEL_ENABLE" node("Parallel Enable" , attributeEx("VALUE" ,"True"))
								[ "(" node("Partition By" , attribute("VALUE" , <partition_by_values>)) ")"];
								 
<partition_by_values>		::= "PARTITION" <argument> "BY"
									( "ANY"
										| (( "HASH" | "RANGE" ) "(" <column_or_string> ("," <column_or_string> )* ")" [ <streaming_clause> ] )
										| ("VALUE" "(" <column_or_string> ")")
									);

<streaming_clause>			::= ( "ORDER" | "CLUSTER" ) <expr> "BY" "(" <column_or_string> ("," <column_or_string> )* ")";								 

<argument>					::= <IDENTIFIER> ;			 	
										
<deterministic_clause>		::= "DETERMINISTIC" node("Deterministic" , attributeEx("VALUE" , "True"));

<default_collation_clause>	::= "DEFAULT" "COLLATION" <collation_option> node("Default Collation" , attributeEx("VALUE" , "True"));		

<collation_option> 			::= "USING_NLS_COMP";						

<parameter_declaration>		::= <parameter> [ ([ "IN"|"OUT"|("IN" "OUT") ] [ "NOCOPY" ] <uneffected_datatype> [ ( (":" "=" )| "DEFAULT" ) <expression> ])]	;	

<parameter>				::= <IDENTIFIER> ;	

//<sharing_clause>		::= "SHARING" "=" ( "METADATA" | "NONE" );

<invoker_rights_clause>	::= "AUTHID" 
								( ("CURRENT_USER" node("Invoker Rights" , attributeEx("VALUE" , "Current User"))) 
									| ("DEFINER" node("Invoker Rights" , attributeEx("VALUE" , "Definer"))) );

//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE PROCEDURE
<create_procedure>		::=  node( "ELEMENT", 
									attributeEx("EATYPE", "Class")
									attributeEx("EASTEREOTYPE", "Oracle::procedure")
									"CREATE" 
									["OR" "REPLACE" node("Is Replace" , attributeEx("VALUE" , "True"))]
								[ ("EDITIONABLE" node("Procedure Type" , attributeEx("VALUE" , "Editionable"))) 
									| ("NONEDITIONABLE" node("Procedure Type" , attributeEx("VALUE" , "Non Editionable"))) ]
									"PROCEDURE" ["IF" "NOT" "EXISTS" node( "Not Exists", attributeEx("VALUE","True"))] <plsql_procedure_source>
									[";"]
							);

<plsql_procedure_source>		::= [node("Database and Schema" , attribute("VALUE" , ((<schema>|<StringValue>)".")))] 
									((attribute("NAME" , <procedure_name>))|<StringAsName>)
								     [ "("  node("Parameter Declaration" , attribute("VALUE" , <function_parameters>)) ")" ] 
									[("RETURN" node("Return Type" , attribute("VALUE" , <uneffected_datatype>)) ) ]
									[ "SHARING" "=" ( 
										("METADATA" node("Sharing Clause", attributeEx("VALUE" , "Metadata"))) 
										| ("DATA" node("Sharing Clause", attributeEx("VALUE" , "Data"))) 
										| ("EXTENDED" "DATA" node("Sharing Clause", attributeEx("VALUE" , "Extended Data"))) 
										| ("NONE" node("Sharing Clause", attributeEx("VALUE" , "None"))) 
										) ]
								   [ ( <default_collation_clause> | <invoker_rights_clause> | <accessible_by_clause> )* ] 
								 [( ("IS" node("Object Body Indicator" , attributeEx("VALUE" , "Is"))) 
									| ("AS" node("Object Body Indicator" , attributeEx("VALUE" , "As"))) ) ]
									[node("procdef" , attribute("VALUE" , <function_body_defintion>))] ;
								   
<procedure_name>			::= <IDENTIFIER> ;

//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE TRIGGER
<create_trigger>			::= node("OPERATION" , 
								attributeEx("EASTEREOTYPE", "Oracle::trigger")
								"CREATE"
								["OR" "REPLACE" node("Is Replace" , attributeEx("VALUE" , "True"))]
								[ ("EDITIONABLE" node("Trigger Type" , attributeEx("VALUE" , "Editionable"))) 
									| ("NONEDITIONABLE" node("Trigger Type" , attributeEx("VALUE" , "Non Editionable"))) ]
								"TRIGGER" ["IF" "NOT" "EXISTS" node( "Not Exists", attributeEx("VALUE","True"))] <plsql_trigger_source>								
								) [";"];
								
<plsql_trigger_source>		::= [node("Database and Schema" ,((attribute("VALUE",<schema>  ))|<StringAsValue>)".")] 
								((attribute("NAME" ,<trigger_name>))|<StringAsName>)
								 [ "SHARING" "=" ( 
										("METADATA" node("Sharing Clause", attributeEx("VALUE" , "Metadata"))) 
										| ("DATA" node("Sharing Clause", attributeEx("VALUE" , "Data"))) 
										| ("EXTENDED" "DATA" node("Sharing Clause", attributeEx("VALUE" , "Extended Data"))) 
										| ("NONE" node("Sharing Clause", attributeEx("VALUE" , "None"))) 
										) ]
								 [ <default_collation_clause> ] 
								  ( 
									  <system_trigger> 
									 |<simple_dml_trigger> 
									| <instead_of_dml_trigger> 
									 | <compound_dml_trigger> 
									);
									
<trigger_name>				::= <IDENTIFIER> ;
									
<system_trigger>			::= ( "BEFORE" | "AFTER" | ("INSTEAD" "OF") )
									
								 [("ON"| (<ddl_event>("OR" <ddl_event> )* "ON")|(<ddl_event> "ON" ))]
								 ( ([(<schema>|<StringValue>) "." ] "SCHEMA") | ([ "PLUGGABLE" ] "DATABASE") )
								[ <trigger_ordering_clause> ] [ "ENABLE" | "DISABLE" ][ "WHEN" "(" skipBalanced("(",")")")" ] <trigger_body>;
								
<ddl_event>					::= <IDENTIFIER>  ;
<database_event>					::= <IDENTIFIER> ;
									
<compound_dml_trigger>		::= "FOR" <dml_event_clause> [ <referencing_clause> ]
								[ <trigger_edition_clause> ] [ <trigger_ordering_clause> ]
								[ "ENABLE" | "DISABLE" ] [ "WHEN" "(" <condition> ")" ] <compound_trigger_block>;
									

<compound_trigger_block>		::= "COMPOUND" "TRIGGER" [ <declare_section> ]
								<timing_point_section>*  "END" [ <trigger> ] ";" ;	

<trigger>					::= <IDENTIFIER>;	

<timing_point_section>		::= <timing_point> "IS" <body>	<timing_point> ";" ;		

<timing_point>				::=  ( ("BEFORE" "STATEMENT") | ("BEFORE" "EACH" "ROW") | ("AFTER" "STATEMENT") | ("AFTER" "EACH" "ROW") | ("INSTEAD" "OF" "EACH" "ROW") );
	
			
									
									
<instead_of_dml_trigger>	::= "INSTEAD" "OF" ( [ "OR"] ( ("DELETE") | ("INSERT")| ("UPDATE" [ "OF" <column_or_string> ("," <column_or_string> )* ]) ))*
								"ON" [ "NESTED" "TABLE" <nested_table_column> "OF" ] [ (<schema>|<StringValue>) "." ] node("OWNER" , attribute("NAME" , <noneditioning_view>) )
								[ <referencing_clause> ] [ "FOR" "EACH" "ROW" ]
								[ <trigger_edition_clause> ] 
								[ <trigger_ordering_clause> ]
								[ "ENABLE" | "DISABLE" ] <trigger_body>;
								
<nested_table_column>		::= <IDENTIFIER>;
<noneditioning_view>		::= <IDENTIFIER>;
								  
<simple_dml_trigger>		::= ( ("BEFORE" node("TRG_TIME" , attributeEx("VALUE" , "Before"))) 
									 | ("AFTER" node("TRG_TIME" , attributeEx("VALUE" , "After"))) ) 
								<dml_event_clause> 
								[ node("Referencing Clause" , attribute("VALUE" , <referencing_clause>)) ] 
								[ "FOR" "EACH" "ROW"  node("For Each Row" , attributeEx("VALUE" , "True"))]
								[ <trigger_edition_clause> ] 
								[ <trigger_ordering_clause> ]
								[ ("ENABLE" node("Trigger Status" , attributeEx("VALUE" , "Enable")))
									| ("DISABLE" node("Trigger Status" , attributeEx("VALUE" , "Disable"))) ] 
								[ "WHEN" "(" node("Search Condition" , attribute("VALUE" , <condition>)) ")" ] 
								attribute("CODE" , <trigger_body>)
								;
									
//Vis_26112026_[261101081]_Simplified [schema.] prefix in DML trigger ON clause (removed duplicate <StringValue> alternative)
<dml_event_clause>			::=(("INSERT" ("OR" "UPDATE"[ "OF" <constraint_column> ("," <constraint_column>)* ] "OR" "DELETE") node("TRG_EVENT" , attributeEx("VALUE" , "Insert or Update or Delete"))) 
								| ("INSERT" ("OR" "UPDATE" [ "OF" <constraint_column> ("," <constraint_column>)* ]) node("TRG_EVENT" , attributeEx("VALUE" , "Insert or Update")))
								| ("INSERT" ("OR" "DELETE") node("TRG_EVENT" , attributeEx("VALUE" , "Insert or Delete"))) 
								| ("UPDATE"   [ "OF" <constraint_column> ("," <constraint_column>)* ]("OR" "DELETE") node("TRG_EVENT" , attributeEx("VALUE" , "Update or Delete"))) 
								| ("INSERT" node("TRG_EVENT" , attributeEx("VALUE" , "Insert")))
								| ("DELETE" node("TRG_EVENT" , attributeEx("VALUE" , "Delete")))
								| ("UPDATE" [ "OF" <constraint_column> ("," <constraint_column>)* ] node("TRG_EVENT" , attributeEx("VALUE" , "Update"))) )
								
								"ON" [ (<schema>|<StringValue>) "."] 							
								  node("OWNER", attribute("NAME",  <table_view> ) )
								  
								  ;
								
//Vis_26112026_[261101081]_DML trigger ON table accepts quoted table names
<table_view>				::= <IDENTIFIER> |<StringValue>;
								
<referencing_clause>		::= "REFERENCING"
								 ( ("OLD" [ "AS" ] <old>)
									 | ("NEW" [ "AS" ] <new>)
									 | ("PARENT" [ "AS" ] <parent>)
								 )*;
								 
<old>				::= <IDENTIFIER>;
<new>				::= <IDENTIFIER>;
<parent>				::= <IDENTIFIER>;

<trigger_edition_clause>	::= ( ("FORWARD" node("Trigger Edition", attributeEx("VALUE" , "Forward"))) 
								| ("REVERSE" node("Trigger Edition", attributeEx("VALUE" , "Reverse"))) ) 
								"CROSSEDITION" ;

<trigger_ordering_clause>	::= node("Trigger Ordering" , attribute("VALUE" , (( "FOLLOWS" | "PRECEDES" ) ([ (<schema>|<StringValue>) "." ] (<trigger_name>|<StringValue>))  ("," ([(<schema>|<StringValue>) "." ] (<trigger_name>|<StringValue>)))*))) ;

<trigger_body>			::= ( <plsql_block> | ("CALL" <routine_clause>) ) ;

<plsql_block>			::= [ ("<" "<"  <label> ">" ">" )* ] [ "DECLARE" <declare_section> ] <body>;

<label>				::= <IDENTIFIER>;

<routine_clause>	::= [ (<schema>|<StringValue>) "." ] [ (<type> "." )| (<package> ".") ]
							( <function> | <procedure> | <method> )
							[ "@" <dblink_name> ]
							["(" [ <argument> ("," <argument> )* ] ")"];
							
<method> 			::= <IDENTIFIER> "(" skipBalanced( "(",")") ")";
<dblink_name> 			::= <IDENTIFIER>;
<package> 			::= <IDENTIFIER>;
				  
<keystore_manamagement_clauses>		::=(<create_keystore>
										|<open_or_close_keystore>
										|<backup_key>
										|<alter_keystore_password>
										|<merge_into_key>
										|<united_or_isolated_keystore>)
										
										;


<create_keystore>					::= "CREATE" [[ "LOCAL" ] "AUTO_LOGIN"] "KEYSTORE" ["FROM" "KEYSTORE"] [<StringValue>] 
										  "IDENTIFIED" "BY" <keystore_password> [";"] ;
										  
<keystore_password>					::= (<StringValue>|<IDENTIFIER>);	

//Vis_26112026_[261101082]_IDENTIFIED BY made optional in SET KEYSTORE OPEN/CLOSE
<open_or_close_keystore>			::=	"SET" "KEYSTORE" ("OPEN"|"CLOSE")
										  [ "FORCE" "KEYSTORE" ]
										  ["IDENTIFIED" "BY" ( ("EXTERNAL" "STORE") | (<keystore_password>) )] //its optional for close command Vis
										  [ "CONTAINER" "=" ( "ALL" | "CURRENT" ) ] [";"]	;
										  
										  
<backup_key>						::= "BACKUP" "KEYSTORE" [ "USING" <StringValue> ]
										  [ "FORCE" "KEYSTORE" ]
										  "IDENTIFIED" "BY" ( "EXTERNAL" "STORE" | <keystore_password> )
										  [ "TO" <StringValue> ] [";"] ;
										  
<alter_keystore_password>			::= "ALTER" "KEYSTORE" "PASSWORD"
										  [ "FORCE" "KEYSTORE" ]
										  "IDENTIFIED" "BY" <keystore_password>
										  "SET" <keystore_password>
										 "WITH" "BACKUP" [ "USING" <StringValue> ] [";"] ;
										 
<merge_into_key>		::= "MERGE" "KEYSTORE" <StringValue> [ "IDENTIFIED" "BY" <keystore_password> ]
								  ["AND" "KEYSTORE" <StringValue> [ "IDENTIFIED" "BY" <keystore_password> ]]
								  "INTO" ("NEW"|"EXISTING") "KEYSTORE" <StringValue> "IDENTIFIED" "BY" <keystore_password>
								  ["WITH" "BACKUP" [ "USING" <StringValue> ] ]
								  [";"] ;
								  
<united_or_isolated_keystore>	::= ["FORCE"]("ISOLATE"|"UNITE") "KEYSTORE" "IDENTIFIED" "BY" <keystore_password>
										("FROM"|"WITH") "ROOT" "KEYSTORE" [ "FORCE" "KEYSTORE" ]
										"IDENTIFIED" "BY" ( "EXTERNAL" "STORE" | <keystore_password> )
										"WITH" "BACKUP" [ "USING" <StringValue> ] 
										  [";"] ;
										 
// mkid:mk hex values. A value like 1234abcd lexes as NUMBER + IDENTIFIER; abcd1234 as one IDENTIFIER.
//Vis_26112026_[261101083]_Added helper for mkid/mk hex values in SET KEY
<mk_hex>					::= ( <NUMBER> [ except(<IDENTIFIER>, ( "USING" | "FORCE" | "IDENTIFIED" )) ] ) | <IDENTIFIER> ;

<key_management_clauses>		::=	<set_key>
									|<create_key>
									|<use_key>
									|<set_tag>
									|<export_or_import_tag>
									|<migrate_key>
									|<move_keys>
									;



//Vis_26112026_[261101083]_SET KEY accepts mkid:mk hex values (replaced invalid "mkid" ":" <NUMBER> "a".."z" form)
<set_key>				::= "SET" [ "ENCRYPTION" ] "KEY" [ <mk_hex> ":" <mk_hex> ]
							  [ "USING" "TAG" <StringValue> ]
							  [ "USING" "ALGORITHM" <StringValue> ]
							  [ "FORCE" "KEYSTORE" ]
							  "IDENTIFIED" "BY" ( "EXTERNAL" "STORE" | <keystore_password> )
							  "WITH" "BACKUP" [ "USING" <StringValue> ] 
							  [ "CONTAINER" "=" ( "ALL" | "CURRENT" ) ]	 [";"] ;		

							  
<create_key>			::=	"CREATE" [ "ENCRYPTION" ] "KEY"
							  [ "USING" "TAG" <StringValue> ]
							  [ "USING" "ALGORITHM" <StringValue> ]
							  [ "FORCE" "KEYSTORE" ]
							  "IDENTIFIED" "BY" ( "EXTERNAL" "STORE" | <keystore_password>)			
							  "WITH" "BACKUP" [ "USING" <StringValue> ] 
							  [ "CONTAINER" "=" ( "ALL" | "CURRENT" ) ]		[";"] ;

<use_key>					::= "USE" [ "ENCRYPTION" ] "KEY" <StringValue>
									  [ "USING" "TAG" <StringValue> ]
									  [ "FORCE" "KEYSTORE" ]
									  "IDENTIFIED" "BY" ( "EXTERNAL" "STORE" | <keystore_password> )
									  [ "WITH" "BACKUP" [ "USING" <StringValue> ]] 		[";"] ;			

<set_tag>					::=	"SET" "TAG" <StringValue> "FOR" <StringValue>
								  [ "FORCE" "KEYSTORE" ]
								  "IDENTIFIED" "BY" ( "EXTERNAL" "STORE" | <keystore_password> )
								  ["WITH" "BACKUP" [ "USING" <StringValue> ]]	[";"] ;							  

<export_or_import_tag>				::= ("EXPORT"|"IMPORT") [ "ENCRYPTION" ] "KEYS" "WITH" "SECRET" <secret>
								  ("TO"|"FROM") <StringValue>
								  ["FORCE" "KEYSTORE" ]
								  "IDENTIFIED" "BY" <keystore_password>
								  [ "WITH" "IDENTIFIER" "IN" ( (<StringValue>(","<StringValue>)*) | ("(" <SelectQuery>")") ) ]
								  ["WITH" "BACKUP" [ "USING" <StringValue> ]]
									[";"] ;	

<secret>					::=<StringValue> ;

<migrate_key>				::=( "USE" | "SET" ) [ "ENCRYPTION" ] "KEY" [ <StringValue> ]
								  "IDENTIFIED" "BY" <keystore_password>
								  [ "FORCE" "KEYSTORE" ]
								  ["REVERSE"] "MIGRATE" "USING" <keystore_password>
									["WITH" "BACKUP" [ "USING" <StringValue> ]]
								   [";"] ;
								   
<move_keys>					::= "MOVE" ["ENCRYPTION"] "KEYS"  
								"TO" "NEW" "KEYSTORE" <keystore_location>
								"IDENTIFIED" "BY" <keystore_password>
								"FROM" ["FORCE"] "KEYSTORE"
								"IDENTIFIED" "BY" <keystore_password>
								["WITH" "IDENTIFIER" "IN"
								  ( (<StringValue>(","<StringValue>)*) | "(" skipBalanced("(",")") ")" ) ]
								"WITH" "BACKUP" ["USING" <StringValue>] 
								[";"] ;
								
<keystore_location>			::=<StringValue> ;


<secret_management_clauses>		::=<add_update_secrect>
									|<delete_secret>
									|<add_update_secret_seps>
									|<delete_secret_seps>
									;



<add_update_secrect>			::= ( "ADD" | "UPDATE" ) "SECRET" <secret> "FOR" "CLIENT" <StringValue>
									  [ "USING" "TAG" <StringValue> ]									
									  [ "FORCE" "KEYSTORE" ]
									  "IDENTIFIED" "BY" ( "EXTERNAL" "STORE" | <keystore_password> )
									   "WITH" "BACKUP" [ "USING" <StringValue> ] [";"] ; 


<delete_secret>					::= "DELETE" "SECRET" "FOR" "CLIENT" <StringValue>
									  [ "FORCE" "KEYSTORE" ]
									  "IDENTIFIED" "BY" ( "EXTERNAL" "STORE" | <keystore_password> )
									  ["WITH" "BACKUP" [ "USING" <StringValue>]] [";"] ;
									  
									  
<add_update_secret_seps>		::= ("ADD" | "UPDATE" ) "SECRET" <StringValue> "FOR" "CLIENT" <StringValue>
									[ "USING" "TAG" <StringValue>] 
									 "TO" [ "LOCAL" ] "AUTO_LOGIN" "KEYSTORE" <StringValue> [";"] ;
									
<delete_secret_seps>			::= "DELETE" "SECRET" "FOR" "CLIENT" <StringValue>  
										"FROM" ["LOCAL"] "AUTO_LOGIN" "KEYSTORE" <StringValue>  [";"] ;
										
										
<zero_down_time_software_patching_clauses>	::= "SWITCHOVER" ["TO"]"LIBRARY" <StringValue> "FOR" "ALL" "CONTAINERS" [";"] ;

//Vis_26112026_[261101084]_Added IF EXISTS to ALTER ANALYTIC VIEW
<alter_analytic_view>			::= "ALTER" "ANALYTIC" "VIEW" ["IF" "EXISTS"] [(<schema>|<StringValue>) "." ] <name> 
									( ("RENAME" "TO" <name>) | "COMPILE"
									| <alter_add_or_drop_cache_clause>) [";"] ; 
									

<alter_add_or_drop_cache_clause>		::=("ADD"|"DROP") "CACHE" "MEASURE" "GROUP" 
											[ ["("]("ALL"|(<name>(","<name>)*)) [")"]]
									"LEVELS"[ ["("](<table_fullname>(","<table_fullname>)*) [")"] ] ;
									
<table_fullname>				::=[<IDENTIFIER> "."][<IDENTIFIER> "."]<IDENTIFIER>  ;

//Vis_26112026_[261101084]_Added IF EXISTS to ALTER ATTRIBUTE DIMENSION
<alter_atribute_dimension>		::= "ALTER" "ATTRIBUTE" "DIMENSION" ["IF" "EXISTS"] [ (<schema>|<StringValue>) "." ]
									<name> ( "RENAME" "TO" <name> | "COMPILE" ) [";"] ; 
									
<alter_audit_policy>			::= "ALTER" "AUDIT" "POLICY" <name>
									  [ "ADD" [ <privilege_audit_clause> ] [ <action_audit_clause> ] 
									  [ <role_audit_clause> ]
									   [ "ONLY" "TOPLEVEL" ] ]
									  [ "DROP" [ <privilege_audit_clause> ] [ <action_audit_clause> ] [ <role_audit_clause> ] 
									   [ "ONLY" "TOPLEVEL" ] ]
									  [ "CONDITION" ( "DROP" | ((<StringValue>) 
										"EVALUATE" "PER" ( "STATEMENT"  | "SESSION" | "INSTANCE" )) ) ] [";"];
										
<privilege_audit_clause>		::= "PRIVILEGES" 
										((("CREATE"|"DROP") "ANY" "TABLE")(","(("CREATE"|"DROP") "ANY" "TABLE"))*) ;

<action_audit_clause>			::= (<componet_actions>|<standard_actions>) ;

<role_audit_clause>				::= "ROLES" (<IDENTIFIER>(","<IDENTIFIER>)*) ;

<standard_actions>				::= "ACTIONS"	(<standard_actions_properties>(","<standard_actions_properties>)*)   ;
									  
//Vis_26112026_[261101071]_Fixed MINING MODEL keyword literal split into separate tokens
<standard_actions_properties>		::=(( ( <object_action> | "ALL" )
										["ON"  (("DIRECTORY" <name>)
										   | ("MINING" "MODEL" [ (<schema>|<StringValue>) "." ] <name>)
										   | ([ (<schema>|<StringValue>) "."] <name> ))])
									  | ( <system_action> | "ALL" )
									  ) ;
									  
<object_action>					::= ("ALTER"| "AUDIT"| "COMMENT"| "DELETE"| "FLASHBACK"| "GRANT"| "INDEX"|
									"INSERT"| "LOCK"| "RENAME"| "SELECT"| "UPDATE"|("ADMINISTER" "KEY" "MANAGEMENT")) [<types_of_object>] ;
									
<system_action>					::=(("CREATE"|"DROP"|"DROP") "JAVA") ;
									
<componet_actions>				::= "ACTIONS" "COMPONENT" "="
								  ((( "DATAPUMP" | "DIRECT_LOAD" | "OLS" | "XS" )
								  (<component_action> ("," <component_action>)* ))
								  |
								 ( "DV" ((<component_action> "ON" <name>) ("," (<component_action> "ON" <name>) )*))
								  | ("PROTOCOL" ["("] ("FTP" | "HTTP" | "AUTHENTICATION") [")"] ));
								  
								  
<component_action>				::=("EXPORT"|"IMPORT") ;

<types_of_object>				::=("DIRECTORY"|"FUNCTION"|("JAVA" "SCHEMA" "OBJECT")|
									"LIBRARY"|("MATERIALIZED" "VIEW")|("MINING" "MODEL")|("OBJECT" "TYPE")|
									"PACKAGE"|"PROCEDURE"|"SEQUENCE"|"TABLE") ;
									
									
//Vis_26112026_[261101084]_Added IF EXISTS to ALTER CLUSTER
//Vis_26112026_[261101071]_Fixed NOCACHE keyword literal (removed leading space)
<alter_cluster>					::= "ALTER" "CLUSTER" ["IF" "EXISTS"] [ (<schema>|<StringValue>)"." ] <name>
								  [( <physical_attributes_clause>
								  | ("SIZE" <size_clause>)
								  |	(<deallocate_unused_clause>)
								  | (( "CACHE" |"NOCACHE" ))
								  | ([ "MODIFY" "PARTITION" <IDENTIFIER> ] <allocate_extent_clause>)
								  )* ]
								  [<parallel_clause> ] [";"];
								  
								  

											  
											  
<deallocate_unused_clause>			::= "DEALLOCATE" "UNUSED"["KEEP" <size_clause>] ;

<allocate_extent_clause>			::= "ALLOCATE" "EXTENT"["(" skipBalanced("(",")") ")"] ;

//Vis_26112026_[261101085]_ALTER DATABASE accepts an optional database name; clause list moved to <database_options>
<alter_database>					::= "ALTER" "DATABASE" ( <database_options>|<database><database_options>) [";"] ;
																		
																		
//Vis_26112026_[261101085]_Helper: ALTER DATABASE clause list
<database_options>					::= (<startup_clauses>
										|<database_file_clauses>
										|<recovery_clauses>
										|<logfile_clauses>
										|<controlfile_clauses>
										|<standby_database_clauses>
										|<default_settings_clauses>
										|<instance_clauses>
										|<security_clause>
										|<prepare_clause>
										|<drop_mirror_copy>
										|<lost_write_protection>
										|<cdb_fleet_clauses>
										|<property_clause>
										|<replay_upgrate_clause>															
										) ;

//Vis_26112026_[261101071]_Fixed READ WRITE keyword literal split into separate tokens
<startup_clauses>					::=( ("MOUNT" [ ( "STANDBY" | "CLONE" ) "DATABASE" ])
											|( "OPEN" [
											  (  "READ" "WRITE" 
												 [ ( "RESETLOGS" | "NORESETLOGS" )]
													[( "UPGRADE" | "DOWNGRADE") ]
											  | ("READ" "ONLY")
											  )])
											) ;
											
<recovery_clauses>					::= (<general_recovery>|<manages_standby_recovery>|(("BEGIN" |"END") "BACKUP")) ;

<general_recovery>					::= "RECOVER"[ "AUTOMATIC" ][ "FROM" <StringValue> ]
										( ("CONTINUE" [ "DEFAULT" ])
											| "CANCEL"
											|(( ("LOGFILE" <StringValue>)
											  | <partial_database_recovery>
											  |<full_database_recovery>
											  )
											  [ ( "TEST"
												| "ALLOW" <NUMBER> "CORRUPTION"
												| <parallel_clause>
												) ])
										) ;
										
<full_database_recovery>			::= [ "STANDBY" ] ["DATABASE"]
										[ (( "UNTIL"("CANCEL" | ("TIME" <StringValue>) | ("CHANGE" <NUMBER>)  | "CONSISTENT"  ))
										  | ("USING" "BACKUP" "CONTROLFILE")
										  | ("SNAPSHOT" "TIME" <IDENTIFIER>)
										  )*
										] ;
										

										
<partial_database_recovery>			::=	(("TABLESPACE" <tablespace> ("," <tablespace> )*)
											| ("DATAFILE" (( <StringValue> | <NUMBER> )
														 ("," ( <StringValue> | <NUMBER> ))*))
											) ;				


<manages_standby_recovery>			::=	"RECOVER" (
													("MANAGED" "STANDBY" "DATABASE"
														[ ( ("USING" "ARCHIVED" "LOGFILE")
														  | ("DISCONNECT" ["FROM" "SESSION"])
														  | "NODELAY"
														  | ("UNTIL" "CHANGE" <NUMBER>)
														  | ("UNTIL" "CONSISTENT")
														  | ("USING" "INSTANCES" ( "ALL" | <NUMBER>))
														  | <parallel_clause>
														  )*
														| "FINISH"
														| "CANCEL"
														]
													)
													| ("TO" "LOGICAL" "STANDBY" ( "KEEP" "IDENTITY"|<name> ))
												)	;									
												
												
<database_file_clauses>						::= ( ("RENAME" "FILE"  (<StringValue> ("," <StringValue> )*)
													   "TO"<StringValue>)
													| <create_datafile_clause>
													| <alter_datafile_clause>
													| <alter_tempfile_clause>
													| <move_datafile_clause>
													) ;
													
													
<create_datafile_clause>					::= "CREATE" "DATAFILE" (( <StringValue> | <NUMBER> )
													 ("," ( <StringValue> | <NUMBER> ))*)
												   
												   [ "AS" ( "NEW"|(<StringValue> (","<StringValue> )*) )] ;
												   
<alter_datafile_clause>						::= "DATAFILE"(( <StringValue> | <NUMBER> )
													 ("," ( <StringValue> | <NUMBER> ))*)
													   ( "ONLINE"
														   | ("OFFLINE" [ "FOR" "DROP" ])
														   |( "RESIZE" <size_clause>)
														   | <autoextend_clause>
														   | ("END" "BACKUP")
														   | "ENCRYPT"
														   | "DECRYPT"
													   ) ;
													   
													   
<autoextend_clause>							::= "AUTOEXTEND"( "OFF"   | ("ON" [ "NEXT" <size_clause> ]
																				[ <maxsize_clause> ]));


<alter_tempfile_clause>					::= "TEMPFILE"
											   (( <StringValue> | <NUMBER> )
													 ("," ( <StringValue> | <NUMBER> ))*)
											   ( ("RESIZE" <size_clause>)
											   | <autoextend_clause>
											   | ("DROP" [ "INCLUDING" "DATAFILES" ])
											   | "ONLINE"
											   | "OFFLINE"
											   ) ;
											   
											   
<move_datafile_clause>					::= "MOVE" "DATAFILE" "("skipBalanced("(",")")")"
												 [ "TO" "(" skipBalanced("(",")") ")" ]
												 [ "REUSE" ] ["KEEP" ] ;
												 
									
<logfile_clauses>				::= ( ( ("ARCHIVELOG" [ "MANUAL" ])
										  | "NOARCHIVELOG")
										| ("SET" "STANDBY" "NOLOGGING" "FOR" (("DATA" "AVAILABILITY") | ("LOAD" "PERFORMANCE")))
										| ("RENAME" "FILE"  (( <StringValue> | <NUMBER> )
													 ("," ( <StringValue> | <NUMBER> ))*)
											"TO" <StringValue>)
										| ( "CLEAR" [ "UNARCHIVED" ]
											"LOGFILE" (<logfile_descriptor> ("," <logfile_descriptor>)*)
											[ "UNRECOVERABLE" "DATAFILE" ] )
										| <add_logfile_clauses>
										| <drop_logfile_clauses>
										| <switch_logfile_clause>
										| <supplemental_db_logging>
										|([ "NO" ] "FORCE""LOGGING")
									) ;
									
<add_logfile_clauses>			::= "ADD" [ "STANDBY" ] "LOGFILE"
										   (("MEMBER" (<StringValue> [ "REUSE" ] ("," <StringValue> [ "REUSE"] )* )
												"TO" (<logfile_descriptor> ("," <logfile_descriptor> )*))
											|
											 (( [ "INSTANCE" <StringValue> ] | [ "THREAD" <NUMBER>] )
											 ([ "GROUP" <NUMBER> ] [<redo_log_file_spec>]
											   ("," [ "GROUP" <NUMBER> ] [<redo_log_file_spec>])*))
											
										   ) ;
										   
<logfile_descriptor>		::=(( "GROUP" <NUMBER>)| ["("]<StringValue>(","<StringValue>)*[")"]) ;

<redo_log_file_spec>		::= "("<StringValue>  ("," <StringValue> )*")"
									[ "SIZE" <size_clause> ]
									[ "BLOCKSIZE" <size_clause>]
									["REUSE" ] ;
									
//Vis_26112026_[261101071]_Fixed MEMBER keyword literal (removed leading space)
<drop_logfile_clauses>		::= "DROP" [ "STANDBY" ] "LOGFILE"
										 (( <logfile_descriptor>
												 ("," <logfile_descriptor> )*)
											   |("MEMBER" 
											   <StringValue>(","<StringValue>)*
														
										   )) ;
										   
<supplemental_db_logging>		::= ( "ADD" | "DROP" ) "SUPPLEMENTAL" "LOG"
									( "DATA"
										| <supplemental_id_key_clause>
										| <supplemental_plsql_clause>
										| <supplemental_subset_replication_clause>
									) ;


<supplemental_plsql_clause>		::= "DATA" "FOR" "PROCEDURAL" "REPLICATION";

<supplemental_subset_replication_clause> ::="DATA" "SUBSET" "DATABASE" "REPLICATION" ;

<switch_logfile_clause>			::= "SWITCH" "ALL" "LOGFILES" "TO" "BLOCKSIZE" <NUMBER> ;
							
<controlfile_clauses>			::=(("CREATE" (   ("FAR" "SYNC" "INSTANCE")|([ "LOGICAL" | "PHYSICAL" ] "STANDBY"))
										  "CONTROLFILE" "AS"
										  <StringValue> [ "REUSE" ]
										)
										| ( "BACKUP" "CONTROLFILE" "TO"
											 ( <StringValue> [ "REUSE" ]
											  | <trace_file_clause>
											 )	 
										 )
									);
									
									
<trace_file_clause>				::= "TRACE"  [ "AS" <StringValue> [ "REUSE" ] ]  [ "RESETLOGS" | "NORESETLOGS" ] ;


<standby_database_clauses>		::=(( ( <activate_standby_db_clause>
										| <maximize_standby_db_clause>
										| <register_logfile_clause>
										| <commit_switchover_clause>
										| <start_standby_clause>
										| <stop_standby_clause>
										| <convert_database_clause>
									) [<parallel_clause>] 
								)
							|
							(<switchover_clause> )) ;
							
<activate_standby_db_clause> ::= "ACTIVATE" [ ("PHYSICAL" | "LOGICAL") ] "STANDBY" "DATABASE" [ "FINISH" "APPLY" ] ;

<maximize_standby_db_clause>	::= "SET" "STANDBY" "DATABASE" "TO" "MAXIMIZE"
										( "PROTECTION" | "AVAILABILITY" | "PERFORMANCE" ) ;

<register_logfile_clause>	::= "REGISTER" [ "OR" "REPLACE" ]  [ "PHYSICAL" | "LOGICAL" ]
									"LOGFILE" [ <file_specification>  ("," <file_specification> )*]
									  [ "FOR" <name> ] ;
									  
									  
<file_specification>		::= (<redo_log_file_spec>|<datafile_tempfile_spec>) ;


<datafile_tempfile_spec>	::= [ <StringValue> ][ "SIZE" <size_clause> ][ "REUSE" ][ <autoextend_clause> ] ;


<commit_switchover_clause>	::= ( "PREPARE" | "COMMIT") "TO" "SWITCHOVER"
									[ "TO" ( ( ( "PHYSICAL" | "LOGICAL")  ("PRIMARY" | "STANDBY"	) 
												[ ( "WITH" | "WITHOUT" ) "SESSION" "SHUTDOWN"
											 ("WAIT" | "NOWAIT" ) ])
										 
									| "CANCEL")] ;
									

<start_standby_clause>		::=( ("START" "LOGICAL" "STANDBY" "APPLY"
									[ "IMMEDIATE" ]
									[ "NODELAY" ]
									 [(("NEW" "PRIMARY" <IDENTIFIER>)
									| ("INITIAL" [ (<IDENTIFIER>|<NUMBER>) ])
									| ( ("SKIP" "FAILED" "TRANSACTION") | "FINISH" ))
									]))  ;
									
									
<stop_standby_clause>		::= ( "STOP" | "ABORT" ) "LOGICAL" "STANDBY" "APPLY" ;

<convert_database_clause>	::= "CONVERT" "TO" ["("] ("PHYSICAL" | "SNAPSHOT") [")"] "STANDBY" ;


<default_settings_clauses>	::=( ("DEFAULT" "EDITION" "=" <name>)
								| ("SET" "DEFAULT" ( "BIGFILE" | "SMALLFILE" ) "TABLESPACE")
								|( "DEFAULT" "TABLESPACE" <tablespace>)
								| ("DEFAULT" [ "LOCAL" ] "TEMPORARY" "TABLESPACE" ( <tablespace> | <name> ))
								|("RENAME" "GLOBAL_NAME" "TO" <IDENTIFIER>("."<IDENTIFIER>("."<IDENTIFIER>)*) )
								| ("ENABLE" "BLOCK" "CHANGE" "TRACKING" [ "USING" "FILE" <StringValue> [ "REUSE" ] ])
								| ("DISABLE" "BLOCK" "CHANGE" "TRACKING")
								| ( ("FORCE"|("NO""FORCE")) "FULL" "DATABASE" "CACHING")
								| ("CONTAINERS" "DEFAULT" "TARGET" "=" ( "("<name>")" | "NONE" ))
								| <flashback_mode_clause>
								| <undo_mode_clause>
								| <set_time_zone_clause>
							) ;
							
<flashback_mode_clause>		::= "FLASHBACK" ( "ON" | "OFF" ) ;

<undo_mode_clause>			::= "LOCAL" "UNDO" ( "ON" | "OFF" ) ;

<set_time_zone_clause>		::= "SET" "TIME_ZONE" "=" <StringValue> ;

<instance_clauses>			::= ( "ENABLE" | "DISABLE" ) "INSTANCE" <StringValue> ;

<security_clause>			::= "GUARD" ("ALL"| "STANDBY" | "NONE" ) ;

<prepare_clause>			::=  "PREPARE" "MIRROR" "COPY" <name> 
								   [ "WITH" ( "UNPROTECTED" | "MIRROR" | "HIGH" ) "REDUNDANCY" ]
								   [ "FOR" "DATABASE" <name> ]  ;
								   
<drop_mirror_copy>			::= "DROP" "MIRROR" "COPY" <name> ;

<lost_write_protection>		::= [ ( "ENABLE" | "DISABLE" | "REMOVE" | "SUSPEND" ) ] "LOST" "WRITE" "PROTECTION" ;

<cdb_fleet_clauses>			::=  ( <lead_cdb_clause> | <lead_cdb_uri_clause> ) ;

<lead_cdb_uri_clause>			::= "SET" ("LEAD_CDB_URI") "=" <StringValue> ;

<lead_cdb_clause>			::=  "SET" "LEAD_CDB" "=" ( "TRUE" | "FALSE" ) ;

<property_clause>			::= "PROPERTY" ( "SET" | "REMOVE" ) "DEFAULT_CREDENTIAL" "=" <name> ;

<replay_upgrate_clause>		::= "UPGRADE" "SYNC" ( "ON" | "OFF" ) ;

<switchover_clause>			::= ("SWITCHOVER"|"FAILOVER") "TO"<name> [ "VERIFY" | "FORCE" ]  ;


//Vis_26112026_[261101071]_Fixed REKEY CREDENTIALS keyword literal split into separate tokens
<alter_database_dictionary>	::= "ALTER" "DATABASE" "DICTIONARY" 
								(   ("ENCRYPT" "CREDENTIALS")
								  | ("REKEY" "CREDENTIALS")
								  | ("DELETE" "CREDENTIALS" "KEY") 
								)[";"] ;
								
								
								
//Vis_26112026_[261101086]_Added ALTER [SHARED] [PUBLIC] DATABASE LINK [IF EXISTS]
<alter_database_link> 		::=	"ALTER" [ "SHARED" ] [ "PUBLIC" ] "DATABASE" "LINK" ["IF" "EXISTS"] <dblink>
								  ( "CONNECT" ( ["("] "TO" <name> "IDENTIFIED" "BY" <password> [ <dblink_authentication> ] [")"]
											  | ("WITH" <name>)
								  | <dblink_authentication>
								  ));							
//Vis_26112026_[261101086]_Helper: credential name
<credential>				::= <IDENTIFIER> ;
								
<alter_dimension>			::= "ALTER" "DIMENSION" [ (<schema>|<StringValue>) "." ] <IDENTIFIER> 
								 ( ( "ADD" ( <level_clause>
											| <hierarchy_clause>
											| <attribute_clause>
											
										)
								  )
								  |
								  ( "DROP" ( "LEVEL" <level_name> [ "RESTRICT" | "CASCADE" ]
										 | ("HIERARCHY" <hierarchy>)
										 | ("ATTRIBUTE" <attributes> [ "LEVEL" <level_name> [ "COLUMN" <column_or_string> ] ])*
										 )
								  )
								  |
								  "COMPILE")*
								  [";"] ;
								  
<level_clause>				::= "LEVEL" <level_name> "IS"
									   (   "(" skipBalanced("(",")") ")" |(<IDENTIFIER>"." <IDENTIFIER>)
									   ) [ "SKIP" "WHEN" "NULL" ] ;
									   
									   
<hierarchy_clause>			::= "HIERARCHY" <hierarchy>	"("skipBalanced("(",")")")" ;
										
<hierarchy>					::=<IDENTIFIER> ;

<attribute_clause>			::= "ATTRIBUTE" <level_name> ["LEVEL" <level_name>] "DETERMINES"
								   ( <column_or_string> | "(" <column_or_string>  ("," <column_or_string>)* ")"   ) ;
								   
<alter_disk_group>			::= "ALTER" "DISKGROUP"
									  (("ALL"| (<diskgroup_name>(","<diskgroup_name>)*  ))
												 ((((<addordropdisk> ("," <addordropdisk>)* )| <resize_disk_clause>) [ <rebalance_diskgroup_clause> ])
												  | <replace_disk_clause>
												  | <rename_disk_clause>
												  | <disk_online_clause>
												  | <disk_offline_clause>
												  | <rebalance_diskgroup_clause>
												  | <check_diskgroup_clause>
												  | <diskgroup_template_clauses>
												  | <diskgroup_directory_clauses>
												  |<diskgroup_alias_clause>
												  | <diskgroup_volume_clauses>
												  | <diskgroup_attributes>
												  |	<modify_diskgroup_file>
												  | <drop_diskgroup_file_clause>
												  | <convert_redundancy_clause>
												  | <usergroup_clauses>
												  | <user_clauses>
												  | <file_permissions_clause>
												  | <file_owner_clause>
												  | <scrub_clause>
												  | <quotagroup_clauses>
												  | <filegroup_clauses>
												  |<undrop_disk_clause>
												  | <diskgroup_availability>
												  | <enable_disable_volume>
											  )*
										
											
									  ) [";"] ;
									  
									  

<addordropdisk>				::=  ( <add_disk_clause> | <drop_disk_clause> ) ;
									  
<diskgroup_name>			::=<IDENTIFIER> ;
									  
									  
<add_disk_clause>					::= "ADD"  ( "SITE" <name> [ ("QUORUM" | "REGULAR") ] [ "FAILGROUP" <name> ]
											"DISK" (<qualified_disk_clause> ("," <qualified_disk_clause> )*)) ;
											
<qualified_disk_clause>				::= <StringValue> [ "NAME" <name> ][ "SIZE" <size_clause> ][ ("FORCE" | "NOFORCE") ] ;

//Vis_26112026_[261101071]_Fixed unquoted DROP keyword
<drop_disk_clause>					::= "DROP" ( "DISKS" "IN" [ "QUORUM" | "REGULAR" ] "FAILGROUP"
												((<name> [ "FORCE" | "NOFORCE" ])
												("," (<name> [ "FORCE" | "NOFORCE" ]))* )|
												([ "QUORUM" | "REGULAR" ] "DISK" ((<name> [ "FORCE" | "NOFORCE" ])
												("," (<name> [ "FORCE" | "NOFORCE" ]))*)
												)
											);
											
<disk_online_clause>				::=	"ONLINE" (( "DISKS" "IN" [ "QUORUM" | "REGULAR" ] "FAILGROUP" (<name> ("," <name>)* ))		
										|([ "QUORUM" | "REGULAR" ] "DISK" (<name> ("," <name> )*) )
										  )* [ "POWER" <NUMBER> ] [ ("WAIT" | "NOWAIT") ] ;								
											
											
											
<resize_disk_clause>				::= "RESIZE" "ALL" [ "SIZE" <size_clause> ] ;

<replace_disk_clause>				::= "REPLACE" "DISK" ((<name> "WITH" <StringValue> [ "FORCE" | "NOFORCE" ])
										  ("," (<name> "WITH" <StringValue> [ "FORCE" | "NOFORCE" ]))*)
										[ "POWER" <NUMBER> ] [ "WAIT" | "NOWAIT" ] ;
										
<rename_disk_clause>				::= "RENAME" ( "DISK" ((<name> "TO" <name> )("," (<name> "TO" <name> ))*) 
										| ("DISKS" "ALL") ) ;
								  
<disk_offline_clause>				::= "OFFLINE" (( "DISKS" "IN" [ "QUORUM" | "REGULAR" ] "FAILGROUP" (<name> ("," <name>)* ))		
										|([ "QUORUM" | "REGULAR" ] "DISK" (<name> ("," <name> )*) )
										  )* [ <timeout_clause> ] ;
										  
<timeout_clause>					::="DROP" "AFTER" <NUMBER> ("M" | "H" ) ;

<rebalance_diskgroup_clause>		::= "REBALANCE"
										  [ (( "MODIFY" "POWER" [ <NUMBER> ] )|
											( [ ( "WITH" | "WITHOUT" ) (<phase> ("," <phase>)*) ] [ "POWER" <NUMBER> ] [ ("WAIT" | "NOWAIT") ] ))] ;
											
<phase>					::=<IDENTIFIER> ;

<check_diskgroup_clause>			::= "CHECK" [ ("REPAIR" | "NOREPAIR"|"ALL")* ] ;

<diskgroup_template_clauses>		::=(( ( "ADD" | "MODIFY" ) "TEMPLATE" ((<name> <qualified_template_clause>)
										  (","<name> <qualified_template_clause> )*))
									| ( "DROP" "TEMPLATE" <name> ("," <name> )*)
									) ;
									
<filename>							::=<StringValue> ;
									
<qualified_template_clause>			::= "ATTRIBUTES" "(" skipBalanced("(",")")    ")" ;

<diskgroup_directory_clauses>		::= ( (("ADD"|"DROP") "DIRECTORY" (<filename> [ "FORCE" | "NOFORCE" ]
											("," <filename> [ "FORCE" | "NOFORCE" ])* ))
										|( "RENAME" "DIRECTORY"
													((<filename> "TO" <filename>)
													("," <filename> "TO" <filename> )*))
										) ;
										
<diskgroup_alias_clause>			::= ( ("ADD" "ALIAS"	((<StringValue> "FOR" <filename>)	("," (<StringValue> "FOR" <filename>))*))
											| ("DROP" "ALIAS" (<StringValue> ("," <StringValue> )*))
											| ("RENAME" "ALIAS"	((<StringValue> "TO" <filename>)	("," (<StringValue> "TO" <filename>))*))) ;
										

<diskgroup_volume_clauses>			::= ( <add_volume_clause>
											| <modify_volume_clause>
											| ("RESIZE" "VOLUME" <asm_volume> "SIZE" <size_clause>)
											| ("DROP" "VOLUME" <asm_volume>)
										) ;
										
										
<add_volume_clause>					::= "ADD" "VOLUME" <asm_volume> "SIZE" <size_clause> [<redundancy_clause>]
										  [ "STRIPE_WIDTH" <NUMBER> ("K" | "M") ]
										  [ "STRIPE_COLUMNS" <NUMBER> ] ;
										  
										  
<asm_volume>						::=<IDENTIFIER> ;

<redundancy_clause>					::=[ "MIRROR" | "HIGH" | "UNPROTECTED" | "PARITY" | "DOUBLE" ] ;

<modify_volume_clause>				::= "MODIFY" "VOLUME" <asm_volume>
										  [ "MOUNTPATH" <StringValue> ]
										  [ "USAGE" <StringValue> ] ;
										  
										  
<diskgroup_attributes> ::= "SET" "ATTRIBUTE" <StringValue> "=" <StringValue> ;

<modify_diskgroup_file>				::= "MODIFY" "FILE" ((<StringValue> "ATTRIBUTE" "("skipBalanced("(",")") ")")
										("," (<StringValue> "ATTRIBUTE" "("skipBalanced("(",")") ")") )*) ;
										
<drop_diskgroup_file_clause> 		::= "DROP" "FILE" (<StringValue> ("," <StringValue> )*) ;

<convert_redundancy_clause>			::= "CONVERT" "REDUNDANCY""TO" "FLEX" ;

<usergroup_clauses>					::= (( "ADD" "USERGROUP" <StringValue> "WITH" "MEMBER" (<StringValue> ("," <StringValue> )*) )
											| ("MODIFY" "USERGROUP" <StringValue> ("ADD" | "DROP" ) "MEMBER" (<StringValue> ("," <StringValue> )*))
											| ("DROP" "USERGROUP" <StringValue>)
										) ;
										
<user_clauses>						::=( ("ADD"|"DROP" )"USER" (<StringValue> ("," <StringValue> )*) ["CASCADE"]
										| ("REPLACE" "USER"((<StringValue> "WITH" <StringValue>) ("," (<StringValue> "WITH" <StringValue>))*))
										) ;
										
<file_permissions_clause>			::= "SET" "PERMISSION"(<file_permission_setup>
										  ("," <file_permission_setup>)*)
											"FOR" "FILE" (<StringValue> ("," <StringValue>)*) ;
											
<file_permission_setup>			::=( "OWNER" | "GROUP" | "OTHER" )  "=" ( "NONE" | "READ" "ONLY" | "READ" "WRITE" ) ;


<file_owner_clause>					::= "SET" "OWNERSHIP"( (<file_owner_setup>("," <file_owner_setup>)*)
													  ) "FOR" "FILE" (<StringValue> ("," <StringValue>)*) ;
													  
<file_owner_setup>				::=(("OWNER" "=" <StringValue>) | ("GROUP" "=" <StringValue>)) ;

<scrub_clause>					::= "SCRUB" [ ("FILE" <StringValue>) | ("DISK" <name> )]
										  [ "REPAIR" | "NOREPAIR"]
										  ["POWER" ( "AUTO" | "LOW" | "HIGH" | "MAX" ) ]
										  [ "WAIT" | "NOWAIT" ]
										  [ "FORCE" | "NOFORCE" ]
										  [ "STOP" ] ;
										  
<quotagroup_clauses>			::= ( (("ADD"|"MODIFY") "QUOTAGROUP" <name> [ "SET" <name> "=" <IDENTIFIER> ])
										|("MOVE" "FILEGROUP" <name> "TO" <name>)
										| ("DROP" "QUOTAGROUP" <name>)
										) ;
										
										
<filegroup_clauses>			::=( <add_filegroup_clause>
									| <modify_filegroup_clause>
									| <move_to_filegroup_clause>
									| <drop_filegroup_clause>
									) ;
									
									
<add_filegroup_clause>			::= "ADD" "FILEGROUP" <name>
									  ( "DATABASE" <name>
										  | "CLUSTER" <name>
										  | "VOLUME" <asm_volume>
										  | "TEMPLATE" [ "FROM" "TEMPLATE" <name> ]
									  )
									[ "SET" <StringValue> "=" <StringValue>  ] ;
									
<modify_filegroup_clause>			::= "MODIFY" "FILEGROUP" <name> "SET" <StringValue> "=" <StringValue> ;

<move_to_filegroup_clause>			::= "MOVE" "FILE" <StringValue> "TO" "FILEGROUP" <name>  ;

<drop_filegroup_clause>				::= "DROP" "FILEGROUP" <name> [ "CASCADE" ] ;


<undrop_disk_clause>				::= "UNDROP" "DISKS" ;
 
<diskgroup_availability>			::= ( ("MOUNT"|"DISMOUNT" )[ ("RESTRICTED" | "NORMAL") ] 
													   [ ("FORCE" | "NOFORCE") ]) ;
													   
<enable_disable_volume>				::= (( "ENABLE" | "DISABLE" ) "VOLUME"  ( "ALL" |(<asm_volume> ("," <asm_volume>)* ) )) ;
											
											
<alter_flashback_archive>			::= "ALTER" "FLASHBACK" "ARCHIVE" <name>
										  ( ("SET" "DEFAULT")
											  | (( "ADD" | "MODIFY" ) "TABLESPACE" <tablespace> [<flashback_archive_quota>])
											  | ("REMOVE" "TABLESPACE" <name>)
											  | ("MODIFY" "RETENTION" <flashback_archive_retention>)
											  | ("PURGE" ( "ALL" | ("BEFORE" ( "SCN" <expr> | "TIMESTAMP" <expr> ) )))
											  | (["NO"] "OPTIMIZE" "DATA")
										  )[";"] ;
										  
<flashback_archive_quota>			::= "QUOTA" <NUMBER> ( "M" | "G" | "T" | "P" | "E" ) ;

<flashback_archive_retention>		::= "RETENTION" <NUMBER> ("YEAR" | "MONTH" | "DAY") ;


//Vis_26112026_[261101084]_Added IF EXISTS to ALTER FUNCTION
<alter_function>					::= "ALTER" "FUNCTION" ["IF" "EXISTS"] [ (<schema>|<StringValue>)"." ] <function_name>
										( <function_compile_clause> |( ( "EDITIONABLE" | "NONEDITIONABLE" )) ) [";"] ;
										
<function_compile_clause>			::= "COMPILE" [ "DEBUG" ] [ <compiler_parameters_clause>*  ] [ "REUSE" "SETTINGS" ] ;

<compiler_parameters_clause>		::= (<parameter_name> "=" <parameter_value> );

<parameter_name>					::=(<StringValue>|<IDENTIFIER>) ;

<parameter_value>					::=(<StringValue>|<NUMBER>|<IDENTIFIER>) ;

//Vis_26112026_[261101084]_Added IF EXISTS to ALTER HIERARCHY
<alter_hierarchy>					::= "ALTER" "HIERARCHY" ["IF" "EXISTS"] [ (<schema>|<StringValue>)"." ] <name>
											(( "RENAME" "TO" <name>)| "COMPILE" )[";"] ;
											
											
//Vis_26112026_[261101087]_ALTER INDEX REBUILD accepts DEFERRED/IMMEDIATE INVALIDATION
<alter_index>						::= "ALTER" "INDEX" [ (<schema>|<StringValue>) "." ] <index_name> [ <index_ilm_clause> ]
												  ( 	(<rebuild_clause>[ ( "DEFERRED" | "IMMEDIATE" ) "INVALIDATION" ])
													  | ("PARAMETERS" "(" <StringValue> ")")
													  | "COMPILE"
													  | ( "ENABLE" | "DISABLE" )
													  | ("UNUSABLE" [ "ONLINE" ] [ ( "DEFERRED" | "IMMEDIATE" ) "INVALIDATION" ])
													  |( "VISIBLE" | "INVISIBLE")
													  |("RENAME" "TO" <name>)
													  | ("COALESCE" [ "CLEANUP" ] [ "ONLY" ] [ <parallel_clause> ])
													  | (( "MONITORING" | "NOMONITORING" ) "USAGE")
													  | ("UPDATE" "BLOCK" "REFERENCES")
													  | <alter_index_partitioning>
													  |(( <deallocate_unused_clause>
															| <allocate_extent_clause>
															| <shrink_clause>
															| <parallel_clause>
															| <physical_attributes_clause>
															| <logging_clause>
															| <partial_index_clause>
														)*)
												  )
												 [";"] ;
												  
<shrink_clause>				::= "SHRINK" "SPACE" [ "COMPACT" ] [ "CASCADE" ] ;


<alter_index_partitioning>	::= ( <modify_index_default_attrs>
									| <add_hash_index_partition>
									| <modify_index_partition>
									| <rename_index_partition>
									| <drop_index_partition>
									| <split_index_partition>
									| <coalesce_index_partition>
									| <modify_index_subpartition>
									) ;
									
									
<modify_index_default_attrs>		::= "MODIFY" "DEFAULT" "ATTRIBUTES"
										   [ "FOR" "PARTITION" <IDENTIFIER> ]
										   ( <physical_attributes_clause> | ("TABLESPACE" ( "DEFAULT"|<tablespace> )) | <logging_clause> )* ;
										   
<add_hash_index_partition>			::= "ADD" "PARTITION"   [ <name> ]   [ "TABLESPACE" <tablespace> ]   [ <index_compression> ]   [ <parallel_clause> ] ;

<coalesce_index_partition>			::= "COALESCE" "PARTITION" [ <parallel_clause> ] ;


<modify_index_partition>			::= "MODIFY" "PARTITION" <IDENTIFIER>
											( (( <deallocate_unused_clause>
												  | <allocate_extent_clause>
												  | <physical_attributes_clause>
												  | <logging_clause>
												  | <index_compression>
											  )*)
												| ("PARAMETERS" "("<StringValue>")")
												| ("COALESCE" [ "CLEANUP" ] [  <parallel_clause> ])
												| ("UPDATE" "BLOCK" "REFERENCES")
												| "UNUSABLE"
											) ;
											
<rename_index_partition>			::= "RENAME"  ( ("PARTITION" <IDENTIFIER>) | ("SUBPARTITION" <IDENTIFIER>) ) "TO" <name> ;

<split_index_partition>				::= "SPLIT" "PARTITION" <name>   "AT" "(" skipBalanced("(",")") ")" ["INTO" "(" skipBalanced("(",")") ")" ] [ <parallel_clause> ] ;

<modify_index_subpartition>			::= "MODIFY" "SUBPARTITION" <IDENTIFIER> ( "UNUSABLE"| <allocate_extent_clause>| <deallocate_unused_clause>) ;

<drop_index_partition>				::= "DROP" "PARTITION" <name> ;

<rebuild_clause>					::= "REBUILD"  [ ( ("PARTITION" | "SUBPARTITION") <IDENTIFIER>  )    | ( "REVERSE" | "NOREVERSE" )  ]
												  [ (<parallel_clause>
												  |( "TABLESPACE" <tablespace>)
												  | ("PARAMETERS" "(" <StringValue> ")")
												  | <XMLIndex_parameters_clause>
												  | "ONLINE"
												  | <physical_attributes_clause>
												  | <index_compression>
												  | <logging_clause>
												  | <partial_index_clause>)*
												  ] ;
												  
//Vis_26112026_[261101084]_Added IF EXISTS to ALTER INDEXTYPE
<alter_index_type>					::= "ALTER" "INDEXTYPE" ["IF" "EXISTS"] [ (<schema>|<StringValue>)"." ] <indextype>
										  (((<index_type_properties>	( "," <index_type_properties>)*) [ <using_type_clause> ])
										  | "COMPILE"  )
										  ["WITH" "LOCAL" [ "RANGE" ] "PARTITION" ] [ <stop_standby_clause_index> ] [";"] ;


<index_type_properties>				::=(( "ADD" | "DROP" ) [ (<schema>|<StringValue>) "." ] <IDENTIFIER> "(" skipBalanced("(",")") ")" ) ;

<using_type_clause>					::= "USING" [ (<schema>|<StringValue>) "." ] <implementation_type> [ <array_DML_clause> ] ;


<array_DML_clause> 					::= [ "WITH" |"WITHOUT" ] "ARRAY" "DML"
											[ "(" skipBalanced("(",")") ")" ("," "(" skipBalanced("(",")") ")")*] ; 
											
											
<stop_standby_clause_index>				::= "WITH" ("SYSTEM" | "USER") "MANAGED" "STORAGE" "TABLES" ; 

//Vis_26112026_[261101084]_Added IF EXISTS to ALTER INMEMORY JOIN GROUP
<alter_inmemory_join_group>				::= "ALTER" "INMEMORY" "JOIN" "GROUP" ["IF" "EXISTS"] [ (<schema>|<StringValue>) "." ] <name>  ( "ADD" | "REMOVE" ) "(" skipBalanced("(",")") ")" [";"] ;

//Vis_26112026_[261101084]_Added IF EXISTS to ALTER JAVA
<alter_java>						::= "ALTER" "JAVA" ["IF" "EXISTS"] ( "SOURCE" | "CLASS" ) [ (<schema>|<StringValue>)"." ]<StringValue>
										  [ "RESOLVER" "(" skipBalanced("(",")") ")" ]
										  ( ( "COMPILE" | "RESOLVE" ) | <invoker_rights_clause>  ) [";"] ;
										  


//Vis_26112026_[261101084]_Added IF EXISTS to ALTER LIBRARY
<alter_library>						::= "ALTER" "LIBRARY" ["IF" "EXISTS"] [ (<schema>|<StringValue>) "." ] <name>( <library_compile_clause> | ( "EDITIONABLE" | "NONEDITIONABLE" ) ) [";"] ;


<library_compile_clause>			::= "COMPILE" [ "DEBUG" ] [ <compiler_parameters_clause>* ] [ "REUSE" "SETTINGS" ] ;

<alter_lockdown_profile>			::= "ALTER" "LOCKDOWN" "PROFILE" <name>
										  ( <lockdown_features>
										  | <lockdown_statements>
										  ) [ "USERS" "=" ( "ALL" | "COMMON" | "LOCAL" ) ][";"] ;
										  
<lockdown_features>					::= ( "DISABLE" | "ENABLE" ) ("FEATURE"|"OPTIOIN")( ( "=" "(" skipBalanced("(",")") ")" )| ( "ALL" [ "EXCEPT" "=" "(" skipBalanced("(",")")")" ] )) ;

<lockdown_statements>				::= ( "DISABLE" | "ENABLE" ) "STATEMENT"
											( ( "=" "(" skipBalanced("(",")") ")"  [<statement_clauses>] )
											| ( "ALL" [ "EXCEPT" "=" "(" skipBalanced("(",")")")" ]   )
											) ;
											
<statement_clauses>					::= "CLAUSE"( ( "=" "(" skipBalanced("(",")")   ")" [<clause_options>]  )
												| ( "ALL" [ "EXCEPT" "=" "(" skipBalanced("(",")")   ")" ] )
												) ;
												
<clause_options>					::= "OPTION"(  ( "=" "(" skipBalanced("(",")") ")" [<option_values>] )
													| ( "ALL" [ "EXCEPT" "=" "(" skipBalanced("(",")") ")" ] ) ) ;
													
<option_values>						::=( ( "VALUE" "=" "(" skipBalanced("(",")") ")" )
											  |
											  ( "MINVALUE" "=" <StringValue>	 )
											  |
											  ( "MAXVALUE" "=" <StringValue> )
											)* ;
											
											
//Vis_26112026_[261101084]_Added IF EXISTS to ALTER MATERIALIZED VIEW
<alter_materialized_view>			::= "ALTER" "MATERIALIZED" "VIEW" ["IF" "EXISTS"]
											  [ (<schema>|<StringValue>) "." ] (<view>|<StringValue>)
											  [ (<physical_attributes_clause>
												  | <modify_mv_column_clause>
												  | <table_compression>
												  | <inmemory_table_clause>
												  | (<LOB_storage_clause> ("," <LOB_storage_clause> )*)
												  | (<modify_LOB_storage_clause> ("," <modify_LOB_storage_clause> )*)
												  | <alter_table_partitioning>
												  | <parallel_clause>
												  | <logging_clause>
												  | <allocate_extent_clause>
												  | <deallocate_unused_clause>
												  | <shrink_clause>
												  | ( "CACHE" | "NOCACHE" ))
											  ]
											  [ <alter_iot_clauses> ]
											  [ "USING" "INDEX" <physical_attributes_clause> ]
											  [ (("MODIFY" <scoped_table_ref_constraint>)
												| <alter_mv_refresh>)
											  ]
											  [ <evaluation_edition_clause> ]
											  [ (( "ENABLE" | "DISABLE" ) "ON" "QUERY" "COMPUTATION" )]
											  [( <alter_query_rewrite_clause> 
												  | "COMPILE"
												  | ("CONSIDER" "FRESH"))
											  ] [";"] ;
											  
<modify_mv_column_clause>			::= "MODIFY" "(" skipBalanced("(",")")  ")" ;

<modify_LOB_storage_clause>			::= "MODIFY" "LOB" "(" skipBalanced("(",")") ")"   "(" skipBalanced("(",")") ")" ;

<alter_table_partitioning>			::= ( <modify_table_default_attrs>
											| <alter_automatic_partitioning>
											| <alter_interval_partitioning>
											| <set_subpartition_template>
											| <modify_table_partition>
											| <modify_table_subpartition>
											| <move_table_partition>
											| <move_table_subpartition>
											| <add_external_partition_attrs>
											| <add_table_partition>
											| <coalesce_table_partition>
											| <drop_external_partition_attrs>
											| <drop_table_partition>
											| <rename_partition_subpart>
											| <truncate_partition_subpart>
											| <split_table_partition>
											| <merge_table_partitions>
											| <merge_table_subpartitions>
											| <exchange_partition_subpart>
										) ;
										
<drop_external_partition_attrs>		::= "DROP" "EXTERNAL" "PARTITION" "ATTRIBUTES" ;
										
<modify_table_default_attrs>		::= "MODIFY" "DEFAULT" "ATTRIBUTES"
										   [ "FOR" <name> ]
										   [ "DEFAULT" "DIRECTORY" <directory> ]
										   [ <deferred_segment_creation> ]
										   [ <read_only_clause> ]
										   [ <indexing_clause> ]
										   [ <segment_attributes_clause> ]
										   [ <table_compression> ]
										   [ <inmemory_clause> ]
										   [ "PCTTHRESHOLD" <NUMBER> ]
										   [ <prefix_compression> ]
										   [ <alter_overflow_clause> ]
										   [ ((( "LOB" "("skipBalanced("(",")") ")") | ("VARRAY" <IDENTIFIER>) ) "(" skipBalanced("(",")")")")* ] ;
										   
<alter_overflow_clause>				::= ( <add_overflow_clause>
											|( "OVERFLOW"
												 ( <segment_attributes_clause>
												 | <allocate_extent_clause>
												 | <shrink_clause>
												 | <deallocate_unused_clause>
												 ))*
										) ;
										
<add_overflow_clause>				::= "ADD" "OVERFLOW" [ <segment_attributes_clause> ]
										  [ "("  skipBalanced("(",")") ")" ] ;
										
										
<alter_automatic_partitioning>		::= ( ("SET" "PARTITIONING" ( "AUTOMATIC" | "MANUAL" ))
											| ("SET" "STORE" "IN" "(" <tablespace> ("," <tablespace> )* ")")
											) ;
											
											
<alter_interval_partitioning>		::= ( ("SET" "INTERVAL" "(" skipBalanced("(",")") ")")
											| ("SET" "STORE" "IN" "(" skipBalanced("(",")") ")")
											) ;
											
<set_subpartition_template>			::= "SET" "SUBPARTITION" "TEMPLATE"
										   ( ("(" skipBalanced("(",")") ")")
											   | <hash_subpartition_quantity>
										   ) ;
										   
<modify_table_partition>			::= ( <modify_range_partition>| <modify_hash_partition>| <modify_list_partition>) ;

<modify_range_partition>			::= "MODIFY" <name>
										   ( <partition_attributes>
											  | ( <add_range_subpartition>
												 | <add_hash_subpartition>
												 | <add_list_subpartition>
												 )
											   | <coalesce_table_subpartition>
											   | <alter_mapping_table_clause>
											   | ([ "REBUILD" ] "UNUSABLE" "LOCAL" "INDEXES")
											   | <read_only_clause>
											   | <indexing_clause>
										   ) ;
										   
<partition_attributes>				::=[ ( <physical_attributes_clause>
											  | <logging_clause>
											  | <allocate_extent_clause>
											  | <deallocate_unused_clause>
											  | <shrink_clause>
										  )*
										]
										[ "OVERFLOW"
										  ( <physical_attributes_clause>
											  | <logging_clause>
											  | <allocate_extent_clause>
											  | <deallocate_unused_clause>
										  )*
										]
										[ <table_compression> ]
										[ <inmemory_clause> ]
										[ ((( "LOB" "("skipBalanced("(",")") ")") | ("VARRAY" <IDENTIFIER>) ) "(" skipBalanced("(",")")")")* ] ;
										
<add_hash_subpartition>			::= "ADD" <individual_hash_subparts>
										   [ <dependent_tables_clause> ]
										   [ <update_index_clauses> ]
										   [ <parallel_clause> ] ;
										   
<dependent_tables_clause>			::= "DEPENDENT" "TABLES" "(" skipBalanced("(",")") ")" ;

<update_index_clauses>				::= ( "UPDATE" | "INVALIDATE" ) "GLOBAL" "INDEXES" ;

<add_range_subpartition>				::= "ADD" (<range_subpartition_desc> ("," <range_subpartition_desc> )*)
														[ <dependent_tables_clause> ] [ <update_index_clauses> ] ;
														
<add_list_subpartition>				::= "ADD" (<list_subpartition_desc> ("," <list_subpartition_desc>)* )[ <dependent_tables_clause> ] [ <update_index_clauses> ] ;

<coalesce_table_subpartition>		::= "COALESCE" "PARTITION"  [ <update_index_clauses> ]  [ <parallel_clause> ]  [ <allow_disallow_clustering> ]	;	

<allow_disallow_clustering>			::= ( "ALLOW" | "DISALLOW" ) "CLUSTERING" ;	

<alter_mapping_table_clause>		::= "MAPPING" "TABLE"  ( <allocate_extent_clause> | <deallocate_unused_clause>) ;


<modify_hash_partition>				::= "MODIFY" <name>
										   ( <partition_attributes>
											  | <coalesce_table_subpartition>
											  | <alter_mapping_table_clause>
											  | ([ "REBUILD" ] "UNUSABLE" "LOCAL" "NDEXES")
											  | <read_only_clause>
											  | <indexing_clause>
										  ) ;
										  
<modify_list_partition>				::= "MODIFY" <name>
									  ( <partition_attributes>
									  | (( "ADD" | "DROP" ) "VALUES" "(" skipBalanced("(",")") ")")
									  | ( <add_range_subpartition>
										| <add_list_subpartition>
										| <add_hash_subpartition>
										)
									  | <coalesce_table_subpartition>
									  | ([ "REBUILD" ] "UNUSABLE" "LOCAL" "INDEXES")
									  | <read_only_clause>
									  | <indexing_clause>
									  ) ;
									  
<modify_table_subpartition>			::= "MODIFY" <name>
											( <allocate_extent_clause>
												| <deallocate_unused_clause>
												| <shrink_clause>
												| ( ((( "LOB" "("skipBalanced("(",")") ")") | ("VARRAY" <IDENTIFIER>) ) "(" skipBalanced("(",")")")")* )
												| ([ "REBUILD" ] "UNUSABLE" "LOCAL" "INDEXES")
												| ( "ADD" | "DROP") "VALUES" "(" skipBalanced("(",")") ")"
												| <read_only_clause>
												| <indexing_clause>
											) ;
											

											
<move_table_partition>				::= "MOVE" <name>
										[<indexing_clause>]
										[<partitioning_storage_clause>]
									   [ "MAPPING" "TABLE" ]
									   [ <table_partition_description> ]
									   [ <filter_condition>]
									   [ <update_index_clauses> ]
									   [ <parallel_clause> ]
									   [ <allow_disallow_clustering> ]
									   [ "ONLINE" ] ;
									   
									   
<move_table_subpartition>			::=  "MOVE" <name> [ <indexing_clause> ]
										 [ <partitioning_storage_clause> ]
										 [ <update_index_clauses> ]
										 [ <filter_condition> ]
										 [ <parallel_clause> ]
										 [ <allow_disallow_clustering> ]
										 [ "ONLINE" ] ;
												
<filter_condition>			::= "INCLUDING" "ROWS" <IDENTIFIER> ;

<add_external_partition_attrs>	::= "ADD" "EXTERNAL" "PARTITION" "ATTRIBUTES" <external_table_clause>  [ "REJECT" "LIMIT" ] ;


<add_table_partition>			::= "ADD"( (
										(("PARTITION" [ <partition> ] (<add_range_partition_clause>|<add_list_partition_clause>|[<add_system_partition_clause>]))
										  ("," "PARTITION" [ <partition> ] (<add_range_partition_clause>|<add_list_partition_clause>|[<add_system_partition_clause>]))*) 
										  [ "BEFORE" ( <IDENTIFIER> | <NUMBER> ) ])
										| ("PARTITION" [ <partition> ] <add_hash_partition_clause>)
										) [ <dependent_tables_clause> ] ;
										
<add_range_partition_clause>	::= (<range_values_clause>
										[ <table_partition_description> ]
										[ <external_part_subpart_data_props> ]
										[ ( ( "(" skipBalanced("(",")") ")")| <hash_subparts_by_quantity> ) ]
										[ <update_index_clauses> ]) ;

<add_hash_partition_clause>		::= <partitioning_storage_clause>
											[ <update_index_clauses> ]
											[ <parallel_clause> ]
											[ <read_only_clause>]
											[ <indexing_clause> ] ;		

<add_system_partition_clause>	::= (<table_partition_description>[<update_index_clauses>]) ;	


<add_list_partition_clause>		::=	(<list_values_clause>
										[ <table_partition_description> ]
										[ <external_part_subpart_data_props> ]
										[ ( ("(" skipBalanced("(",")")	")") | <hash_subparts_by_quantity> )]
										[ <update_index_clauses> ]	) ;			
										
										
<coalesce_table_partition>		::= "COALESCE" "SUBPARTITION" <name>
									  [<update_index_clauses>]
									  [<parallel_clause>]
									  [<allow_disallow_clustering>] ;
									  
<drop_table_partition>			::= "DROP" <partition_extended_names>   [ <update_index_clauses> [ <parallel_clause> ] ]   ;
  
<partition_extended_names>		::= (( "PARTITION" | "PARTITIONS" )|( "SUBPARTITION" | "SUBPARTITIONS" ))
									((<name> | ( "FOR" "(" skipBalanced("(",")") ")" )) (","(<name> | ( "FOR" "(" skipBalanced("(",")") ")" ))  )*) ;

<rename_partition_subpart>		::= "RENAME"  <partition_extended_names>    "TO" <name> ;

<truncate_partition_subpart>	::= "TRUNCATE"  <partition_extended_names>   [ (( "DROP" [ "ALL" ]) | "REUSE" ) "STORAGE" ]
									[ <update_index_clauses> [ <parallel_clause> ] ] [ "CASCADE" ] ;
									
<split_table_partition>			::= "SPLIT" <partition_extended_names>
											  ( ("AT" "("skipBalanced("(",")") ")"
												[ "INTO" "(" skipBalanced("(",")") ")" ])
											  |( "VALUES" "(" <list_values> ")"
												[ "INTO" "(" skipBalanced("(",")") ")" ])
											  | ("INTO" "(" skipBalanced("(",")") ")")
											  ) [ <split_nested_table_parts> ]
												[ <filter_condition> ]
												[ <dependent_tables_clause> ]
												[ <update_index_clauses> ]
												[ <parallel_clause> ]
												[ <allow_disallow_clustering> ]
												[ "ONLINE" ] ;
												
<merge_table_partitions>				::= "MERGE" "PARTITIONS" <partition_or_key_value>
											   ((( "," <partition_or_key_value>)*) 
											   | ("TO" <partition_or_key_value> ))
											   [ "INTO" <partition_spec> ]
											   [ <filter_condition> ]
											   [ <dependent_tables_clause> ]
											   [ <update_index_clauses> ]
											   [ <parallel_clause> ]
											   [ <allow_disallow_clustering> ] ;

<partition_or_key_value>				::= (<name>|"FOR" "(" skipBalanced("(",")") ")" );

<partition_spec>						::= "PARTITION" [ <partition> ] [ <table_partition_description> ] ;

<merge_table_subpartitions>				::= "MERGE" "SUBPARTITIONS" <partition_or_key_value>
										   ((( "," <partition_or_key_value>)*) 
											   | ("TO" <partition_or_key_value> ))
										   [ "INTO" ( <range_subpartition_desc>
												  | <list_subpartition_desc>
												  ) ]
										   [ <filter_condition> ]
										   [ <dependent_tables_clause> ]
										   [ <update_index_clauses> ]
										   [ <parallel_clause> ]
										   [ <allow_disallow_clustering> ] ;
										   

<exchange_partition_subpart>			::= "EXCHANGE" <partition_extended_names>
												   "WITH" "TABLE" [ (<schema>|<StringValue>)"." ] <table_or_string>
												   [ ( "INCLUDING" | "EXCLUDING" ) "INDEXES" ]
												   [ ( "WITH" | "WITHOUT" ) "VALIDATION" ]
												   [ <exceptions_clause> ]
												   [ <update_index_clauses> [ <parallel_clause> ] ]
												   [ "CASCADE" ] ;
												   
												   
<alter_iot_clauses>						::= ( <index_org_table_clause>
												| <alter_overflow_clause>
												| "COALESCE"
											) ;
											
<alter_mv_refresh>						::= "REFRESH"   ( ( "FAST" | "COMPLETE" | "FORCE" )
															   | ("ON" ( "DEMAND" | "COMMIT" ))
															   | ((( "START" "WITH") | "NEXT" ) ["TRUNC"] ["("]<date>[")"] [("+" <NUMBER>"/" <NUMBER>)])
															   | ("WITH" "PRIMARY" "KEY")
															   | ("USING"
																	(( "DEFAULT" "MASTER" "ROLLBACK" "SEGMENT")
																	| ("MASTER" "ROLLBACK" "SEGMENT" <rollback_segment>)
																	)
																)
															   | ("USING" ( "ENFORCED" | "TRUSTED" ) "CONSTRAINTS")
															   )* ;

<alter_query_rewrite_clause>			::= ("ENABLE" | "DISABLE" ) "QUERY" "REWRITE"[ <unusable_editions_clause> ] ;

<split_nested_table_parts>				::= <split_nested_table_part>[<split_nested_table_part>] ;

//Vis_26112026_[261101071]_Fixed NESTED TABLE keyword literals
<split_nested_table_part>				::= "NESTED" "TABLE" <column_or_string> "INTO"  "(" skipBalanced("(",")") ")"  ;


//Vis_26112026_[261101084]_Added IF EXISTS to ALTER MATERIALIZED VIEW LOG
<alter_materialized_view_log>			::= "ALTER" "MATERIALIZED" "VIEW" "LOG" ["IF" "EXISTS"] [ "FORCE" ]
											  "ON" [ (<schema>|<StringValue>) "." ]<table_or_string>
											  [( <physical_attributes_clause>
											  | <alter_table_partitioning>
											  | <parallel_clause>
											  | <logging_clause>
											  | <allocate_extent_clause>
											  | <shrink_clause>
											  | <move_mv_log_clause>
											  | ( "CACHE" | "NOCACHE" )
											  )
											  ] [ <mv_log_augmentation> ] [  <mv_log_purge_clause> ] [ <for_refresh_clause> ] [";"] ;
											  
											  
											  


<move_mv_log_clause>					::= "MOVE" <segment_attributes_clause> [<parallel_clause>] ;


<mv_log_augmentation>					::= "ADD" (( [ ("OBJECT" "ID")| ("PRIMARY" "KEY") | "ROWID"  | "SEQUENCE" ]  ["("<column_or_string> ("," <column_or_string> )* ")" ])
													| (","( [ ("OBJECT" "ID")| ("PRIMARY" "KEY") | "ROWID"  | "SEQUENCE" ]  ["("<column_or_string> ("," <column_or_string> )* ")" ]))* ) 
											[ <new_values_clause> ] ;
											
//Vis_26112026_[261101084]_Added IF EXISTS to ALTER MATERIALIZED ZONEMAP
<alter_materialized_zonemap>			::= "ALTER" "MATERIALIZED" "ZONEMAP" ["IF" "EXISTS"] [ (<schema>|<StringValue>) "." ] <name>
											  ( <alter_zonemap_attributes>
												  | <zonemap_refresh_clause>
												  | (( "ENABLE" | "DISABLE" ) "PRUNING")
												  | "COMPILE"
												  | "REBUILD"
												  | "UNUSABLE"
											  )*[";"] ;
											  
											  
<alter_zonemap_attributes>				::=( ("PCTFREE" <NUMBER>)| ("PCTUSED" <NUMBER>)| ( "CACHE" | "NOCACHE" )) ;

<zonemap_refresh_clause>				::= "REFRESH"[ "FAST" | "COMPLETE" | "FORCE" ][ "ON" ( "DEMAND" | "COMMIT" | "LOAD" | ("DATA" "MOVEMENT") | ("LOAD" "DATA" "MOVEMENT" )) ] ;


//Vis_26112026_[261101084]_Added IF EXISTS to ALTER OPERATOR
<alter_operator>						::= "ALTER" "OPERATOR" ["IF" "EXISTS"] [(<schema>|<StringValue>)"." ] <name>
												  ( <add_binding_clause>
													  | <drop_binding_clause>
													  | "COMPILE"
												  ) [";"] ;
												  
<add_binding_clause>					::= "ADD" "BINDING" "(" skipBalanced("(",")") ")" 
												"RETURN" "(" skipBalanced("(",")") ")"
											  [ <implementation_clause> ]
											  <using_function_clause> ;
											  
											  
											  
<implementation_clause>					::=(( "ANCILLARY" "TO" (<primary_operator> "(" skipBalanced("(",")") ")" 
										("," <primary_operator> "(" skipBalanced("(",")") ")" )*) )
											| <context_clause>
											) ;
											
<context_clause>				::= [ "WITH" "INDEX" "CONTEXT" "," "SCAN" "CONTEXT" <implementation_type>
										 [ "COMPUTE" "ANCILLARY" "DATA" ]	]
										[ "WITH" "COLUMN" "CONTEXT" ] ;
										
<primary_operator>				::=<IDENTIFIER> ;

<using_function_clause>		::= "USING" [ (<schema>|<StringValue>)"." ] [<package>"."  ] <function_name> ;


<drop_binding_clause>			::= "DROP" "BINDING" "(" skipBalanced("(",")") ")"  [ "FORCE" ] ;


//Vis_26112026_[261101071]_Fixed RENAME TO and CHANGE CATEGORY TO written as single quoted literals
<alter_outline>					::= "ALTER" "OUTLINE" [ "PUBLIC" | "PRIVATE" ] <name>
												  ( "REBUILD"
												  | ("RENAME" "TO" <name>)
												  | ("CHANGE" "CATEGORY" "TO" <name>)
												  | ( "ENABLE" | "DISABLE" )
												  )*
												  [";"]	 ;

//Vis_26112026_[261101084]_Added IF EXISTS to ALTER PACKAGE
<alter_package>					::=	"ALTER" "PACKAGE" ["IF" "EXISTS"] [ (<schema>|<StringValue>)"." ] <name>( <package_compile_clause> | ( "EDITIONABLE" | "NONEDITIONABLE" ) ) [";"] ;	 


<package_compile_clause>		::=	"COMPILE" [ "DEBUG" ] [("PACKAGE"|"SPECIFICATION"|"BODY")] [ <compiler_parameters_clause>* ] [ "REUSE" "SETTINGS" ]		;							  
											
<alter_pluggable_database>		::= "ALTER" "PLUGGABLE" "DATABASE" 
										  ((  <application_clauses>
											  | <snapshot_clauses>
											  | <prepare_clause>
											  | <drop_mirror_copy>
											  | <lost_write_protection>
											  | <pdb_managed_recovery>
											  )
											  |
											  ([ <pdb_name> ](
											   <pdb_unplug_clause>
											  | <pdb_settings_clauses>
											  | <pdb_datafile_clause>
											  |	<pdb_recovery_clauses>
											  | <pdb_change_state>
											  | <pdb_change_state_from_root>))
										   )[";"] ;
										   
<pdb_unplug_clause>				::=  "UNPLUG" "INTO" <filename> [ <pdb_unplug_encrypt> ]  ;

<pdb_name>			::=<IDENTIFIER> ;

<pdb_unplug_encrypt>			::= "ENCRYPT" "USING" <StringValue> ;


//Vis_26112026_[261101071]_Fixed DEFAULT TARGET keyword literal split into separate tokens
<pdb_settings_clauses>		::= (	(   (( "DEFAULT" "EDITION" "=" <name>)
										  | ("SET" "DEFAULT" "(" ("BIGFILE" | "SMALLFILE") ")" "TABLESPACE")
										  | ("DEFAULT" "TABLESPACE" <tablespace>)
										  | ("DEFAULT" "TEMPORARY" "TABLESPACE"  <tablespace> )
										  | ("RENAME" "GLOBAL_NAME" "TO" <database_name>("."<domain> ("." <domain>)*))
										  | <set_time_zone_clause>
										  | <database_file_clauses>
										  | <supplemental_db_logging>
										  | <pdb_storage_clause>
										  | <pdb_logging_clauses>
										  | <pdb_refresh_mode_clause>
										  | <pdb_refresh_switchover_clause>
										  | ("REFRESH" [ <pdb_refresh_switchover_clause> ])
											| ("SET" "CONTAINER_MAP" "=" <StringValue>)
									  )
									)
									| ("CONTAINERS" (( "DEFAULT" "TARGET" "=" (( "("<name>")") | "NONE" ))
												 |( "HOST" "=" <StringValue>)
												 | ("PORT" "=" <NUMBER>)
												 ) 
										)
								);
												 
												 
												 
<database_name>				::=<IDENTIFIER> ;

<domain>					::=<IDENTIFIER> ;

<pdb_storage_clause>			::= "STORAGE"  ( "(" (( "MAXSIZE"|"MAX_AUDIT_SIZE"|"MAX_DIAG_SIZE") ( "UNLIMITED" | <size_clause> ) )*")"  | "UNLIMITED" ) ;

<pdb_logging_clauses>			::= (  <logging_clause> | <pdb_force_logging_clause> ) ;

<pdb_force_logging_clause>		::= (  (("ENABLE" | "DISABLE") "FORCE" ("LOGGING" | "NOLOGGING")  ) 
									| ("SET" "STANDBY" "NOLOGGING" "FOR" ("DATA" "AVAILABILITY" | "LOAD" "PERFORMANCE")) ) ;
									
<pdb_refresh_mode_clause>		::= "REFRESH" "MODE" ( "MANUAL"| ("EVERY" <NUMBER> ( "MINUTES"  | "HOURS" ) | "NONE" )) ;

<pdb_refresh_switchover_clause>	::=  "FROM" <name> "@" <dblink> "SWITCHOVER" ;

<dblink>						::=(<StringValue>|<IDENTIFIER>) ;

<pdb_datafile_clause>			::=  "DATAFILE"  ( "ALL"| ( ( <StringValue> | <NUMBER> ) ("," ( <StringValue> | <NUMBER> ))* )  )  ( "ONLINE" | "OFFLINE" ) ;

<pdb_recovery_clauses>			::=  ( <pdb_general_recovery> | (( "BEGIN" | "END" ) "BACKUP") | (( "ENABLE" | "DISABLE" ) "RECOVERY"  )) ;

<pdb_general_recovery>			::= "RECOVER" ["AUTOMATIC" ]  [ "FROM" <StringValue> ]  [ (("DATABASE"  |  ("TABLESPACE" <tablespace> ("," <tablespace>)* ))
									|  ("DATAFILE"( ( <StringValue> | <NUMBER> )   (","( <StringValue> | <NUMBER> ))* ) )
									| (("LOGFILE" <StringValue>) | ("CONTINUE" [ "DEFAULT" ])) )] ;
									
<pdb_change_state>				::= ( <pdb_open> | <pdb_close> | <pdb_save_or_discard_state> ) ;

<pdb_open>						::= "OPEN"
									  ( ("RESETLOGS")
									  |([(("READ" "WRITE") | ("READ" "ONLY" ))][ "UPGRADE"] [ "RESTRICTED" ] [ "FORCE" ])
									  )
									  [ <instances_clause> ]
									  [ <services_clause> ] ;
									  
<instances_clause>				::= "INSTANCES" "=" ( "(" skipBalanced("(",")") ")"  | "ALL" [ "EXCEPT" "(" skipBalanced("(",")") ")" ] ) ;

<services_clause>				::= "SERVICES" "=" ( "(" skipBalanced("(",")") ")"  | "ALL" [ "EXCEPT" "(" skipBalanced("(",")") ")" ] ) ;

<pdb_close>						::="(" skipBalanced("(",")") ")" ;

<pdb_save_or_discard_state>		::= ( "SAVE" | "DISCARD" ) "STATE" [ <instances_clause> ] ;

<pdb_change_state_from_root>	::= ( "ALL" [ "EXCEPT"(<pdb_name> ("," <pdb_name> )*) ]|( ("," <pdb_name> )*) )
										( <pdb_open> | <pdb_close> | <pdb_save_or_discard_state> ) ;
									
<application_clauses>			::= "APPLICATION"
									 (<name>
										( ("BEGIN" "INSTALL" <StringValue> [ "COMMENT" <StringValue> ])
											| ("END" "INSTALL" [ <StringValue> ])
											| ("BEGIN" "PATCH" <NUMBER> [ "MINIMUM" "VERSION" <StringValue> ] [ "COMMENT" <StringValue> ])
											| ("END" "PATCH" [ <NUMBER> ])
											| ("BEGIN" "UPGRADE" [<StringValue>] "TO" <StringValue> [ "COMMENT" <StringValue> ])
											| ("END" "UPGRADE" [ "TO" <StringValue> ])
											| ("BEGIN" "UNINSTALL")
											| ("END" "UNINSTALL")
											| ("SET" "PATCH" <NUMBER>)
											| ("SET" "VERSION" <StringValue>)
											| ("SET" "COMPATIBILITY" "VERSION" ( <StringValue> | "CURRENT" ))
											| ("SYNC" "TO"  ( <StringValue> | "PATCH" <NUMBER>)) 
										)
										| (("ALL"|<IDENTIFIER>)( skip("SYNC")"SYNC" ))  
										)
									     ;
									
<snapshot_clauses>				::= ( <pdb_snapshot_clause>  | <materialize_clause> | <create_snapshot_clause>  | <drop_snapshot_clause> | <set_max_pdb_snapshots_clause> ) ;


<pdb_snapshot_clause>			::=  "ENABLE" "SNAPSHOT" ( "MANUAL" | "EVERY" <NUMBER> ( "HOURS" | "MINUTES" ) "NONE" ) ;

<materialize_clause>			::=   "MATERIALIZE" ;

<create_snapshot_clause>		::=  "SNAPSHOT" <name> ;

<drop_snapshot_clause>			::= "DROP" "SNAPSHOT" <name> ;

<set_max_pdb_snapshots_clause>	::=  "SET" <NUMBER> "=" <NUMBER> ;

<pdb_managed_recovery>			::= "RECOVER" "MANAGED" "STANDBY" "DATABASE" [ "CANCEL" ] ;


<alter_pmem_filestore>			::= "ALTER" "PMEM" "FILESTORE"  <name>
											  ["("](( "MOUNT" [ ( "MOUNTPOINT" <StringValue> | "BACKINGFILE" <filename> )* ] [ "FORCE" ] )
											  | "DISMOUNT"
											  |(([ "RESIZE" <size_clause> ])  |  <autoextend_clause> ))
											  [")"] [";"] ;



//Vis_26112026_[261101084]_Added IF EXISTS to ALTER PROCEDURE
<alter_procedure>				::= "ALTER" "PROCEDURE" ["IF" "EXISTS"] [ (<schema>|<StringValue>) "." ] <procedure_name>( <procedure_compile_clause> | ( "EDITIONABLE" | "NONEDITIONABLE" ) ) [";"] ;


<procedure_compile_clause>		::= <function_compile_clause> ;


<alter_profile>					::= "ALTER" "PROFILE" <name>  "LIMIT"  ( <resource_parameters> | <password_parameters> )*  [ "CONTAINER" "=" ( "CURRENT" | "ALL" ) ] [";"] ;


<resource_parameters>			::= ( (( "SESSIONS_PER_USER"
											  | "CPU_PER_SESSION"
											  | "CPU_PER_CALL"
											  | "CONNECT_TIME"
											  | "IDLE_TIME"
											  | "LOGICAL_READS_PER_SESSION"
											  | "LOGICAL_READS_PER_CALL"
											  | "COMPOSITE_LIMIT"
											  )
											  (  "UNLIMITED" | "DEFAULT"|<NUMBER> ))
											| ("PRIVATE_SGA"
											  ( <size_clause> | "UNLIMITED" | "DEFAULT" ))
									) ;
									
<password_parameters>			::= (( ( "FAILED_LOGIN_ATTEMPTS"
										  | "PASSWORD_LIFE_TIME"
										  | "PASSWORD_REUSE_TIME"
										  | "PASSWORD_REUSE_MAX"
										  | "PASSWORD_LOCK_TIME"
										  | "PASSWORD_GRACE_TIME"
										  | "INACTIVE_ACCOUNT_TIME"
									  )
									  (   "UNLIMITED" | "DEFAULT"|<exprpar> ))
									| ("PASSWORD_VERIFY_FUNCTION"
									  (  "NULL" | "DEFAULT" |<function>))
									| ( "PASSWORD_ROLLOVER_TIME" ("DEFAULT"|<exprpar> ) )
									) ;
									
<exprpar>						::=((<NUMBER>|<DELIMITER>)*|<StringValue>|<IDENTIFIER>) ;

<alter_resource_cost>			::= "ALTER" "RESOURCE" "COST"
									  ( ( "CPU_PER_SESSION"
										| "CONNECT_TIME"
										| "LOGICAL_READS_PER_SESSION"
										| "PRIVATE_SGA"
										) <NUMBER>
									  )*  [";"] ;
									  

//Vis_26112026_[261101084]_Added IF EXISTS to ALTER ROLE
<alter_role>					::= "ALTER" "ROLE" <name> ["IF" "EXISTS"] (
										( ("NOT" "IDENTIFIED")
											| ("IDENTIFIED" ( ("BY" <password>)
															| ("USING" [ (<schema>|<StringValue>)"." ] <package>)
															| "EXTERNALLY"
															| ("GLOBALLY" "AS" <name> )) ))
									  [ "CONTAINER" "=" ( "CURRENT" | "ALL" ) ] ) [";"] ;
									  
<alter_rollback_segment>		::= "ALTER" "ROLLBACK" "SEGMENT" <name> ( "ONLINE"  | "OFFLINE"  | <storage_clause>  | ("SHRINK" [ "TO" <size_clause> ]))  [";"] ;									  


//Vis_26112026_[261101084]_Added IF EXISTS to ALTER SEQUENCE
<alter_sequence>				::= "ALTER" "SEQUENCE" ["IF" "EXISTS"] [ (<schema>|<StringValue>) "." ]<sequence>
										  ( ("INCREMENT" "BY" <NUMBER>)
											  | (("MAXVALUE" <NUMBER> )| "NOMAXVALUE" )
											  | (( "MINVALUE" <NUMBER>) | "NOMINVALUE" )
											  |  "RESTART" 
											  | ( "CYCLE" | "NOCYCLE" )
											  | ( ("CACHE" <NUMBER> )| "NOCACHE" )
											  | ( "ORDER" | "NOORDER" )
											  | ("KEEP"| "NOKEEP" )
											  | ( ("SCALE" ("EXTEND" | "NOEXTEND") )| "NOSCALE" )
											  | ( ("SHARD" ("EXTEND" | "NOEXTEND") )| "NOSHARD" )
											  | ( "SESSION" | "GLOBAL" )
										  ) *
										[";"] ;
										
<alter_session>					::= "ALTER" "SESSION"  ( ("ADVISE" ( "COMMIT" | "ROLLBACK" | "NOTHING" ))
														  | ("CLOSE" "DATABASE" "LINK" <dblink>)
														  | (( "ENABLE" | "DISABLE" ) "COMMIT" "IN" "PROCEDURE")
														  | (( "ENABLE" | "DISABLE" ) "GUARD")
														  | (( "ENABLE" | "DISABLE" | "FORCE" ) "PARALLEL"
															( "DML" | "DDL" | "QUERY" ) [ "PARALLEL" <NUMBER> ])
														  | ( ("ENABLE" "RESUMABLE" [ "TIMEOUT" <NUMBER> ] [ "NAME" <StringValue> ])
															| ("DISABLE" "RESUMABLE")
															)
														  | (( "ENABLE" | "DISABLE" ) "SHARD" "DDL")
														  | ("SYNC" "WITH" "PRIMARY")
														  | <alter_session_set_clause>
														) [";"]  ;

<alter_session_set_clause>			::= "SET" ( ( "EDITION" "=" <name>)
													|( "CONTAINER" "=" <name> [ "SERVICE" "="  <name> ])
													| ("ROW" "ARCHIVAL" "VISIBILITY" "=" ( "ACTIVE" | "ALL" ))
													| ("DEFAULT" "COLLATION" "=" ( <name> | "NONE" ))
													|( <parameter_name> "=" <parameter_value> )*
												) ;
												
//Vis_26112026_[261101084]_Added IF EXISTS to ALTER SYNONYM
<alter_synonym>						::= "ALTER" [ "PUBLIC" ] "SYNONYM" ["IF" "EXISTS"] [ (<schema>|<StringValue>) "." ] <name>  ( "EDITIONABLE" | "NONEDITIONABLE" | "COMPILE" ) [";"] ;

//Vis_26112026_[261101071]_Fixed CONFIRM APPLY keyword literal split into separate tokens
<alter_system>						::= "ALTER" "SYSTEM" ( <archive_log_clause>
													  | <checkpoint_clause>
													  | <check_datafiles_clause>
													  | <distributed_recov_clauses>
													  | ("FLUSH" ( "SHARED_POOL" | ("GLOBAL" "CONTEXT") | "BUFFER_CACHE" | "FLASH_CACHE"         
																	| ("REDO" "TO" <name> [ [ "NO" ] "CONFIRM" "APPLY" ] )))
													  | <end_session_clauses>
													  | ("SWITCH" "LOGFILE")
													  | ( "SUSPEND" | "RESUME" )
													  | <quiesce_clauses>
													  | <rolling_migration_clauses>
													  | <rolling_patch_clauses>
													  | <security_clauses>
													  | <affinity_clauses>
													  | <shutdown_dispatcher_clause>
													  | "REGISTER"
													  | ("SET" <alter_system_set_clause>*)
													  | ("RESET" <alter_system_reset_clause>*)
													  | ("RELOCATE" "CLIENT" <StringValue>)
													  | (<cancel_sql_clause>)
													  | ("FLUSH" "PASSWORDFILE_METADATA_CACHE")
													 ) [";"] ;
													 
<archive_log_clause>			::= "ARCHIVE" "LOG" [  "INSTANCE" <StringValue> ]
													   ( ( ("SEQUENCE" <NUMBER>)
														 | ("CHANGE" <NUMBER>)
														 | ("CURRENT" [ "NOSWITCH" ])
														 |("GROUP" <NUMBER>)
														 |( "LOGFILE" <filename>  [ "USING" "BACKUP" "CONTROLFILE" ])
														 | "NEXT"
														 | "ALL"
														 )
														 [ "TO"<StringValue> ]
													   ) ;
													   
													   
<checkpoint_clause>				::= "CHECKPOINT" [ "GLOBAL" | "LOCAL" ] ;

<check_datafiles_clause>		::= "CHECK" "DATAFILES" [ "GLOBAL" | "LOCAL" ] ;

<distributed_recov_clauses>		::= ( "ENABLE"| "DISABLE" ) "DISTRIBUTED" "RECOVERY" ;

<end_session_clauses>			::= ( ("DISCONNECT" "SESSION" <StringValue>[ "POST_TRANSACTION" ])| ("KILL" "SESSION" <StringValue>))[ "IMMEDIATE" | "NOREPLAY" ] ;

<quiesce_clauses>				::= (("QUIESCE" "RESTRICTED") | "UNQUIESCE") ;

<rolling_migration_clauses>		::=(( "START" "ROLLING" "MIGRATION" "TO" <StringValue>)|( "STOP" "ROLLING" "MIGRATION") );

//Vis_26112026_[261101071]_Fixed START|STOP literal split into a START/STOP choice
<rolling_patch_clauses>			::= (("START"|"STOP") "ROLLING" "PATCH");

<security_clauses>				::= ( (( "ENABLE" | "DISABLE" ) "RESTRICTED" "SESSION")
									  | ( "SET" "ENCRYPTION" "WALLET" ("OPEN"|"CLOSE")
										["IDENTIFIED" "BY" ( <StringValue>  )])
									  | <set_encryption_key>
									) ;
									
									
<set_encryption_key>			::=  ("SET" "ENCRYPTION" "KEY" ( [ <StringValue> ] "IDENTIFIED" "BY" <StringValue>  [ "MIGRATE" "USING" <StringValue> ]  )) ;


<affinity_clauses>				::= (( "ENABLE"|"DISABLE") "AFFINITY" [ (<schema>|<StringValue>) "."]<table_or_string> ["SERVICE" <name> ]) ;
 
<shutdown_dispatcher_clause>	::= "SHUTDOWN" [ "IMMEDIATE" ] <name> ;

<alter_system_set_clause>		::= ( <set_parameter_clause>| ("USE_STORED_OUTLINES" "=" "(" "TRUE" | "FALSE" | <name>")" )| ("GLOBAL_TOPIC_ENABLED" "=" "(" "TRUE" | "FALSE"")")) ;

<set_parameter_clause>			::= <parameter_name> "="   (<parameter_value> ("," <parameter_value>)*) 
														   [ "COMMENT" "=" <StringValue> ]
														   [ "DEFERRED" ]
														   [ "CONTAINER" "=" ( "CURRENT" | "ALL" ) ]
														   [ (( "SCOPE" "=" ( "MEMORY" | "SPFILE" | "BOTH" ))
															 | "SID" "=" ( <StringValue>| "*" )
															)* ] ;
 
<alter_system_reset_clause>		::= <parameter_name> [ (( "SCOPE" "=" ( "MEMORY" | "SPFILE" | "BOTH" ))| "SID" "=" ( <StringValue>| "*" ))* ] ;

<cancel_sql_clause>				::=  "CANCEL" "SQL" <StringValue> ;



//Vis_26112026_[261101084]_Added IF EXISTS to ALTER TABLE
<alter_table>					::=  mapRight("ALTER" "TABLE" ["IF" "EXISTS"] [ (<schema>|<StringValue>)"." ] node("OWNER", ((attribute("NAME",  <table> ))|<StringAsName>) ),
												  [ <memoptimize_read_clause> ]
												  [ ( <modify_opaque_type>
												  | <constraint_clauses>
												  | <column_clauses>
												  | <alter_table_partitioning>
												  | <alter_external_table>
												  | <move_table_clause>
												  | <modify_to_partitioned>
												  | <immutable_table_clauses>
												  | <blockchain_table_clauses>
												  |<alter_table_properties>)
												  ]
												  [ (<enable_disable_clause>
													| (( "ENABLE" | "DISABLE" )
													( ("TABLE" "LOCK") | ("ALL" "TRIGGERS") | ("CONTAINER_MAP") | ("CONTAINERS_DEFAULT" ))))*
												  ] )
												  [";"] ;
												  
												  
<memoptimize_read_clause>		::= [ ["NO"]"MEMOPTIMIZE" "FOR"( "READ"|"WRITE") ] ;

<alter_table_properties>		::= ( (( ( <physical_attributes_clause>
											| <logging_clause>
											| <table_compression>
											| <ilm_clause>
											| <supplemental_table_logging>
											| <allocate_extent_clause>
											| <deallocate_unused_clause>
											| ( "CACHE" | "NOCACHE" )
											| <result_cache_clause>
											| <upgrade_table_clause>
											| <records_per_block_clause>
											| <parallel_clause>
											| <row_movement_clause>
											| <logical_replication_clause> 
											| <flashback_archive_clause>
										)*
										|<inmemory_table_clause>
										  | ("RENAME" "TO" <table_or_string>)
									 ) [<alter_iot_clauses> ] [ <alter_XMLSchema_clause> ])
										| ( <shrink_clause >
											  | ("READ" "ONLY")
											  | ("READ" "WRITE")
											  | ("REKEY" <encryption_spec>)
											  | ("DEFAULT" "COLLATION" <name>)
											  | ("ADD" <attribute_clustering_clause>)
											  | ("MODIFY" "CLUSTERING" [ <clustering_when> ] [ <zonemap_clause> ])
											  | ("DROP" "CLUSTERING")
											  | (["NO"] "ROW" "ARCHIVAL")
										  )
									) ;
									

									
									
<supplemental_table_logging>		::= ( ("ADD" ( <add_supplimental_log>(","<add_supplimental_log>)*) )
										| "DROP" (<drop_supplimental_log>(","<drop_supplimental_log>)*) ) ;
										  

<add_supplimental_log>		 ::= "SUPPLEMENTAL" "LOG"( <supplemental_log_grp_clause> | <supplemental_id_key_clause> ) ;

<drop_supplimental_log>		::="SUPPLEMENTAL" "LOG"( <supplemental_id_key_clause> | ("GROUP" <log_group>) ) ;


<records_per_block_clause>		::= ( "MINIMIZE" | "NOMINIMIZE" ) "RECORDS_PER_BLOCK" ;

<alter_XMLSchema_clause>		::= (( "ALLOW" "ANYSCHEMA")  | ("ALLOW" "NONSCHEMA") | ("DISALLOW" "NONSCHEMA")) ;


<alter_external_table>			::=( ( <add_column_clause>
										| <drop_column_clause>
										| <parallel_clause>
										
										| ("REJECT" "LIMIT" ( <NUMBER> | "UNLIMITED" ))
										| ( "PROJECT" "COLUMN" ( "ALL" | "REFERENCED" ))
										| <modify_column_clauses>										
									)*
									| <external_table_data_props>) ;
									  
									  
<add_column_clause>				::= "ADD" ( ( <alter_column_definition> | <alter_virtual_column_definition> )  
											| ("(" (( <alter_column_definition> | <alter_virtual_column_definition> )
												("," ( <alter_column_definition> | <alter_virtual_column_definition> ))*) ")"))
												[ <column_properties> ]  [ "("skipBalanced("(",")") ")" ]  ;
												
<alter_column_definition>		::= <column_or_string> 
									[ <column_type> [ "COLLATE" <column_collation_name> ] ]
									[ "SORT"  ] 
									[ ("VISIBLE" )
										| ("INVISIBLE") 
									]
									[ <column_initialization>]
									[ "ENCRYPT"  <encryption_spec> ]  
									[([ "NOT"  "NULL"])]
									
									[ ( <inline_constraint_node>	) 
									| ( node("Inline Reference Constraint" , attribute("VALUE" , <inline_ref_constraint> )))]
								;
												
<alter_virtual_column_definition>	::=	 <column_or_string>
									[ <column_type> [ "COLLATE"  <column_collation_name>] ]
									[ ("VISIBLE" ) 
										| ("INVISIBLE" ) 
									]
									[ "GENERATED" "ALWAYS"  ]
									"AS" "(" <column_expression> ")" 
									[ "VIRTUAL" ]
									 [ <evaluation_edition_clause> ]
									 [ <unusable_editions_clause> ]
									 [([ "NOT" ] "NULL")]
									 [<inline_constraint_node>]
									
								;					
												
												
<modify_column_clauses>			::= "MODIFY"(( "(" skipBalanced("(",")")")")
											| <modify_col_substitutable>
											) ;											
												
												
												
<modify_col_substitutable>			::="COLUMN" <column_or_string>[ "NOT" ] "SUBSTITUTABLE" "AT" "ALL" "LEVELS"[ "FORCE" ] ;
									   
<drop_column_clause>			::= ( ("SET" "UNUSED" ( ("COLUMN" <column_or_string>)
															 | ("(" <column_or_string> ("," <column_or_string> )*")"))
												  [ ( ("CASCADE" "CONSTRAINTS") | "INVALIDATE")* ]
												  [ "ONLINE" ])
												|( "DROP" ( ("COLUMN" <column_or_string>)
															 | ("(" <column_or_string> ("," <column_or_string> )*")"))
												  [ ( ("CASCADE" "CONSTRAINTS") | "INVALIDATE")* ]
												  [ "CHECKPOINT" [ <NUMBER> ] ])
												| ("DROP" ( ("UNUSED" "COLUMNS")
													   | ("COLUMNS" "CONTINUE")
													   )
												  [ "CHECKPOINT" [ <NUMBER> ] ])
												) ;
												
<modify_to_partitioned>					::= "MODIFY" [ (<table_partitioning_clauses> | "NONPARTITIONED") ]
												  [ <filter_condition> ]
												  [ "ONLINE" ]
												  [ "UPDATE" "INDEXES" [ "(" skipBalanced( "(",")" ) ")"   ] ]		;	


<move_table_clause>						::= "MOVE" [ <filter_condition> ]
												   [ "ONLINE" ]
												   [ <segment_attributes_clause> ]
												   [ <table_compression> ]
												   [ <index_org_table_clause> ]
												   [ ( <LOB_storage_clause> | <varray_col_properties> )* ]
												   [ <parallel_clause> ]
												   [ <allow_disallow_clustering> ]
												   [ "UPDATE" "INDEXES"	 [ "(" skipBalanced( "(",")" ) ")" ] ]		 ;		

<modify_opaque_type>					::= "MODIFY" "OPAQUE" "TYPE" <column_or_string> "STORE" "(" skipBalanced( "(",")" ) ")" "UNPACKED"	 ;


<column_clauses>						::=		 ( 	<rename_column_clause>
													| <modify_collection_retrieval>
													| <modify_LOB_storage_clause> 
													| <alter_varray_col_properties>
													|( <add_column_clause>
													  | <drop_column_clause>
													  | <add_period_clause>
													  | <drop_period_clause>
													  |<modify_column_clauses>
													  )
													)*		;
													
													
<rename_column_clause>					::=	"RENAME" "COLUMN" <name> "TO" <name>	 ;

<modify_collection_retrieval>			::=	"MODIFY" "NESTED" "TABLE" <IDENTIFIER> "RETURN" "AS" ( "LOCATOR" | "VALUE" ) ;		

<alter_varray_col_properties>			::= "MODIFY" "VARRAY" <IDENTIFIER>   "(" skipBalanced("(",")") ")"	 ;	


<add_period_clause>						::=	 "ADD" "(" skipBalanced("(",")") ")" ;	

<drop_period_clause>					::=	"DROP" "(" skipBalanced("(",")") ")";					
													
													
<constraint_clauses>					::= (("ADD"  ( <out_of_line_REFer_constraint>|(<foreign_key>|<out_of_line_constraint>)  ))
												| ("MODIFY" ( "CONSTRAINT" <constraint_name>
															 | "PRIMARY" "KEY"
															 | "UNIQUE" "("<column_or_string> ("," <column_or_string>)*")"
															 ) <constraint_state> [ "CASCADE" ])
														| ("RENAME" "CONSTRAINT" <name> "TO"<name>)
														| ( <drop_constraint_clause> )
													) ;
													
													
<out_of_line_REFer_constraint>			::=( ("SCOPE" "FOR" "("  (<ref_col> | <ref_attr>) ")"
											"IS" [ (<schema>|<StringValue>) "." ] <scope_table>)										
										| ("REF" "("  (<ref_col> | <ref_attr>) ")" "WITH" "ROWID")	) ;												
													
<drop_constraint_clause>				::= ( "DROP" ( ( ("PRIMARY" "KEY") | ("UNIQUE" "(" <column_or_string>* ")") ) | ("CONSTRAINT" <constraint_name>) )
														[ "CASCADE" ] [( "KEEP" | "DROP" ) "INDEX" ]     [ "ONLINE" ]) ;
													
												
<upgrade_table_clause>					::= "UPGRADE" [ ["NOT" ] "INCLUDING" "DATA" ]   [ <column_properties> ]		;				
												
												
//Vis_26112026_[261101084]_Added IF EXISTS to ALTER TABLESPACE
<alter_tablespace>						::= "ALTER" "TABLESPACE" ["IF" "EXISTS"] <tablespace> <alter_tablespace_attrs> [";"] ;

<alter_tablespace_attrs>				::= ( <default_tablespace_params>
												| ("MINIMUM" "EXTENT" <size_clause>)
												| ("RESIZE" <size_clause>)
												| "COALESCE"
												| ("SHRINK" "SPACE" [ "KEEP" <size_clause> ])
												| ("RENAME" "TO" <name>)
												| (( "BEGIN" | "END" ) "BACKUP")
												| <datafile_tempfile_clauses>
												| <tablespace_logging_clauses>
												| <tablespace_group_clause>
												| <tablespace_state_clauses>
												| <autoextend_clause>
												| <flashback_mode_clause>
												| <tablespace_retention_clause>
												| <alter_tablespace_encryption>
												|<lost_write_protection>
											) ;
											
											
<default_tablespace_params>				::=	"DEFAULT" [ <default_table_compression> ] [ <default_index_compression> ]
													[ <inmemory_clause> ] [ <ilm_clause> ] [ <storage_clause> ]		;	
													
<default_table_compression>				::= "TABLE" ( ("COMPRESS" "FOR" "OLTP")     
														  | ("COMPRESS" "FOR" "QUERY" ( "LOW" | "HIGH" ))
														  |( "COMPRESS" "FOR" "ARCHIVE" ( "LOW" | "HIGH" ))
														  | "NOCOMPRESS"
														  ) ;
<default_index_compression>				::= "INDEX"( ( "COMPRESS" "ADVANCED" ( "LOW" | "HIGH"))      | "NOCOMPRESS" ) ;

<datafile_tempfile_clauses>				::=(( "ADD" ( "DATAFILE" | "TEMPFILE" )
											   [ (<file_specification> ("," <file_specification> )*) ])
											|( "DROP" ("DATAFILE" | "TEMPFILE" ) ( <StringValue> | <NUMBER> ))
											| ("SHRINK" "TEMPFILE" ( <StringValue> | <NUMBER> ) ["KEEP" <size_clause>])
											| ("RENAME" "DATAFILE"( <StringValue> ("," <StringValue>)*)
												"TO" ( <StringValue> ("," <StringValue>)*) )
											| (("DATAFILE" | "TEMPFILE" ) ( "ONLINE" | "OFFLINE" ))
											) ;
											
<tablespace_logging_clauses>			::= ( <logging_clause>| ("NO" "FORCE" "LOGGING") |("FORCE" "LOGGING"));

<tablespace_state_clauses>				::= ( ( "ONLINE"  | ("OFFLINE" [ "NORMAL" | "TEMPORARY" | "IMMEDIATE" ] ) )
											  | ("READ" ( "ONLY" | "WRITE" ))
											  | ( "PERMANENT" | "TEMPORARY" )
											) ;
											
<tablespace_group_clause>				::= "TABLESPACE" "GROUP" ( <name> | <StringValue> ) ;


<tablespace_retention_clause>			::= "RETENTION" ( "GUARANTEE" | "NOGUARANTEE" ) ;

<alter_tablespace_encryption>			::= "ENCRYPTION" ( ( "OFFLINE" ( "DECRYPT"|[ <tablespace_encryption_spec> ] "ENCRYPT"   ) )
												  |( "ONLINE" ( "DECRYPT" 
															|([<tablespace_encryption_spec> ]( "ENCRYPT" | "REKEY" )))
																[ <ts_file_name_convert> ] )
												  | ( "FINISH" ( "ENCRYPT" | "REKEY" | "DECRYPT" ) [ <ts_file_name_convert> ] )
												  ) ;
												  
												  
<tablespace_encryption_spec>			::= "USING" <StringValue> ;

<ts_file_name_convert>					::= "FILE_NAME_CONVERT" "=" "("  skipBalanced("(",")")")"  [ "KEEP" ] ;


<alter_tablespace_set>					::= "ALTER" "TABLESPACE" "SET" <tablespace> <alter_tablespace_attrs> [";"] ;

//Vis_26112026_[261101084]_Added IF EXISTS to ALTER TRIGGER
<alter_trigger>							::= "ALTER" "TRIGGER" ["IF" "EXISTS"][ (<schema>|<StringValue>) "." ] (<trigger_name>|<StringValue>)
											  ( <trigger_compile_clause>
												  | ( "ENABLE" | "DISABLE" )
												  | ("RENAME" "TO" <name>)
												  | ( "EDITIONABLE" | "NONEDITIONABLE" )
											  ) [";"] ;
											  
<trigger_compile_clause>				::= <function_compile_clause> ;

//Vis_26112026_[261101084]_Added IF EXISTS to ALTER TYPE
<alter_type>							::= "ALTER" "TYPE" ["IF" "EXISTS"] [ (<schema>|<StringValue>) "." ] <name>(  ( "EDITIONABLE" | "NONEDITIONABLE" )|<alter_type_clause>  ) [";"];

<alter_type_clause>						::= ( <type_compile_clause>
												| <type_replace_clause>
												| "RESET" 
												|( ( <alter_method_specs>
												  | <alter_attribute_definition>
												  | <alter_collection_clauses>
												  ) [ <dependent_handling_clause> ])
												|([ "NOT" ] ( "INSTANTIABLE" | "FINAL" ))
												) ;

<type_compile_clause>					::= <function_compile_clause> ;

<type_replace_clause>					::= "REPLACE"[ (<invoker_rights_clause> | <accessible_by_clause> )] "AS" "OBJECT"  "(" skipBalanced("(",")") ")" ;

<alter_method_specs>					::=(<alter_method_spec>(","<alter_method_spec>)*) ;

<alter_method_spec>						::= (( "ADD" | "DROP" ) ( <map_order_function_spec> | <subprogram_spec> )) ;

<alter_attribute_definition>			::= (( ( "ADD" | "MODIFY" ) "ATTRIBUTE"     ( (<attributes> [ <uneffected_datatype> ] )|("(" <attributes> <uneffected_datatype> ("," <attributes> <uneffected_datatype>)*  ")" )))
											|( "DROP" "ATTRIBUTE"( <attributes>	 | "(" (<attributes> ("," <attributes>)*) ")" ) )) ;
											
<alter_collection_clauses>				::= "MODIFY" (( "LIMIT" <NUMBER>) | ("ELEMENT" "TYPE" <uneffected_datatype> )) ;

<dependent_handling_clause>				::= ( "INVALIDATE" |( "CASCADE" [ ( "CONVERT" "TO" "SUBSTITUTABLE") |(["NOT" ] "INCLUDING" "TABLE" "DATA" )]  [ ["FORCE" ] <exceptions_clause> ])) ;

<map_order_function_spec>				::= ( "MAP"| "ORDER" ) "MEMBER" <function_spec> ;

<function_spec>							::= "FUNCTION" <name>"(" skipBalanced("(",")") ")"  <return_clause> ;

<return_clause>							::= ( "RETURN" <uneffected_datatype> [ ( "IS" | "AS" ) <call_spec> ] ) ;


<subprogram_spec>						::= ( "MEMBER" | "STATIC" ) ( <procedure_spec> | <function_spec> ) ;

<procedure_spec>						::= "PROCEDURE" <procedure_name>  "(" skipBalanced("(",")") ")"  [ ( "IS" | "AS" ) <call_spec> ] ;


//Vis_26112026_[261101084]_Added IF EXISTS to ALTER USER
<alter_user>							::= "ALTER" "USER" ["IF" "EXISTS"]( (<name>
														(( ("IDENTIFIED"
															  (( "BY" <password> [ "REPLACE" <password> ])
																  | ("EXTERNALLY" [ "AS" <StringValue> ])
																  | ("GLOBALLY" [ "AS" <StringValue> ])
															  ))
															| ("NO" "AUTHENTICATION" )
															| ("DEFAULT" "COLLATION" <name>)
															| ("DEFAULT" "TABLESPACE" <tablespace>)
															| (("LOCAL" "TEMPORARY" |"TEMPORARY" )  "TABLESPACE" <tablespace>)
															| ( "QUOTA" ( <size_clause> | "UNLIMITED" ) "ON" <tablespace> )
															| ("PROFILE" <IDENTIFIER>)
															| ("DEFAULT" "ROLE" (  "ALL" [ "EXCEPT" (<role> ("," <role> )*) ]
																					   | "NONE"
																					   |(<role> ("," <role> )*)
																					   ))
															| ("PASSWORD" "EXPIRE")
															| ("ACCOUNT" ( "LOCK" | "UNLOCK" ))
															| ("ENABLE" "EDITIONS" [ "FOR" (<object_type> ("," <object_type> )*)] [ "FORCE" ])
															| (("HTTP" "DIGEST"| "DIGEST") ( "ENABLE" | "DISABLE" ))
															| ("CONTAINER" "=" ( "CURRENT" | "ALL" ))
															| <container_data_clause>
														 )*
													  | ([("," <name>)* ] <proxy_clause>))
													  )) [";"] ;
													  
													  
<container_data_clause>					::= (( "SET" "CONTAINER_DATA" "=" ( "ALL" | "DEFAULT" | "(" (<container_name> ("," <container_name>)*) ")" ))
												|("ADD" "CONTAINER_DATA" "=" "(" (<container_name> ("," <container_name>)*) ")" )
												|("REMOVE" "CONTAINER_DATA" "=" "(" (<container_name> ("," <container_name>)*) ")"))
												[ "FOR" [ (<schema>|<StringValue>)"." ] <IDENTIFIER> ] ;

<container_name>						::=<IDENTIFIER> ;

<proxy_clause>							::= ( ("GRANT"|"REVOKE") "CONNECT" "THROUGH" (( "ENTERPRISE" "USERS") | (<db_user_proxy> [<db_user_proxy_clauses>] ))) ;

<db_user_proxy_clauses>					::=[ "WITH"  ( ("ROLE" ["ALL" "EXCEPT"] (<role_name> ("," <role_name>)*))
											  | ("NO" "ROLES")
											  )]
											[ "AUTHENTICATION" "REQUIRED" ] ;
									
<role_name>								::=<IDENTIFIER> ;

<db_user_proxy>							::=(<StringValue>|<IDENTIFIER>) ;

<role>						::=<IDENTIFIER>|<StringValue> ;
														


//Vis_26112026_[261101084]_Added IF EXISTS to ALTER VIEW
//Vis_26112026_[261101071]_Fixed unquoted DROP keyword
<alter_view>				::= "ALTER" "VIEW" ["IF" "EXISTS"] [ (<schema>|<StringValue>)"." ] (<view> |<StringValue>) ( ("ADD" <out_of_line_constraint>)
																		  | ("MODIFY" "CONSTRAINT" <constraint>
																			  ( "RELY" | "NORELY" ))
																		  | ("DROP" (( "CONSTRAINT" <constraint>)
																				 | ("PRIMARY" "KEY")
																				 | ("UNIQUE" "("(<column_or_string>("," <column_or_string>)*) ")")
																				 ))
																		  | "COMPILE"
																		  | ( "READ" ("ONLY" | "WRITE" ))
																		  | ( "EDITIONABLE" | "NONEDITIONABLE" )
																		  ) [";"] ;

											
<analyze_command>					::=	 "ANALYZE" ( ( ( "TABLE"|"INDEX") [ (<schema>|<StringValue>)"." ] <table_or_string>  [ <partition_extension_clause> ] ) 
											| ("CLUSTER" [ (<schema>|<StringValue>)"." ] <cluster>  )) 
							  (  ("LIST" "CHAINED" "ROWS" [ <into_clause> ])
								| ("DELETE" [ "SYSTEM" ] "STATISTICS")
								|<validation_clauses>
							  ) [";"] ;	

<into_clause>				::=	"INTO" [ (<schema>|<StringValue>) "." ] <table_or_string> ;	

<validation_clauses>		::=	( ("VALIDATE" "REF" "UPDATE" [ "SET" "DANGLING" "TO" "NULL" ])
									| ("VALIDATE" "STRUCTURE"
										 [ "CASCADE" [( "FAST" | ("COMPLETE" ( "OFFLINE" | "ONLINE" ) [ <into_clause> ]) )] ])
									) ;		  
											
<partition_extension_clause>		::=	 ( ("PARTITION"|"SUBPARTITION" ) (("("<partition> ")")|("FOR" "(" skipBalanced("(",")") ")")) );
														 
											
<associate_statistics>				::= "ASSOCIATE" "STATISTICS" "WITH"  ( <column_association> | <function_association> )  [ <storage_table_clause> ] [";"] ;


<column_association>				::= "COLUMNS" ([ (<schema>|<StringValue>)"." ]<table_or_string>"."<column_or_string>("," [ (<schema>|<StringValue>)"." ]<table_or_string>"."<column_or_string> )*)  <using_statistics_type> ;
											
											
<using_statistics_type>				::= "USING" (  "NULL" |([ (<schema>|<StringValue>)"." ] <IDENTIFIER>  )) ;			

<function_association>				::= ( ("FUNCTIONS"|"PACKAGES"|"TYPES"|"INDEXES"|"INDEXTYPES")([ (<schema>|<StringValue>)"." ]<IDENTIFIER> ("," [ (<schema>|<StringValue>)"." ]<IDENTIFIER> )*) 
												( <using_statistics_type>
													| ( <default_cost_clause> [("," <default_selectivity_clause> )])
													  | (<default_selectivity_clause> [("," <default_cost_clause> )])
													  )
												) ;		
												
<default_cost_clause>				::= "DEFAULT" "COST" "(" skipBalanced( "(",")" ) ")" ;

<default_selectivity_clause>		::= "DEFAULT" "SELECTIVITY" <default_selectivity> ;

<default_selectivity>				::= (<NUMBER>|<StringValue>|<IDENTIFIER>);

<storage_table_clause>				::= "WITH" ("SYSTEM" | "USER") "MANAGED" "STORAGE" "TABLES" ; 

/*
<traditional_audit>					::= AUDIT  (  (<audit_operation_clause> [("IN" "SESSION" "CURRENT")|  <auditing_by_clause> ])
												  | <audit_schema_object_clause>
												  | "NETWORK"
												  |( "DIRECT_PATH" "LOAD" [ <auditing_by_clause> ] ))
												  [ "BY" ( "SESSION" | "ACCESS" ) ]
													[ "WHENEVER" [ "NOT" ] "SUCCESSFUL" ]
													[ "CONTAINER" "=" ( "CURRENT" | "ALL" ) ]
												;
												
<audit_operation_clause>			::= ( (( <sql_statement_shortcut>  | "ALL"  | ("ALL" "STATEMENTS")  ) ["," ( <sql_statement_shortcut>  | "ALL"  | ("ALL" "STATEMENTS")  )])
											| (( <system_privilege> | ("ALL" "PRIVILEGES" )) ["," ( <system_privilege> | ("ALL" "PRIVILEGES" ))]) ) ;
											
<sql_statement_shortcut>			::=*/


<call_command>						::= "CALL"  ( <object_access_expression_call> )  [ "INTO" ":"<variable>    [ [ "INDICATOR" ] ":"<variable> ] ] [";"] ;

<object_access_expression_call>		::=	( (("("<expr>")" ".")| [(<IDENTIFIER> ".")*])  (["."]<method>)*) ;



<comment_command>					::= "COMMENT" "ON"
									  ( ("AUDIT" "POLICY" "policy")
										  | ("COLUMN"  [(<schema>|<StringValue>)"."]  [<table_or_string>"."] <column_or_string>)
										  | ("EDITION" <name>)
										  | ("INDEXTYPE" [ (<schema>|<StringValue>)"." ] <indextype>)
										  | ("MATERIALIZED" "VIEW" [ (<schema>|<StringValue>)"." ] (<view>|<StringValue>))
										  | ("MINING" "MODEL" [ (<schema>|<StringValue>)"." ] <name>)
										  | ("OPERATOR" [ (<schema>|<StringValue>)"." ] <name>)
										  | ("TABLE"[ (<schema>|<StringValue>)"." ] <table_or_string> )
									  )  "IS" <StringValue>[<StringValue>*][";"] ;
									  
									  
									  
									  
<commit_command>					::= "COMMIT" [ "WORK" ]  [ (( "COMMENT" <StringValue>) 
														| ( "WRITE" [ ("WAIT" | "NOWAIT") ] [ ("IMMEDIATE" | "BATCH") ]  )
															  | ("FORCE" <StringValue> ["," <NUMBER> ]))
															  ] [";"] ;
															  
															  
															  
//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE ATTRIBUTE DIMENSION
<create_attribute_dimension>			::= "CREATE" [ "OR" "REPLACE" ] [ "FORCE" | "NOFORCE" ] "ATTRIBUTE" "DIMENSION" ["IF" "NOT" "EXISTS"]
									  [ (<schema>|<StringValue>)"." ] <name>
									  [ "SHARING" "=" "(" "METADATA" | "NONE" ")" ]  [<classification_clause_dim>]
									  [ "DIMENSION" "TYPE" ("STANDARD" | "TIME" ) ]
									  <attr_dim_using_clause>
									  <attributes_clause>
									   <attr_dim_level_clause>
									  [ <all_clause> ]
									  [";"]
									;
									
<attr_dim_using_clause>			::= "USING" ( <source_clause> ) [ <join_path_clause> ] ;

<join_path_clause>				::= "JOIN" "PATH" <name> "ON" <join_condition_dim> ;

<join_condition_dim>			::= <join_condition_elem> ("AND" <join_condition_elem>)* ;

<join_condition_elem>			::= [<alias>"."] <column_or_string> "=" [<alias>"."] <column_or_string> ;

<attributes_clause>				::= "ATTRIBUTES" "(" skipBalanced("(",")") ")" ;

<attr_dim_level_clause>			::= ("LEVEL" <level_name> [ ( ("NOT" "NULL") |  ("SKIP" "WHEN" "NULL" )) ]
									 ( <classification_clause_dim>
									  |( "LEVEL" "TYPE" 
										  (   "STANDARD"
											| "YEARS" 
											| "HALF_YEARS"
											| "QUARTERS"
											| "MONTHS"
											| "WEEKS"
											| "DAYS"
											| "HOURS"
											|"MINUTES"
											| "SECONDS"
										  )
									  )
									 | (<key_clause> [  <key_clause> ])
									 | ( "MEMBER" "NAME" <IDENTIFIER> )
									 | ( "MEMBER" "CAPTION" <IDENTIFIER> ) 
									 | ( "MEMBER" "DESCRIPTION" <IDENTIFIER> )
									 | ( "ORDER" "BY"  [ ((["MIN" | "MAX" ] <dim_order_clause>)
														("," (["MIN" | "MAX" ] <dim_order_clause>) )*) ]
									  )
									 | ( "DETERMINES" "(" <attributes> ("," <attributes>)* ")" ))*)* ;
									  
<key_clause>		::=  ["ALTERNATE"] "KEY" (  ["("] <attributes> ("," <attributes>)* [")"] ) ;

<dim_order_clause>		::= <attributes> [ "ASC" | "DESC" ] [ "NULLS" ( "FIRST" | "LAST" ) ] ;

<all_clause>			::= "ALL"  "MEMBER" (( "NAME" <expression> [ "MEMBER" "CAPTION" <expression> ])
							| ("CAPTION" <expression> [ "MEMBER" "DESCRIPTION" <expression> ])
							| ("DESCRIPTION" <expression> )
							) ;
					
					
<classification_clause_dim>		::= (( "CAPTION"  <caption>)
							| ("DESCRIPTION" <description>) 
							| (( "CLASSIFICATION"  <classification_name>)
							  [ "VALUE" <classification_value>  ] 
							  [ "LANGUAGE" <vlanguage>]));
							  
<create_audit_policy>			::= "CREATE" "AUDIT" "POLICY" <name>
									  [<privilege_audit_clause>] [<action_audit_clause>] [<role_audit_clause>]
									  [ "WHEN" <StringValue> "EVALUATE" "PER" 
										( "STATEMENT" | "SESSION" | "INSTANCE" ) ]
									  [ "ONLY" "TOPLEVEL" ]
									  [ "CONTAINER" "=" ( "ALL" | "CURRENT" ) ] [";"] ;
									  
									  
									  
//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE CLUSTER
//Vis_26112026_[261101088]_Moved SHARING clause before the column list in CREATE CLUSTER
//Vis_26112026_[261101071]_Fixed SINGLE TABLE keyword literal split into separate tokens
<create_cluster>				::= "CREATE" "CLUSTER" ["IF" "NOT" "EXISTS"] [ (<schema>|<StringValue>)"." ] <cluster>
											[ "SHARIN" "=" ( "METADATA" | "NONE" ) ]
										  "(" skipBalanced("(",")") ")"										  
										  [ ( <physical_attributes_clause>
											| ("SIZE" <size_clause>)
											| ("TABLESPACE" <tablespace>)
											| ("INDEX"
											  | [ "SINGLE" "TABLE" ]
												"HASHKEYS" <NUMBER> [ "HASH" "IS" "(" skipBalanced("(",")") ")" ]
											  )
											)*
										  ]
										  [ <parallel_clause> ]
										  [ "NOROWDEPENDENCIES" | "ROWDEPENDENCIES" ]
										  [ ("CACHE" | "NOCACHE") ] [ <cluster_range_partitions> ] [";"] ;
										  
<cluster_range_partitions>			::= "PARTITION" "BY" "RANGE" "("<column_or_string>("," <column_or_string>)* ")"
											"("  skipBalanced("(",")") ")" ;
											
<create_context>					::= "CREATE" [ "OR" "REPLACE" ] "CONTEXT" <name>
										  "USING" [ (<schema>|<StringValue>)"." ] <package>
										  [ "SHARING" "=" ( "METADATA" | "NONE" ) ]
										  [( ("INITIALIZED" ( "EXTERNALLY" | "GLOBALLY" ))
										  | ("ACCESSED" "GLOBALLY"))
										  ] [";"] ;
										  
										  
<create_controlfile>				::= "CREATE" "CONTROLFILE"
											  [ "REUSE" ] [ "SET" ] "DATABASE" <database>
											  ( <logfile_clause> 
											  |( "RESETLOGS" | "NORESETLOGS" )
											  |( "DATAFILE"( <file_specification>
														 ("," <file_specification> )*) )
											  |( "MAXLOGFILES" <NUMBER>)
											  | ("MAXLOGMEMBERS" <NUMBER>)
											  | ("MAXLOGHISTORY" <NUMBER>)
											  | ("MAXDATAFILES" <NUMBER>)
											  | ("MAXINSTANCES" <NUMBER>)
											  | ( "ARCHIVELOG" | "NOARCHIVELOG") 
											  | ("FORCE" "LOGGING")
											  | ("SET" "STANDBY" "NOLOGGING" "FOR"( ("DATA" "AVAILABILITY") | ("LOAD" "PERFORMANCE")))
											  )*
											 
											  [ <character_set_clause> ] [";"] ;
											  
<database>				::=(<StringValue>|<IDENTIFIER>);

<logfile_clause>				::= "LOGFILE"([ "GROUP" <NUMBER> ] <file_specification>  ("," [ "GROUP" <NUMBER> ] <file_specification> )*) ;

<character_set_clause>			::= "CHARACTER" "SET" <character_set> ;


//Vis_26112026_[261101089]_CREATE DATABASE accepts <database> USING MIRROR COPY <name>
<create_database>				::= "CREATE" "DATABASE" [ <database> ]
										  ( ("USER" "SYS" "IDENTIFIED" "BY" <password>)
											  | ("USER" "SYSTEM" "IDENTIFIED" "BY" <password>)
											  | ("CONTROLFILE" "REUSE")
											  | ("MAXDATAFILES" <NUMBER>)
											  | ("MAXINSTANCES" <NUMBER>)
											  | ("CHARACTER" "SET" <character_set>)
											  | ("NATIONAL" "CHARACTER" "SET" <character_set>)
											  | ("SET" "DEFAULT" ( "BIGFILE" | "SMALLFILE" ) "TABLESPACE")
											  | <database_logging_clauses>
											  | <tablespace_clauses>
											  |	(<database> "USING" "MIRROR" "COPY" <name>)
											  | <set_time_zone_clause>
											  | <enable_pluggable_database>
											  | ([ ("BIGFILE" | "SMALLFILE") ] "USER_DATA" "TABLESPACE" <tablespace>
												  "DATAFILE" <datafile_tempfile_spec> ("," <datafile_tempfile_spec>)*)
										  )* [";"] ;
										  
<database_logging_clauses>			::= (( "LOGFILE"([ "GROUP" <NUMBER> ] <file_specification>  ("," [ "GROUP" <NUMBER> ] <file_specification> )*)) 
										| ("MAXLOGFILES" <NUMBER>)
										| ("MAXLOGMEMBERS" <NUMBER>)
										| ("MAXLOGHISTORY" <NUMBER>)
										| ( "ARCHIVELOG" | "NOARCHIVELOG")
										| ("FORCE" "LOGGING")
										|( "SET" "STANDBY" "NOLOGGING" "FOR" (("DATA" "AVAILABILITY") | ("LOAD" "PERFORMANCE")))) ;
										
										
<tablespace_clauses>				::= ( ("EXTENT" "MANAGEMENT" "LOCAL")
											| ("DATAFILE" <file_specification> ("," <file_specification> )*)
											| ("SYSAUX" "DATAFILE" <file_specification> ("," <file_specification> )*)
											| <default_tablespace>
											| ( [ "BIGFILE" | "SMALLFILE" ]( <undo_tablespace>
																			|<default_temp_tablespace>))
										) ;
										
<default_tablespace>				::= "DEFAULT" "TABLESPACE" <tablespace>
										[ "DATAFILE" <datafile_tempfile_spec> ]
										[ <extent_management_clause> ] ;
										
<extent_management_clause>			::= "EXTENT" "MANAGEMENT" "LOCAL" [ ("AUTOALLOCATE"  | ("UNIFORM" [ "SIZE"<size_clause> ]  ))] ;

<default_temp_tablespace>				::= "DEFAULT"
											( ( "TEMPORARY" "TABLESPACE" )
											| ( "LOCAL" "TEMPORARY" "TABLESPACE" "FOR" ( "ALL" | "LEAF" ) )
											) <tablespace>
											[ "TEMPFILE" <file_specification> ("," <file_specification> )*]
											[ <extent_management_clause> ] ;
											
<undo_tablespace>					::=   "UNDO" "TABLESPACE" <tablespace>  [ "DATAFILE" <file_specification> ("," <file_specification> )*] ;

<enable_pluggable_database>			::=  "ENABLE" "PLUGGABLE" "DATABASE"
											  [ "SEED" [ <file_name_convert> ] [ "SYSTEM" <tablespace_datafile_clauses> ]
											  [ "SYSAUX" <tablespace_datafile_clauses> ]
											  ]
											  [ <undo_mode_clause >] ;
											  
											  
<tablespace_datafile_clauses>		::= "DATAFILES" ( "SIZE" <size_clause> | <autoextend_clause> )* ;

<file_name_convert>					::= "FILE_NAME_CONVERT" "="  ( "("  skipBalanced("(",")")")" |  "NONE") ;

//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE DATABASE LINK
<create_database_link>				::= "CREATE" [ "SHARED" ] [ "PUBLIC" ] "DATABASE" "LINK" ["IF" "NOT" "EXISTS"] <dblink_db> 
									  [ ("CONNECT" 
										 (("TO" ( "CURRENT_USER"  | (<IDENTIFIER> "IDENTIFIED" "BY" <password> [ <dblink_authentication> ])) ) 
										 | ("WITH" <IDENTIFIER>) )
									  | <dblink_authentication>)*
									  ]
									  [ "USING" <StringValue> ] [";"] ;
									  
									  
<dblink_db>				::= <database>[("."<domain>)*  ] [ "@" <IDENTIFIER> ] ;

<dblink_authentication>  ::= "AUTHENTICATED" "BY" <IDENTIFIER> "IDENTIFIED" "BY" <password> ;


<create_dimension>					::= "CREATE" "DIMENSION" [ (<schema>|<StringValue>)"." ] <name>
														  <level_clause>*
														  ( <hierarchy_clause>
															  |<attribute_clause>															  
														  )*
														[";"] ;
														
//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE DIRECTORY
<create_directory>				::= "CREATE" [ "OR" "REPLACE" ] "DIRECTORY" ["IF" "NOT" "EXISTS"] <name> 
									[ "SHARING" "=" ( "METADATA" | "NONE" ) ]  "AS" <StringValue> [";"] ;
									
<create_diskgroup>				::=	"CREATE" "DISKGROUP" <name>
									  [ ( "HIGH" | "NORMAL" | "FLEX" | ("EXTENDED" [ "SITE" <name> ]) | "EXTERNAL" ) "REDUNDANCY" ]
									  ( [ ("QUORUM" | "REGULAR") ] [ "FAILGROUP" <name> ]
										"DISK" (<qualified_disk_clause> ("," <qualified_disk_clause>)*)
									  )*
									  [ "ATTRIBUTE" (( <StringValue> "=" <StringValue>) 
												  ("," ( <StringValue> "=" <StringValue>) )*) ] [";"];								
												  
												  
//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE EDITION
<create_edition>				::=	"CREATE" "EDITION"  ["IF" "NOT" "EXISTS"]<IDENTIFIER>  [ "AS" "CHILD" "OF" <IDENTIFIER> ] [";"] ;


<create_flashback_archive>			::= "CREATE" "FLASHBACK" "ARCHIVE" ["DEFAULT"] <flashback_archive>
										  "TABLESPACE" <tablespace>
										  [<flashback_archive_quota>]
										  [ ["NO"] "OPTIMIZE" "DATA" ]
										  <flashback_archive_retention> [";"]
										;

//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE HIERARCHY
<create_hierarchy>					::= "CREATE" [ "OR" "REPLACE" ] [ ("FORCE" | "NOFORCE") ] 
										  "HIERARCHY" ["IF" "NOT" "EXISTS"] [ (<schema>|<StringValue>)"." ] <hierarchy> 
										  [ "SHARING" "=" ( "METADATA" | "NONE" ) ]
										  [ <classification_clause_dim>*  ]
										  <hier_using_clause>
										  <level_hier_clause>
										  [ <hier_attrs_clause> ] [";"] ;
										  
<hier_using_clause>			::= "USING" [ (<schema>|<StringValue>)"." ] <attribute_dimension>  ;

<attribute_dimension>		::= <IDENTIFIER> ;

<level_hier_clause>			::= "(" skipBalanced("(",")") ")" ;

<hier_attrs_clause>			::= "HIERARCHICAL" "ATTRIBUTES" "(" skipBalanced("(",")") ")" ;

//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE INDEXTYPE
<create_indextype>			::= "CREATE" [ "OR" "REPLACE" ] "INDEXTYPE" ["IF" "NOT" "EXISTS"] [ (<schema>|<StringValue>)"." ] <indextype>
										 [ "SHARING" "=" ( "METADATA" | "NONE" ) ]
										  "FOR"( ([ (<schema>|<StringValue>)"." ] <operator> "("skipBalanced("(",")")")")
												("," ([ (<schema>|<StringValue>)"." ] <operator> "("skipBalanced("(",")")")"))*)
										  <using_type_clause>
										  ["WITH" "LOCAL" ["RANGE"] "PARTITION" ]
										  [ <storage_table_clause> ] [";"]  ;
<operator>			::=<IDENTIFIER> ;



//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE INMEMORY JOIN GROUP
<create_inmemory_join_group>		::= "CREATE" "INMEMORY" "JOIN" "GROUP" ["IF" "NOT" "EXISTS"] [ (<schema>|<StringValue>)"." ] <name> "(" skipBalanced("(",")") ")" [";"] ;


//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE JAVA
<create_java>				::= "CREATE" [ "OR" "REPLACE" ] [ "AND" ( "RESOLVE" | "COMPILE" ) ] [ "NOFORCE" ]
											  "JAVA" ["IF" "NOT" "EXISTS"] (( ( "SOURCE" | "RESOURCE" ) "NAMED" [ (<schema>|<StringValue>)"." ] <primary_name>)
												   | ("CLASS" [ "SCHEMA" (<schema>|<StringValue>) ])
												   )
											  [ "SHARING" "=" ( "METADATA" | "NONE" ) ]
											  [ <invoker_rights_clause> ]
											  [ "RESOLVER" "(" skipBalanced("(",")") ")" ]
											  ( ("USING"(( "BFILE" "(" skipBalanced("(",")")")")
													  | (( "CLOB" | "BLOB" | "BFILE" ) <SelectQuery>)
													  | <StringValue>  ))
											  | ("AS" <IDENTIFIER>)
											  ) [";"] ;

<primary_name>				::=(<StringValue>|<IDENTIFIER>) ;


//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE LIBRARY
<create_library>			::= "CREATE" [ "OR" "REPLACE" ][ "EDITIONABLE" | "NONEDITIONABLE" ] "LIBRARY" ["IF" "NOT" "EXISTS"] <plsql_library_source> [";"] ;


<plsql_library_source>		::= [ (<schema>|<StringValue>)"."] <library_name> [ "SHARING" "=" ( "METADATA" | "NONE" )  ] ( "IS" | "AS" )
								  <StringValue> ["IN" <directory_object> ]
								  [ "AGENT" <StringValue> ] [ "CREDENTIAL" [(<schema>|<StringValue>)"."]<name> ]  ;
								  
<library_name>			::=<IDENTIFIER>|<StringValue> ;

<directory_object>		::=<IDENTIFIER> ;


<create_lockdown_profile>				::= "CREATE" "LOCKDOWN" "PROFILE" <name> ( "FROM" | "INCLUDING"  )  <base_profile> [";"];


<base_profile>			::= <IDENTIFIER> ;


<create_materialized_zonemap>	::=(<create_zonemap_on_table>|<create_zonemap_as_subquery>) [";"] ;


//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE MATERIALIZED ZONEMAP
<create_zonemap_on_table>		::= "CREATE" "MATERIALIZED" "ZONEMAP" ["IF" "NOT" "EXISTS"] [ (<schema>|<StringValue>)"." ] <name>  [ <zonemap_attributes> ]  [ <zonemap_refresh_clause> ]
									  [ ( "ENABLE" | "DISABLE" ) "PRUNING" ]
									  "ON" [ (<schema>|<StringValue>)"." ] <table_or_string> "(" <column_or_string> ("," <column_or_string>)* ")" [";"] ;
									  
									  
<zonemap_attributes>			::= ( "TABLESPACE" <tablespace>| "SCALE" <NUMBER>| ( "CACHE" | "NOCACHE" )) ;


//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE MATERIALIZED ZONEMAP ... AS subquery
<create_zonemap_as_subquery>	::= "CREATE" "MATERIALIZED" "ZONEMAP" ["IF" "NOT" "EXISTS"] [ (<schema>|<StringValue>)"." ] <name>
										  [ <zonemap_attributes> ]
										  [ <zonemap_refresh_clause> ]
										 [ ( "ENABLE" | "DISABLE" ) "PRUNING" ]
										  "AS" <SelectQuery> ;

//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE OPERATOR
<create_operation>				::= "CREATE" [ "OR" "REPLACE" ] "OPERATOR" ["IF" "NOT" "EXISTS"]
									[ (<schema>|<StringValue>)"." ] <operator> <binding_clause>  [ "SHARING" "=" ( "METADATA" | "NONE" )] [";"] ;
									
<binding_clause>				::= "BINDING" ("(" skipBalanced("(",")") ")"
										   "RETURN" <uneffected_datatype>
										   [ <implementation_clause> ]
										   <using_function_clause>
											(","  "(" skipBalanced("(",")") ")"
										   "RETURN" <uneffected_datatype>
										   [ <implementation_clause> ]
										   <using_function_clause>
											)*) ;


<create_outline>					::= "CREATE" [ "OR" "REPLACE" ]
									   [ ("PUBLIC" | "PRIVATE") ] "OUTLINE" [ <IDENTIFIER> ]
									   [ "FROM" [ ("PUBLIC" | "PRIVATE") ] <IDENTIFIER> ]
									   [ "FOR" "CATEGORY" <IDENTIFIER> ]
									   [ "ON" <SelectQuery> ] [";"] ;
									   
//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE PACKAGE
<create_package>					::= "CREATE" [ "OR" "REPLACE" ][ ("EDITIONABLE" | "NONEDITIONABLE" )] "PACKAGE" ["IF" "NOT" "EXISTS"] <plsql_package_source> [";"] ;


<plsql_package_source>				::=[ (<schema>|<StringValue>)"." ] <name> [ "SHARING" "=" ( "METADATA" | "NONE" ) ] [ ( <default_collation_clause> | <invoker_rights_clause> | <accessible_by_clause> )* ]  
										( "IS" | "AS" ) <package_item_list>* "END" [ <name> ] [ "EXCEPTION" <exception_handler>* ] [";"] ;
										
										
//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE PACKAGE BODY
<create_package_body>				::= "CREATE" [ "OR" "REPLACE" ][ ("EDITIONABLE" | "NONEDITIONABLE" )] "PACKAGE" "BODY" ["IF" "NOT" "EXISTS"] <plsql_package_body_source> [";"] ;


<plsql_package_body_source>			::= [ (<schema>|<StringValue>)"." ] <name> [ "SHARING" "=" ( "METADATA" | "NONE" ) ] ( "IS" | "AS" )( <column_or_string> <uneffected_datatype>";")* ( <package_declare_section>  [ <initialize_section> ] )* "END" [ <name> ]  ;

<initialize_section>				::= "BEGIN"  skipBalanced("BEGIN","END" ";")"END" ";"  [ "EXCEPTION" <exception_handler>* ] ;

<package_item_list>					::=  ( <package_function_declaration> | <package_procedure_declaration>|(<IDENTIFIER> "EXCEPTION"  [";"])) ;
											
											
<package_declare_section>			::=( <function_declaration>| <procedure_declaration>) ;
											
<package_function_declaration>		::= <function_heading> [ (<accessible_by_clause> 
															| <deterministic_clause> 
															| <pipelined_clause> 
															| <parallel_enable_clause> 
															| <result_cache_clause>) ] [";"] ;
															
															
<package_procedure_declaration>		::= <procedure_heading> [<accessible_by_clause>] [";"] ;
															




<create_pfile>						::= "CREATE" "PFILE" ["=" <StringValue> ]  "FROM" ( ("SPFILE" ["=" <StringValue>])  | "MEMORY" ) [";"] ;


<create_pluggable_database>			::= "CREATE" "PLUGGABLE" "DATABASE" (  ( "AS" "SEED" ) |(<using_snapshot_clause>|( <pdb_name> [ "AS" "APPLICATION" "CONTAINER" ] ) ))
											 ( <create_pdb_from_seed>
												 | <create_pdb_clone> 
												 | <create_pdb_from_xml>
												 | <create_pdb_from_mirror_copy>
												 | <container_map_clause>
											 )[ <pdb_snapshot_clause>] [";"] ;
											 
											 
											 
<using_snapshot_clause>				::=	"USING" "SNAPSHOT" (  "AT" "SCN" <IDENTIFIER> | "AT" <IDENTIFIER>|<name>) ;

<create_pdb_from_seed>				::= "ADMIN" "USER" <name> "IDENTIFIED" "BY" <password>
											  ( <pdb_dba_roles> 
											   |(<parallel_pdb_creation_clause>) 
											   |(<default_tablespace>) 
											   |(<pdb_storage_clause>) 
											   |(<file_name_convert>)
											   |(<service_name_convert>)
											   |(<path_prefix_clause>)
											   |(<tempfile_reuse_clause> )
											   |(<user_tablespaces_clause>)
											   |(<standbys_clause> )
											   |(<logging_clause>)
											   |(<create_file_dest_clause>) 
											   |("HOST" "=" <StringValue>) 
											   |("PORT" "=" <NUMBER> ))* ;
											  
<pdb_dba_roles>					::= "ROLES" "=" "(" skipBalanced( "(",")") ")" ;

<parallel_pdb_creation_clause>		::= "PARALLEL" [ <NUMBER> ] ;



//Vis_26112026_[261101071]_Fixed SERVICE_NAME_CONVERT keyword literal (removed trailing space)
<service_name_convert>			::="SERVICE_NAME_CONVERT" "="  ( "("  skipBalanced("(",")")")" |  "NONE") ;

<path_prefix_clause>			::= "PATH_PREFIX" "=" ("NONE"| <StringValue> | <name>  ) ;

<tempfile_reuse_clause>			::="TEMPFILE" "REUSE" ;

<user_tablespaces_clause>		::= "USER_TABLESPACES" "="  (( "("skipBalanced("(",")") ")")  | ("ALL" [ "EXCEPT" "("skipBalanced("(",")") ")" ])  | "NONE"  )
									[ (("SNAPSHOT" "COPY") |("NO" "DATA") | "COPY" | "MOVE" | "NOCOPY") ] ;
									
<standbys_clause>				::= "STANDBYS" "=" (( "("skipBalanced("(",")") ")")  | ("ALL" [ "EXCEPT" "("skipBalanced("(",")") ")" ])  | "NONE"  ) ;

<create_file_dest_clause>		::= "CREATE_FILE_DEST" "=" ( "NONE" | <StringValue> | <diskgroup_name> ) ;


<create_pdb_clone>				::= ( ( "FROM"  <name> [ "@" <dblink> ] )
										|
										  ( "AS" "PROXY" "FROM" <name> "@" <dblink> )
										)
										  ((<using_snapshot_clause> )
										  |(<parallel_pdb_creation_clause> )
										  |(<default_tablespace> )
										  |(<pdb_storage_clause> )
										  |(<file_name_convert> )
										  |( <service_name_convert> )
										  |( <path_prefix_clause> )
										  |( <tempfile_reuse_clause> )
										  |( "SNAPSHOT" "COPY" )
										  |( <user_tablespaces_clause> )
										  |( <standbys_clause> )
										  |(<logging_clause> )
										  |(<create_file_dest_clause> )
										  |(<keystore_clause> )
										  |(<pdb_refresh_mode_clause> )
										  |("RELOCATE" "AVAILABILITY" ("MAX" | "NORMAL") )
										  |("NO" "DATA" )
										  |("HOST" "=" <StringValue>) 
										  |("PORT" "=" <NUMBER> ))* ;


<keystore_clause>				::= "KEYSTORE" "IDENTIFIED" "BY"  ( "EXTERNAL" "STORE" | <keystore_password> ) [ "NO" "REKEY" ]  ;

<create_pdb_from_xml>			::= [ "AS" "CLONE" ] "USING" (<filename>|<name>)
									  [ (<source_file_name_convert> | <source_file_directory>) ]
									  [ ( [ ("COPY" | "MOVE") ] <file_name_convert> ) | "NOCOPY" ]
									  (( <service_name_convert> )
									  |( <default_tablespace>)
									  |( <pdb_storage_clause> )
									  |( <path_prefix_clause> )
									  |( <tempfile_reuse_clause> )
									  |( <user_tablespaces_clause> )
									  |( <standbys_clause> )
									  | (<logging_clause> )
									  |( <create_file_dest_clause> )
									  |( "HOST" "=" <StringValue> )
									  | ("PORT" "=" <NUMBER> )  
									  |( <create_pdb_decrypt_from_xml> ))* ;
									  
									  
<create_pdb_decrypt_from_xml>	::= "DECRYPT" "USING" <StringValue> ;

<source_file_name_convert>		::= "SOURCE_FILE_NAME_CONVERT" "="  ( "("  skipBalanced( "(",")" ) ")"  |  "NONE"  ) ;

<source_file_directory>			::= "SOURCE_FILE_DIRECTORY" "=" (<StringValue> | "NONE" )  ;

 
<create_pdb_from_mirror_copy>	::= <name> "FROM" <name> "@"<name> "USING" "MIRROR" "COPY" <name> ;

//Vis_26112026_[261101071]_Fixed CONTAINER_MAP UPDATE keyword literal split into separate tokens
<container_map_clause>			::=  "CONTAINER_MAP" "UPDATE" ( <add_table_partition> | <split_table_partition> ) ;


<create_pmem_filestore>			::= "CREATE" "PMEM" "FILESTORE" <name>
									  ( ("MOUNTPOINT" <file_path>)
										  | ("BACKINGFILE" <filename> [ "REUSE" ])
										  | ("SIZE" <size_clause>)
										  | ("BLOCKSIZE" <size_clause>)
										  | <autoextend_clause>
									  )* [";"] ;
									  
<file_path>					::=(<StringValue>|<IDENTIFIER>) ;



<create_profile>			::= "CREATE" [ "MANDATORY" ] "PROFILE" <name>
										  "LIMIT" ( <resource_parameters>
												| <password_parameters>
												)*
										  [ "CONTAINER" "=" ( "CURRENT" | "ALL" ) ] [";"] ;
										  
<create_restore_point>		::=	 "CREATE" [ "CLEAN" ] "RESTORE" "POINT" <name>
								   [ "FOR" "PLUGGABLE" "DATABASE" <pdb_name> ]   
								   [ "AS" "OF" ("TIMESTAMP" | "SCN") <expr> ]
								   [ ("PRESERVE"
								   | ("GUARANTEE" "FLASHBACK" "DATABASE"))
								   ] [";"];								  
								   
								   
//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE ROLE
<create_role>				::= "CREATE" "ROLE" ["IF" "NOT" "EXISTS"] <name>
							   [ (("NOT" "IDENTIFIED")
							   | "IDENTIFIED"( ( "BY"<password>)
											| ("USING" [ (<schema>|<StringValue>)"." ] <package>)
											| "EXTERNALLY"
											| ("GLOBALLY" "AS" <name>)
									 ))
							   ] [ "CONTAINER" "=" ( "CURRENT" | "ALL" ) ] [";"];
							   
<create_rollback_segment>	::= "CREATE" [ "PUBLIC" ] "ROLLBACK" "SEGMENT" <rollback_segment>  [ ("TABLESPACE" <tablespace> | <storage_clause>)* ] [";"] ;



<create_schema>				::= "CREATE" "SCHEMA" "AUTHORIZATION" (<schema>|<StringValue>)   ( <create_table>   | <create_view>  )* [";"] ;

<create_spfile>				::= "CREATE" "SPFILE" ["=" <StringValue> ]  "FROM" (( "PFILE" ["=" <StringValue> ] [ "AS" "COPY"])   | "MEMORY" ) [";"] ;

//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE SYNONYM
<create_synonym>			::= "CREATE" [ "OR" "REPLACE" ] [ ("EDITIONABLE" | "NONEDITIONABLE" )]
									   [ "PUBLIC" ] "SYNONYM" ["IF" "NOT" "EXISTS"]
									   [(<schema>|<StringValue>)"." ] <IDENTIFIER>
									   [ "SHARING" "=" ( "METADATA" | "NONE" ) ]
									   "FOR" [ (<schema>|<StringValue>) "." ] <object> [ "@" <dblink_synonym> ] [";"] ;
									   
<dblink_synonym>			::=[ ((<schema>|<StringValue>) ".")* ] <IDENTIFIER> ;


<create_tablespace>			::= "CREATE" [ "BIGFILE" | "SMALLFILE" ]  ( <permanent_tablespace_clause>| <temporary_tablespace_clause>  | <undo_tablespace_clause>) [";"] ;


//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE TABLESPACE
<permanent_tablespace_clause>	::= "TABLESPACE" ["IF" "NOT" "EXISTS"] <tablespace>  [ "DATAFILE" <file_specification> ("," <file_specification> )* ]
									  [ <permanent_tablespace_attrs> ]
									  [ "IN" "SHARDSPACE" <IDENTIFIER> ] ;
									  
<permanent_tablespace_attrs>	::=( ("MINIMUM" "EXTENT" <size_clause>)
										| ("BLOCKSIZE" <NUMBER> [ "K" ])
										| <logging_clause>
										| ("FORCE" "LOGGING")
										| <tablespace_encryption_clause>
										| <default_tablespace_params>
										| ( "ONLINE" |"OFFLINE" )
										| <extent_management_clause>
										| <segment_management_clause>
										| <flashback_mode_clause>
										)* ;
										
<tablespace_encryption_clause>		::= "ENCRYPTION" [ (  "DECRYPT"|[ <tablespace_encryption_spec> ] "ENCRYPT" ) ] ;

<segment_management_clause>			::= "SEGMENT" "SPACE" "MANAGEMENT" ( "AUTO" | "MANUAL" ) ;


<temporary_tablespace_clause>		::= ( ( "TEMPORARY" "TABLESPACE" )| ( "LOCAL" "TEMPORARY" "TABLESPACE" "FOR" ( "ALL" | "LEAF" ) )) <tablespace>
										[ "TEMPFILE" <file_specification> ("," <file_specification>)*  ]
										[ <tablespace_group_clause> ]
										[ <extent_management_clause> ] ;
										
<undo_tablespace_clause>			::=<undo_tablespace> [ <extent_management_clause> ]  [ <tablespace_retention_clause> ]  [ <tablespace_encryption_clause> ] ;


<create_tablespace_set>				::="CREATE" "TABLESPACE" "SET" <tablespace>  [ "IN" "SHARDSPACE" <IDENTIFIER> ]
										  [ "USING" "TEMPLATE" 
											"("  ["DATAFILE" <file_specification> ("," <file_specification> )* ]< permanent_tablespace_attrs> ")" ] [";"];
											
											
//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE TYPE
<create_type>						::= "CREATE" [ "OR" "REPLACE" ][ "EDITIONABLE" | "NONEDITIONABLE" ] "TYPE" ["IF" "NOT" "EXISTS"] <plsql_type_source>[";"] ;


<plsql_type_source>					::=[ (<schema>|<StringValue>)"." ] <name> [ "FORCE" ] [ "OID" <StringValue> ] 
																			 [ "SHARING" "=" ( "METADATA" | "NONE" ) ]
																			[ <default_collation_clause> ]
																			[ (( <invoker_rights_clause> ) |  ( <accessible_by_clause>) ) ]
																			( <object_base_type_def>| <object_subtype_def>) ;
																			
																			
<object_base_type_def>				::= ( "IS" | "AS" ) ( <object_type_def> | <varray_type_spec> | <nested_table_type_spec> ) ;


<object_type_def>					::="OBJECT" "(" skipBalanced( "(",")" )  ")" [(  ["NOT"] ("FINAL" | "INSTANTIABLE"| "PERSISTABLE" )   )*] ;

<varray_type_spec>					::= ( "VARRAY" | ([ "VARYING" ] "ARRAY") ) "(" <size_limit> ")"
											"OF" <uneffected_datatype> [ ["NOT"] "PERSISTABLE" ] ;
											
<nested_table_type_spec>			::="TABLE" "OF" <uneffected_datatype> [ ["NOT"] "PERSISTABLE" ] ;

<object_subtype_def>				::=  "UNDER" [(<schema>|<StringValue>)"."]<name> "(" skipBalanced( "(",")" )  ")"  [(  ["NOT"] ("FINAL" | "INSTANTIABLE" )  )*] ;


//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE TYPE BODY
<create_type_body>					::= "CREATE" [ "OR" "REPLACE" ] [ ("EDITIONABLE" | "NONEDITIONABLE") ]   "TYPE" "BODY" ["IF" "NOT" "EXISTS"] <plsql_type_body_source> [";"] ;


<plsql_type_body_source>			::=[ (<schema>|<StringValue>)"." ] <name> [ "SHARING" "=" ( "METADATA" | "NONE" ) ]( "IS" | "AS" )
											  ( ( <subprog_decl_in_type>
											   | <map_order_func_declaration>
											   )
												 ("," ( <subprog_decl_in_type>
														| <map_order_func_declaration>
															)
												 )*)
											"END";

<subprog_decl_in_type>				::= ( <proc_decl_in_type> | <func_decl_in_type> | <constructor_declaration> ) ;

<proc_decl_in_type>					::=	 "PROCEDURE" <name> [ "(" skipBalanced( "(",")" ) ")" ]
											( "IS" |"AS" ) ( [ <declare_section> ] <body> | <call_spec> ) ;		
											
<func_decl_in_type>					::=	"FUNCTION" <name> [ "(" skipBalanced( "(",")" ) ")" ]
									   "RETURN" <uneffected_datatype>
									  [ ( <invoker_rights_clause>
										| <accessible_by_clause>
										| "DETERMINISTIC"
										| <parallel_enable_clause>
										| <result_cache_clause>
										)*[ "PIPELINED" ] ] 
									   ( "IS" | "AS" ) ( <call_spec> |([ <declare_section> ] <body>))	 ;	


<constructor_declaration>			::=	[ "FINAL" ][ "INSTANTIABLE" ]"CONSTRUCTOR" "FUNCTION" <uneffected_datatype> [ [ "SELF" "IN" "OUT" <uneffected_datatype>"," ]  (<parameter> <uneffected_datatype> ("," <parameter> <uneffected_datatype> )*)]
											"RETURN" "SELF" "AS" "RESULT"
											( "IS" | "AS" ) ( <call_spec> |([ <declare_section> ] <body>)) ;							   

<map_order_func_declaration>		::=		[ ("MAP" | "ORDER")]  "MEMBER" <func_decl_in_type> ;
											
											
											
//Vis_26112026_[261101069]_Added IF NOT EXISTS to CREATE USER
<create_user>						::= "CREATE" "USER" ["IF" "NOT" "EXISTS"] <name>
											    
												   (("IDENTIFIED"
															  (( "BY" <password> [ "REPLACE" <password> ])
																  | ("EXTERNALLY" [ "AS" <StringValue> ])
																  | ("GLOBALLY" [ "AS" <StringValue> ])
															  ))

													               
												| ("NO" "AUTHENTICATION" ))
												[( ("DEFAULT" "COLLATION" <name>)
												| ("DEFAULT" "TABLESPACE" <tablespace>)
												| (("LOCAL" "TEMPORARY" |"TEMPORARY" )  "TABLESPACE" <tablespace>)
												| ( "QUOTA" ( <size_clause> | "UNLIMITED" ) "ON" <tablespace> )
												| ("PROFILE" <IDENTIFIER>)
												| ("PASSWORD" "EXPIRE")
												| ("ACCOUNT" ( "LOCK" | "UNLOCK" ))
												| ("ENABLE" "EDITIONS" [ "FOR" (<object_type> ("," <object_type> )*)] [ "FORCE" ])
												| ("CONTAINER" "=" ( "CURRENT" | "ALL" ))
												 )*][";"]
											   ;
											   
											   


<disassociate_statistics>			::= "DISASSOCIATE" "STATISTICS" "FROM" ("COLUMNS"|"FUNCTIONS"|"PACKAGES"|"TYPES"|"INDEXES"|"INDEXTYPES")
											([ (<schema>|<StringValue>)"." ][ <IDENTIFIER>"." ]<IDENTIFIER> ("," [ (<schema>|<StringValue>)"." ][ <IDENTIFIER>"." ]<IDENTIFIER> )*)  [ "FORCE" ][";"] ;
											
											
											
<drop_common>						::= "DROP" <drop_object> [ (<schema>|<StringValue>)"." ] <name> ["FORCE"] ["CASCADE"] [";"];

// IF EXISTS placement follows the Oracle 26ai syntax of each statement.
//Vis_26112026_[261101090]_Updated generic DROP object list: IF EXISTS where supported, added 26ai object types (application identity, assertion, data grant/role, end user [context], macro, MLE env/module, property graph, directive)
<drop_object>		::= ( <drop_object_if_exists> [ "IF" "EXISTS" ] )
						| ( "PACKAGE" [ "IF" "EXISTS" ] [ "BODY" ] )
						| ( "MATERIALIZED" "VIEW" "LOG" [ "IF" "EXISTS" ] "ON" )
						| <drop_object_no_if_exists> ;

// Objects whose DROP statement accepts IF EXISTS right after the object keyword(s)
//Vis_26112026_[261101090]_Helper: DROP object keywords that accept IF EXISTS
<drop_object_if_exists>	::= ("ANALYTIC" "VIEW")|("ATTRIBUTE" "DIMENSION")|("APPLICATION" "IDENTITY")|"ASSERTION"
						|("DATA" "GRANT")|("DATA" "ROLE")|"DIRECTORY"|("END" "USER" "CONTEXT")|("END" "USER")
						|"FUNCTION"|"HIERARCHY"|"INDEXTYPE"|("INMEMORY" "JOIN" "GROUP")|"LIBRARY"|"MACRO"
						|("MLE" "ENV")|("MLE" "MODULE")|"OPERATOR"|"PROCEDURE"|("PROPERTY" "GRAPH")
						|"ROLE"|"SEQUENCE"|"TRIGGER"|"USER" ;

// Objects whose DROP statement has no IF EXISTS
//Vis_26112026_[261101090]_Helper: DROP object keywords without IF EXISTS
<drop_object_no_if_exists>	::= ("AUDIT" "POLICY")|"CONTEXT"|"DIMENSION"|"DIRECTIVE"|("FLASHBACK" "ARCHIVE")
						|("LOCKDOWN" "PROFILE")|("MATERIALIZED" "ZONEMAP")|"OUTLINE"|"PROFILE"|("ROLLBACK" "SEGMENT") ;

//Vis_26112026_[261101091]_Added DROP EDITION name [IF EXISTS] [CASCADE] (EDITION removed from <drop_object>)
<drop_edition>		::= "DROP" "EDITION" <name> [ "IF" "EXISTS" ] [ "CASCADE" ] [";"] ;

//Vis_26112026_[261101092]_Added DROP [USECASE] DOMAIN [IF EXISTS] ... [FORCE [PRESERVE]]
<drop_domain>		::= "DROP" "DOMAIN" [ "USECASE" ] [ "IF" "EXISTS" ] [ <schema> "." ] <domain_name>
						[ "FORCE" [ "PRESERVE" ] ] [";"] ;

//Vis_26112026_[261101093]_Added DROP ICEBERG TABLE ... WITHIN CATALOG
<drop_iceberg_table>	::= "DROP" "ICEBERG" "TABLE" [ <schema> "." ] <name> "WITHIN" "CATALOG" <name> [ "PURGE" ] [";"] ;


//Vis_26112026_[261101090]_Added IF EXISTS to DROP CLUSTER
<drop_cluster>		::="DROP" "CLUSTER" [ "IF" "EXISTS" ] [ (<schema>|<StringValue>)"." ] <name>  [ "INCLUDING" "TABLES" [ "CASCADE" "CONSTRAINTS" ] ]  [";"];

//Vis_26112026_[261101090]_Added IF EXISTS to DROP DATABASE LINK
<drop_databaselink>		::= "DROP" [ "PUBLIC" ] "DATABASE" "LINK" [ "IF" "EXISTS" ] <dblink_name> [";"] ;

<drop_diskgroup>		::= "DROP" "DISKGROUP" <name> [  ("FORCE" "INCLUDING" "CONTENTS") | ( "INCLUDING" | "EXCLUDING" ) "CONTENTS"  ] [";"];

//Vis_26112026_[261101090]_Added IF EXISTS to DROP INDEX
<drop_index>			::= "DROP" "INDEX" [ "IF" "EXISTS" ] [ (<schema>|<StringValue>)"." ] <index> [ "ONLINE" ] [ "FORCE" ]  [ ( "DEFERRED" | "IMMEDIATE" ) "INVALIDATION" ] [";"];

//Vis_26112026_[261101090]_Added IF EXISTS to DROP JAVA
<drop_java>				::= "DROP" "JAVA" [ "IF" "EXISTS" ] ( "SOURCE" | "CLASS" | "RESOURCE" )  [(<schema>|<StringValue>)"." ] (<StringValue>|<IDENTIFIER>) [";"] ;

//Vis_26112026_[261101090]_Added IF EXISTS to DROP MATERIALIZED VIEW
<drop_materialized_view> ::= "DROP" "MATERIALIZED" "VIEW" [ "IF" "EXISTS" ] [ (<schema>|<StringValue>)"." ] (<view> |<StringValue>)  [ "PRESERVE" "TABLE" ] [";"] ;

<drop_pluggable_database>		::= "DROP" "PLUGGABLE" "DATABASE" <pdb_name>  [ ( "KEEP" | "INCLUDING" ) "DATAFILES" ] [";"] ;

<drop_pmem_filestore>		::= "DROP" "PMEM" "FILESTORE" <name>  [( "FORCE" "INCLUDING" "CONTENTS")  | ( "INCLUDING" | "EXCLUDING" ) "CONTENTS" ]  [";"] ;

<drop_restore_point>			::= "DROP" "RESTORE" "POINT" <name> [ "FOR" "PLUGGABLE" "DATABASE" <pdb_name> ] [";"] ;

//Vis_26112026_[261101090]_Added IF EXISTS to DROP SYNONYM
<drop_synonym>				::= "DROP" ["PUBLIC"] "SYNONYM" [ "IF" "EXISTS" ] [(<schema>|<StringValue>)"." ] <name> ["FORCE"] [";"] ;

//Vis_26112026_[261101090]_Added IF EXISTS to DROP TABLE
<drop_table>				::= "DROP" "TABLE" [ "IF" "EXISTS" ] [ (<schema>|<StringValue>)"." ] <table_or_string>  [ "CASCADE" "CONSTRAINTS" ] [ "PURGE" ] [";"] ;


//Vis_26112026_[261101090]_Added IF EXISTS to DROP TABLESPACE
<drop_tablespace>			::= "DROP" "TABLESPACE" ( "SET" | [ "IF" "EXISTS" ] ) <tablespace> [ ( "DROP" | "KEEP" ) "QUOTA" ] 
								[ "INCLUDING" "CONTENTS" [ ( "AND" | "KEEP" ) "DATAFILES" ] [ "CASCADE" "CONSTRAINTS" ] ] [";"] ;
								
//Vis_26112026_[261101090]_Added IF EXISTS to DROP TYPE
<drop_type>					::= "DROP" "TYPE" ["BODY"] [ "IF" "EXISTS" ] [ (<schema>|<StringValue>)"." ] <name> [ ("FORCE" | "VALIDATE") ] [";"] ;
								
//Vis_26112026_[261101090]_Added IF EXISTS to DROP VIEW
<drop_view>					::= "DROP" "VIEW" [ "IF" "EXISTS" ] [ (<schema>|<StringValue>)"." ] (<view>|<StringValue>) [ "CASCADE" "CONSTRAINTS" ] [";"] ;


<explain_plan>				::= "EXPLAIN" "PLAN"   [ "SET" "STATEMENT_ID" "=" <StringValue> ]   [ "INTO" [ (<schema>|<StringValue>)"." ] <table_or_string> [ "@" <dblink> ] ] "FOR" <statement> [";"] ;


<flashback_table>			::= "FLASHBACK" "TABLE" ([ (<schema>|<StringValue>)"." ] <table_or_string> ("," [ (<schema>|<StringValue>)"." ] <table_or_string> )*)
								   "TO" ( ( (( "SCN" | "TIMESTAMP" ) <expr>)
										| ("RESTORE" "POINT" <IDENTIFIER>)
										) [ ( "ENABLE" | "DISABLE" ) "TRIGGERS" ]
									  | ("BEFORE" "DROP" [ "RENAME" "TO" <table_or_string>] )
									  ) [";"];
									  
<grand_commands>			::= "GRANT"  ( ( ( (( ("ALL" "PRIVILEGES")|<role>  )  ) ( <grant_system_privileges> | <grant_object_privileges> )   
									[ "CONTAINER" "=" ( "CURRENT" | "ALL" ) ] ))  | <grant_roles_to_programs>  ) [";"] ;
									
									
<grant_system_privileges>	::=(","  (("ALL" "PRIVILEGES")|<role> ))* 	"TO" ( <grantee_clause>  ) [ "WITH" ("ADMIN" | "DELEGATE" ) "OPTION" ] [";"] ;
									
									
<grantee_clause>			::= (( "PUBLIC" |<role> ) (","( "PUBLIC" |<role> ) )*) ["IDENTIFIED" "BY" <password> ("," <password>)* ] ;


<grant_object_privileges>	::=   ((  [ "("skipBalanced("(",")") ")" ])
									  ("," (("ALL" [ "PRIVILEGES" ]) |<IDENTIFIER> 
									  [ "("skipBalanced("(",")") ")" ]))*)
									<on_object_clause>
									"TO" <grantee_clause>
									  [ "WITH" "HIERARCHY" "OPTION" ]
									  [ "WITH" "GRANT" "OPTION" ] ;

<on_object_clause>			::= "ON" ( ( "USER"( <name> ("," <name>)*))
								   | ("DIRECTORY" <name>)
								   | ("EDITION" <name>)
								   | ("MINING" "MODEL" [ (<schema>|<StringValue>)"." ] <name>)
								   | ("JAVA" ("SOURCE" | "RESOURCE" ) [ (<schema>|<StringValue>)"." ] <object>)
								   | ("SQL" "TRANSLATION" "PROFILE" [ (<schema>|<StringValue>)"." ] <object>)
								   |([ (<schema>|<StringValue>)"." ] <object> )
								   ) ;
									
<grant_roles_to_programs>		::= (<role> ("," <role> )*) "TO" (<program_unit> ("," <program_unit>)*) ;

<program_unit>				::= ( "FUNCTION"|"PROCEDURE" |"PACKAGE" ) [ (<schema>|<StringValue>)"." ] <name> ;


<insert_command>			::= "INSERT"   ( <single_table_insert> | <multi_table_insert> ) [";"] ;

<single_table_insert>			::= <insert_into_clause>( (<values_clause> [ <returning_clause> ])| <SelectQuery> )
										[ <error_logging_clause> ] ;


<values_clause>				::= "VALUES" "(" skipBalanced("(",")") ")" ;

<insert_into_clause>		::= "INTO" [(<schema>|<StringValue>)"."]  [ <table_or_string> ][ "(" skipBalanced("(",")") ")" ] ;

<returning_clause>			::=("RETURN" | "RETURNING" ) (<expr> ("," <expr> )*)
								"INTO" (<data_item> ("," <data_item>)*) ;
								
								
<data_item>					::=<IDENTIFIER> ;

<error_logging_clause>		::= "LOG" "ERRORS" [ "INTO" [(<schema>|<StringValue>)"."] <table_or_string> ]
								  [ "("skipBalanced( "(",")") ")" ]
								  [ "REJECT" "LIMIT" ( "UNLIMITED"|<NUMBER>)  ] ;
								  
								  
<multi_table_insert>		::=( "ALL"  ( <insert_into_clause> [ <values_clause> ] [<error_logging_clause>] )*
								| <conditional_insert_clause>) <SelectQuery> ;	

<conditional_insert_clause>		::= [ "FIRST"|"ALL" ] ("WHEN" <condition>
									"THEN"<insert_properties>*)*									
									[ "ELSE" <insert_properties>*] ;

<insert_properties>				::=<insert_into_clause> [ <values_clause> ] [ <error_logging_clause> ] ;
												
											



<lock_table_command>			::= "LOCK" "TABLE" (([ (<schema>|<StringValue>)"." ]  <table_or_string>
									   [ <partition_extension_clause>  | "@" <dblink> ])
									   ("," ([ (<schema>|<StringValue>)"." ]  <table_or_string>
									   [ <partition_extension_clause>  | "@" <dblink> ]))*)
									   "IN" <IDENTIFIER> "MODE"
									   [ ("NOWAIT"  | "WAIT" <NUMBER>) ] [";"];

								
<merge_command>					::= "MERGE"  "INTO" [(<schema>|<StringValue>)"." ]  <table_or_string> [ <table_or_string> ]
										   "USING" ( ([ (<schema>|<StringValue>)"." ]  <table_or_string>)
												 | ( <SelectQuery> )
												 ) [ <table_or_string> ]
										   "ON" "("skipBalanced("(",")") ")"
										   [ <merge_update_clause> ]
										   [ <merge_insert_clause> ]
										   [ <error_logging_clause> ] [";"] ;
										   
										   
										   
<merge_update_clause>			::= "WHEN" "MATCHED" "THEN" "UPDATE" "SET" ((([<table_or_string>"."]<column_or_string> "=" ( (<table_or_string>"."<column_or_string>)|"DEFAULT"|<expr>)))
									("," [<table_or_string>"."] <column_or_string> "="  ( "DEFAULT"|(<table_or_string>"."<column_or_string>)|<expr>))*)
										[ <where_clause> ]
										[ "DELETE" <where_clause> ] ;
										
										
<merge_insert_clause>			::= "WHEN" "NOT" "MATCHED" "THEN"
										"INSERT" [ "(" skipBalanced("(",")") ")" ]
										"VALUES" "(" skipBalanced("(",")")  ")"
										[ <where_clause> ] ;


<where_clause>				::= "WHERE" <condition> ;


<pure_command>					::= "PURGE"( ("TABLE" | "INDEX" | ("TABLESPACE" ["SET"])|"RECYCLEBIN"|"DBA_RECYCLEBIN")
												[<IDENTIFIER>] [ "USER" <IDENTIFIER> ]) [";"] ;
											  
											  
<rename_command>			::= "RENAME" <name> "TO" <name> [";"] ;


<revoke_command>			::= "REVOKE"  ( ( (<revoke_system_privileges> | <revoke_object_privileges> )
													[ "CONTAINER" "=" ( "CURRENT" | "ALL" ) ] )
										| <revoke_roles_from_programs> ) [";"] ;
										
										
										
<revoke_system_privileges>		::= ( ( ("ALL"|"INHERIT") "PRIVILEGES"|<role>  )
									  ("," ( "ALL" "PRIVILEGES"|<role> ) )*)	"FROM" <revokee_clause> ;
									  
									  
<revokee_clause>				::=(("PUBLIC" |<role>) ("," ( "PUBLIC" |<role>))*) ;


<revoke_object_privileges>		::= ((( ("ALL"|"INHERIT") [ "PRIVILEGES" ])|<IDENTIFIER> )("," (( "ALL" [ "PRIVILEGES" ])|<IDENTIFIER>))*) 
										<on_object_clause>
										"FROM" <revokee_clause>
										[ ("CASCADE" "CONSTRAINTS") | "FORCE" ] ;


<revoke_roles_from_programs>	::= ( "ALL"|( <role> ("," <role> )*)) "FROM" (<program_unit> ("," <program_unit>)*) ;

<rollback_command>				::= "ROLLBACK" [ "WORK" ]  [ (("TO" [ "SAVEPOINT" ] <IDENTIFIER>)   | ("FORCE" <StringValue>) )  ] [";"] ;

<set_constraint>					::= "SET" ( "CONSTRAINT" | "CONSTRAINTS" )
										(  "ALL"|<constraint_pro>)
										("IMMEDIATE" | "DEFERRED" )[";"] ;
										
										
<constraint_pro>				::=(([(<schema>|<StringValue>)"."] <IDENTIFIER>["@"<IDENTIFIER>])
									(","([(<schema>|<StringValue>)"."] <IDENTIFIER>["@"<IDENTIFIER>]))*);
									
<set_role>				::= "SET" "ROLE"  ( ("ALL" [ "EXCEPT" (<role> ("," <role>)*) ])
							   | "NONE"
							   |( ( <role> [ "IDENTIFIED" "BY" <password> ])
								 ("," <role> [ "IDENTIFIED" "BY" <password> ] )*)
							   )[";"] ;


<set_transaction>		::= "SET" "TRANSACTION" ( ( "READ" ( "ONLY" | "WRITE" ))
						 | ("ISOLATION" "LEVEL"
						   ( "SERIALIZABLE" | "READ" "COMMITTED" ))
						 | ("USE" "ROLLBACK" "SEGMENT" <rollback_command>)
						 ) [ "NAME" <StringValue> ] [";"]    ;


<truncate_cluster>		::= "TRUNCATE" "CLUSTER" [(<schema>|<StringValue>)"."] <cluster> [ ("DROP" | "REUSE") "STORAGE" ] [";"] ;


<truncate_table>		::= "TRUNCATE" "TABLE" [(<schema>|<StringValue>)"."] <table_or_string>
							  [ ("PRESERVE" | "PURGE") "MATERIALIZED" "VIEW" "LOG" ]
							  [ ( ("DROP" [ "ALL" ]) | "REUSE") "STORAGE" ] [ "CASCADE" ] [";"] ;


<update_command>		::= "UPDATE" 
							   ( <dml_table_expression_clause>
							   | ("ONLY" "("<dml_table_expression_clause>")"  ) )[ <table_or_string> ]
							   <update_set_clause>
							   [ <where_clause> ]
							   [ <returning_clause> ]
							   [<error_logging_clause>] [";"] ;



<dml_table_expression_clause>		::= (  ("(" skipBalanced("(",")") ")")
											| <table_collection_expression>
											|([ (<schema>|<StringValue>)"." ]
											  <table_or_string>    [ (<partition_extension_clause>    | ("@" <dblink> ))  ] )
											) ;
											
<table_collection_expression>		::= "TABLE" "(" skipBalanced("(",")") ")" [ "(" "+" ")" ] ;


<update_set_clause>					::="SET" (((( "(" skipBalanced("(",")") ")" "=" ( ("("skipBalanced("(",")")")")| "DEFAULT"))
										  | (<column_or_string> "=" ( (("("skipBalanced("(",")")")")| "DEFAULT")|<expr> ))
										  )
										  (","(( "(" skipBalanced("(",")") ")" "=" ( ("("skipBalanced("(",")")")")| "DEFAULT"))
										  | (<column_or_string> "=" ( (("("skipBalanced("(",")")")")| "DEFAULT")|<expr> ))
										  ))*)
    
											| ("VALUE" "("<table_or_string>")" "=" (  "("skipBalanced("(",")")")"|<expr> ))) ; 
											
											
<flashback_database>				::= "FLASHBACK" [ "STANDBY" ] [ "PLUGGABLE" ] "DATABASE" (<flashback_db_pro>| (<database><flashback_db_pro>) )  [";"] ;
										   
										   
<flashback_db_pro>				::=  ( ( "TO" (( ( "SCN" | "TIMESTAMP" ) <expr>)
												| ("RESTORE" "POINT" <IDENTIFIER>)
												)
										   )
										   | ( "TO" "BEFORE" ( (( "SCN" | "TIMESTAMP" ) <expr>)
														 | "RESETLOGS" 
														 )
										   ))  ;
										   
										   
<delete_command>				::= "DELETE" ["FROM" ]   (  ("ONLY" "("<dml_table_expression_clause>")") |<dml_table_expression_clause> )
										  (<delete_where_clause> |  (<table_or_string> <delete_where_clause> [<returning_clause>] |[<error_logging_clause>] )) [";"];


<delete_where_clause>			::= "WHERE" <delete_condition> (("AND"|"OR") (<delete_condition>) )* ;



<delete_condition>			::= [<table_or_string>][( ("." | "/"|"+")<column_or_string>) | ("(" <col_names> ")")] [ ("(" skipBalanced("(" , ")" ) ")") ] ["/" [<IDENTIFIER> "."] <IDENTIFIER>] [<NUMBER>] [<comparison_Operator> ]
									( ((<returning_clause> |<error_logging_clause>))| (["NEW" <IDENTIFIER>"("  <StringValue> ")"]  ["(" "SUBSTRING" "(" skipBalanced("(" , ")" ) ")" ")"] [ ("(" skipBalanced("(" , ")" ) ")") |("CONVERT" "("skipBalanced("(" , ")" )")" )  | ( [<table_or_string>  | <StringValue> | (<DECIMAL>)|(<NUMBER>) ] [("."  <column_or_string>| <NUMBER>  )] ["AND" (<DECIMAL> | <NUMBER>)] [("(" skipBalanced("(" , ")" ) ")")] )| (<default_expr> )  ]	) );
									
									
//Vis_26112026_[261101094]_Added ALTER ASSERTION
<alter_assertion>			::=	 "ALTER" "ASSERTION" [ "IF" "EXISTS" ][<name> "."] <assertion_name>
									["ENABLE"|"DISABLE"]
									["VALIDATE"|"NOVALIDATE"]			 [";"];
									
//Vis_26112026_[261101094]_Helper: assertion name
<assertion_name>			::=<name> ;									

// ALTER DIRECTIVE (NOTIFY) and ALTER DIRECTIVE (VALIDATE).
// 26ai publishes no text BNF for the NOTIFY form; its page says to give at least one of the
// ON clause, notification_columns_clause, sys_context_clause, ENABLE/DISABLE or retention_clause.
// The VALIDATE form (ALTER DIRECTIVE name ENABLE|DISABLE) is a subset of this.
//Vis_26112026_[261101095]_Added ALTER DIRECTIVE (NOTIFY and VALIDATE forms)
<alter_directive>			::= "ALTER" "DIRECTIVE" [ <schema> "." ] <notification_directive_name>
								[ "ON" ( "INSERT" | "UPDATE" | "DELETE" )+ ]
								[ <notification_columns_clause> ]
								[ <sys_context_clause> ]
								[ "ENABLE" | "DISABLE" ]
								[ <retention_clause> ] [";"] ;

//Vis_26112026_[261101095]_Helper: notification directive name
<notification_directive_name> ::= <name>;

// USING NOTIFICATION TABLE t [TABLESPACE ts] NOTIFICATION VIEW v
//Vis_26112026_[261101095]_Helper: USING NOTIFICATION TABLE ... NOTIFICATION VIEW for CREATE DIRECTIVE
<notification_using_clause>		::= "USING" "NOTIFICATION" "TABLE" <name> [ "TABLESPACE" <name> ]
									"NOTIFICATION" "VIEW" <name> ;

// [WITH {LOGGED COLUMNS (cols) [KEY (cols)] | KEY (cols)}] [{INCLUDING | EXCLUDING} OLD VALUES]
//Vis_26112026_[261101095]_Helper: WITH LOGGED COLUMNS / KEY and INCLUDING/EXCLUDING OLD VALUES for directives
<notification_columns_clause>	::= [ "WITH" ( ( "LOGGED" "COLUMNS" "(" <name_comma_list> ")" [ "KEY" "(" <name_comma_list> ")" ] )
											| ( "KEY" "(" <name_comma_list> ")" ) ) ]
									[ ( "INCLUDING" | "EXCLUDING" ) "OLD" "VALUES" ] ;

//Vis_26112026_[261101095]_Helper: CONTEXT NAMESPACE clause for directives
<sys_context_clause>			::= ( "CONTEXT" "NAMESPACE" <namespace_paramaters_list> )+ ;

// The 26ai diagram text says ATTRIBUTE; every Oracle example uses ATTRIBUTES. Both are accepted.
//Vis_26112026_[261101095]_Helper: namespace ATTRIBUTE(S) list for directives
<namespace_paramaters_list> 	::= <name> ( "ATTRIBUTES" | "ATTRIBUTE" )
									<namespace_parameter> ( "," <namespace_parameter> )* ;

//Vis_26112026_[261101095]_Helper: namespace attribute with optional length
<namespace_parameter>			::= <parameter_name> [ "(" <NUMBER> ")" ] ;

//Vis_26112026_[261101095]_Helper: RETENTION clause for directives
<retention_clause>				::=  "RETENTION" ("NONE"    | <NUMBER> ( "MINUTES" | "HOURS" | "DAYS" )) ;

//Vis_26112026_[261101092]_Added ALTER [USECASE] DOMAIN (DISPLAY, ORDER, ANNOTATIONS)
<alter_domain>					::= "ALTER" [ "USECASE" ] "DOMAIN" [ "IF" "EXISTS" ][ <schema> "." ] <domain_name>
									  ( (( "ADD" | "MODIFY" ) "DISPLAY" <display_expression>)
									   | ("DROP" "DISPLAY")
									   | (("ADD" | "MODIFY" ) "ORDER" <display_expression>)
									   | ("DROP" "ORDER")
									   | <annotations_clause> ) [";"] ;
									   
//Vis_26112026_[261101092]_Helper: domain name
<domain_name>					::=<name>;			

//Vis_26112026_[261101070]_Added ANNOTATIONS clause (contents skipped)
<annotations_clause>			::= "ANNOTATIONS" "(" skipBalanced("(",")") ")"	;	

//Vis_26112026_[261101092]_Helper: domain DISPLAY/ORDER expression
<display_expression>			::= <domain_expr>;

// CREATE DOMAIN (Oracle 23ai / 26ai). Parsed only; produces no model content.
// Flexible and multi-column forms are tried first, because the single-column form is the most permissive.
//Vis_26112026_[261101092]_Added CREATE DOMAIN (single-column, multi-column, enum and flexible forms)
<create_domain>					::= <create_flexible_domain>
									| <create_multi_column_domain>
									| <create_single_column_domain> ;

//Vis_26112026_[261101092]_Added single-column and enum CREATE DOMAIN
<create_single_column_domain>	::= "CREATE" [ "USECASE" ] "DOMAIN" [ "IF" "NOT" "EXISTS" ] [ <schema> "." ] <domain_name>
									"AS" ( <domain_enum_list> | ( <domain_datatype> [ "STRICT" ] ) )
									<domain_tail> [";"] ;

//Vis_26112026_[261101092]_Added multi-column CREATE DOMAIN
<create_multi_column_domain>	::= "CREATE" [ "USECASE" ] "DOMAIN" [ "IF" "NOT" "EXISTS" ] [ <schema> "." ] <domain_name>
									"AS" "(" <domain_column> ( "," <domain_column> )* ")"
									<domain_tail> [";"] ;

//Vis_26112026_[261101092]_Added CREATE FLEXIBLE DOMAIN
<create_flexible_domain>		::= "CREATE" [ "USECASE" ] "FLEXIBLE" "DOMAIN" [ "IF" "NOT" "EXISTS" ] [ <schema> "." ] <domain_name>
									"(" <name> ( "," <name> )* ")"
									"CHOOSE" "DOMAIN" "USING" "(" <domain_discriminant> ( "," <domain_discriminant> )* ")"
									"FROM" ( ( "DECODE" "(" skipBalanced("(",")") ")" )
										   | ( "CASE" skipBalanced("CASE","END") "END" ) )
									[ <annotations_clause> ] [";"] ;

//Vis_26112026_[261101092]_Helper: flexible domain discriminant column
<domain_discriminant>			::= <name> <domain_datatype> ;

//Vis_26112026_[261101092]_Helper: multi-column domain column
<domain_column>					::= <name> "AS" <domain_datatype> [ "STRICT" ] [ <domain_column_properties> ] [ <annotations_clause> ] ;

//Vis_26112026_[261101092]_Helper: domain datatype
<domain_datatype>				::= [ <schema> "." ] <datatype> [ "(" skipBalanced("(",")") ")" ] ;

//Vis_26112026_[261101092]_Helper: domain properties, DISPLAY, ORDER and ANNOTATIONS
<domain_tail>					::= [ <domain_column_properties> ]
									[ "DISPLAY" <domain_expr> ]
									[ "ORDER" <domain_expr> ]
									[ <annotations_clause> ] ;

//Vis_26112026_[261101092]_Helper: list of domain column properties
<domain_column_properties>		::= <domain_column_property> ( <domain_column_property> )* ;

//Vis_26112026_[261101092]_Helper: domain DEFAULT, constraint or COLLATE
<domain_column_property>		::= <domain_default_clause>
									| <domain_constraint_clause>
									| ( "COLLATE" <collation_name> ) ;

//Vis_26112026_[261101092]_Helper: domain DEFAULT [ON NULL [FOR INSERT ...]] clause
<domain_default_clause>			::= "DEFAULT" [ "ON" "NULL" [ "FOR" "INSERT" ( "ONLY" | ( "AND" "UPDATE" ) ) ] ] <domain_expr> ;

//Vis_26112026_[261101092]_Helper: domain NOT NULL / NULL / CHECK constraint
<domain_constraint_clause>		::= [ "CONSTRAINT" <name> ]
									( ( "NOT" "NULL" ) | "NULL" | ( "CHECK" "(" skipBalanced("(",")") ")" ) )
									[ <constraint_state> ] ;

//Vis_26112026_[261101092]_Helper: ENUM ( ... ) domain
<domain_enum_list>				::= "ENUM" "(" <domain_enum_item> ( "," <domain_enum_item> )* ")" ;

// enum_alias_list [= value], e.g.  New = N = 'N'
//Vis_26112026_[261101092]_Helper: enum item with aliases and value
<domain_enum_item>				::= <name> ( "=" ( <NUMBER> | <name> ) )* ;

// Display/order/default expressions: operands joined by || + - * /. Ends at the next clause keyword.
//Vis_26112026_[261101092]_Helper: domain expression
<domain_expr>					::= <domain_expr_term> ( <domain_expr_operator> <domain_expr_term> )* ;

//Vis_26112026_[261101092]_Helper: domain expression operand
<domain_expr_term>				::= ( "CASE" skipBalanced("CASE","END") "END" )
									| ( "(" skipBalanced("(",")") ")" )
									| ( <IDENTIFIER> ( "." <IDENTIFIER> )* [ "(" skipBalanced("(",")") ")" ] )
									| <NUMBER>
									| <StringValue> ;

//Vis_26112026_[261101092]_Helper: domain expression operator
<domain_expr_operator>			::= ( "|" "|" ) | "+" | "-" | "*" | "/" ;

//Vis_26112026_[261101096]_Added ALTER END USER
<alter_end_user>				::=	   "ALTER" "END" "USER" [ "IF" "EXISTS" ] <name>
									  [ "IDENTIFIED" "BY" <password> [ "REPLACE" <password> ] ]
									  [ "ADD" | "UPDATE" | "DROP" ]
									  "FACTOR" <factor> "AS" <name>
									  [ "PROFILE" <password> ]
									  [ "PASSWORD" "EXPIRE" ]
									  [ "ACCOUNT" ( "LOCK" | "UNLOCK" ) ]
									  [  ("SCHEMA" <schema>) | ("NO" "SCHEMA") ]
									  [ ("START" "TIME" <timestamp>) | ("NO" "START" "TIME") ]
									  [ ("END" "TIME" <timestamp>) | ("NO" "END" "TIME") ] [";"] ;
									  
									  
//Vis_26112026_[261101096]_Helper: START TIME / END TIME value
<timestamp>						::=( ("TIMESTAMP" <StringValue>) | <NUMBER> | <name> );

//Vis_26112026_[261101096]_Helper: end user authentication factor
<factor>						::= <name> ;

//Vis_26112026_[261101096]_Added CREATE END USER
<create_end_user>				::=	   "CREATE" "END" "USER" [ "IF" "NOT" "EXISTS" ] <name>
										  [ "IDENTIFIED" "BY" <password> ]
										  "ADD" "FACTOR" <factor> "AS" <name>
										  [ "PROFILE" <name> ]
										  [ "PASSWORD" "EXPIRE" ]
										  [ "ACCOUNT" ( "LOCK" | "UNLOCK" ) ]
										  [ "SCHEMA" <schema> ]
										  [ "START" "TIME" <timestamp> ]
										  [ "END" "TIME" <timestamp> ] [";"] ;

// The JSON schema is a single-quoted string literal: '{ ... }'
//Vis_26112026_[261101097]_Added CREATE [OR REPLACE] END USER CONTEXT ... USING JSON SCHEMA
<create_end_user_context>		::=	   "CREATE" [ "OR" "REPLACE" ] "END" "USER" "CONTEXT" [ "IF" "NOT" "EXISTS" ]
										  [ <schema> "." ] <name>
										  "USING" "JSON" "SCHEMA" <StringValue> [";"] ;

// Column may be written bare (as in the syntax diagram) or in parentheses (as in Oracle's examples).
//Vis_26112026_[261101098]_Added CREATE HYBRID VECTOR INDEX
<create_hybrid_vector_index>	::=	   "CREATE" "HYBRID" "VECTOR" "INDEX" [ <schema> "." ] <index_name>
										  "ON" [ <schema> "." ] <table>
										  ( ( "(" skipBalanced("(",")") ")" ) | <name> )
										  "PARAMETERS" "(" skipBalanced("(",")") ")" [";"] ;

// ---------------------------------------------------------------------------
// Oracle 26ai: AUDIT / NOAUDIT, SAVEPOINT, data roles, data grants, end user context
// Parsed only; no model content.
// ---------------------------------------------------------------------------

//Vis_26112026_[261101073]_Helper: comma-separated name list (also used by directive, audit and data grant rules)
<name_comma_list>				::= <name> ( "," <name> )* ;

// AUDIT (Unified Auditing). Traditional AUDIT is desupported in 23ai/26ai.
//Vis_26112026_[261101099]_Added AUDIT (Unified Auditing: POLICY and CONTEXT NAMESPACE forms)
<audit_command>					::= "AUDIT" ( <audit_policy_clause> | <audit_context_clause> ) [";"] ;

//Vis_26112026_[261101099]_Helper: AUDIT POLICY clause
<audit_policy_clause>			::= "POLICY" <name>
									[ <by_users_with_roles> | ( "BY" <name_comma_list> ) | ( "EXCEPT" <name_comma_list> ) ]
									[ <audit_whenever_clause> ] ;

//Vis_26112026_[261101099]_Helper: BY USERS WITH GRANTED ROLES
<by_users_with_roles>			::= "BY" "USERS" "WITH" "GRANTED" "ROLES" <name_comma_list> ;

//Vis_26112026_[261101099]_Helper: WHENEVER [NOT] SUCCESSFUL
<audit_whenever_clause>			::= "WHENEVER" [ "NOT" ] "SUCCESSFUL" ;

// CONTEXT NAMESPACE ns ATTRIBUTES a [, a]... [, CONTEXT NAMESPACE ns ATTRIBUTES a [, a]...]... [BY user [, user]...]
//Vis_26112026_[261101099]_Helper: AUDIT/NOAUDIT CONTEXT NAMESPACE clause
<audit_context_clause>			::= "CONTEXT" "NAMESPACE" <name> "ATTRIBUTES" <name>
									( "," ( ( "CONTEXT" "NAMESPACE" <name> "ATTRIBUTES" <name> ) | <name> ) )*
									[ "BY" <name_comma_list> ]
									[ <audit_whenever_clause> ] ;

// NOAUDIT (Unified Auditing) and NOAUDIT (Traditional Auditing)
//Vis_26112026_[261101100]_Added NOAUDIT (Unified and Traditional Auditing)
<noaudit_command>				::= "NOAUDIT"
									( ( "POLICY" <name> [ <by_users_with_roles> | ( "BY" <name_comma_list> ) ] )
									| <audit_context_clause>
									| <noaudit_traditional> ) [";"] ;

//Vis_26112026_[261101100]_Helper: NOAUDIT traditional auditing forms
<noaudit_traditional>			::= ( "NETWORK"
									| ( "DIRECT_PATH" "LOAD" [ "BY" <name_comma_list> ] )
									| ( skip( "BY" | "ON" | "WHENEVER" | "CONTAINER" | ";" )
										[ ( "ON" <noaudit_on_target> ) | ( "BY" <name_comma_list> ) ] ) )
									[ <audit_whenever_clause> ]
									[ "CONTAINER" "=" ( "CURRENT" | "ALL" ) ] ;

//Vis_26112026_[261101100]_Helper: NOAUDIT ... ON object target
<noaudit_on_target>				::= ( "DIRECTORY" <name> )
									| ( "MINING" "MODEL" [ <schema> "." ] <name> )
									| ( "SQL" "TRANSLATION" "PROFILE" [ <schema> "." ] <name> )
									| "DEFAULT"
									| ( [ <schema> "." ] <name> ) ;

//Vis_26112026_[261101101]_Added SAVEPOINT
<savepoint_command>				::= "SAVEPOINT" <name> [";"] ;

//Vis_26112026_[261101102]_Added GRANT DATA ROLE
<grant_data_role>				::= "GRANT" "DATA" "ROLE" [ "IF" "EXISTS" ] <name_comma_list>
									"TO" <name_comma_list>
									[ "START" "TIME" <timestamp> ]
									[ "END" "TIME" <timestamp> ] [";"] ;

//Vis_26112026_[261101102]_Added REVOKE DATA ROLE
<revoke_data_role>				::= "REVOKE" "DATA" "ROLE" [ "IF" "EXISTS" ] <name_comma_list>
									"FROM" <name_comma_list> [";"] ;

//Vis_26112026_[261101102]_Added SET USE DATA GRANTS ONLY
<set_use_data_grants_only>		::= "SET" "USE" "DATA" "GRANTS" "ONLY" "ON" [ <schema> "." ] <name>
									[ "ENABLED" | "DISABLED" ] [";"] ;

// UPDATE END_USER_CONTEXT t SET t.CONTEXT.attribute = value WHERE OWNER = owner AND NAME = name
//Vis_26112026_[261101097]_Added UPDATE END_USER_CONTEXT
<update_end_user_context>		::= "UPDATE" "END_USER_CONTEXT" <name>
									"SET" <name> "." "CONTEXT" "." <name> "=" <end_user_context_value>
									"WHERE" <name> "=" <end_user_context_value>
									"AND" <name> "=" <end_user_context_value> [";"] ;

//Vis_26112026_[261101097]_Helper: end user context value
<end_user_context_value>		::= <NUMBER> | <StringValue> | <name> ;

// ---------------------------------------------------------------------------
// Oracle 26ai: new CREATE / ALTER statements. Parsed only; no model content.
// ---------------------------------------------------------------------------

// CREATE JSON [RELATIONAL] DUALITY VIEW - SQL form (SELECT JSON {...} FROM ...) or GraphQL form.
//Vis_26112026_[261101103]_Added CREATE JSON [RELATIONAL] DUALITY VIEW (SQL and GraphQL forms)
<create_json_duality_view>		::= "CREATE" [ "OR" "REPLACE" ] [ [ "NO" ] "FORCE" ] [ "EDITIONABLE" | "NONEDITIONABLE" ]
									"JSON" [ "RELATIONAL" ] "DUALITY" "VIEW" [ "IF" "NOT" "EXISTS" ]
									[ <schema> "." ] <name> "AS"
									( <duality_view_sql_body> | <duality_view_graphql_body> ) [";"] ;

//Vis_26112026_[261101103]_Helper: duality view SQL body (SELECT JSON {...} FROM ...)
<duality_view_sql_body>			::= "SELECT" "JSON" "{" skipBalanced("{","}") "}"
									"FROM" [ <schema> "." ] <name>
									[ <duality_table_tags> | ( <name> [ <duality_table_tags> ] ) ] ;

// WITH { {CHECK|NOCHECK} [ETAG] | INSERT | NOINSERT | UPDATE | NOUPDATE | DELETE | NODELETE }...
// Oracle's developer guide also shows the parenthesized form WITH (UPDATE, INSERT, DELETE).
//Vis_26112026_[261101103]_Helper: duality view WITH table tags
<duality_table_tags>			::= "WITH" ( ( "(" skipBalanced("(",")") ")" ) | <duality_table_tag> ( <duality_table_tag> )* ) ;

//Vis_26112026_[261101103]_Helper: one duality view table tag
<duality_table_tag>				::= ( ( "CHECK" | "NOCHECK" ) [ "ETAG" ] )
									| "INSERT" | "NOINSERT" | "UPDATE" | "NOUPDATE" | "DELETE" | "NODELETE" ;

// graphql_object_name [ (arguments) ] [ @directive... ] { selection } | [ { selection } ]
//Vis_26112026_[261101103]_Helper: duality view GraphQL body
<duality_view_graphql_body>		::= <name> [ "." <name> ] [ "(" skipBalanced("(",")") ")" ]
									( <graphql_directive> )*
									( ( "{" skipBalanced("{","}") "}" )
									| ( "[" "{" skipBalanced("{","}") "}" "]" ) ) ;

//Vis_26112026_[261101103]_Helper: GraphQL @directive
<graphql_directive>				::= "@" <IDENTIFIER> [ "(" skipBalanced("(",")") ")" ] ;

//Vis_26112026_[261101103]_Added ALTER JSON [RELATIONAL] DUALITY VIEW ENABLE/DISABLE LOGICAL REPLICATION
<alter_json_duality_view>		::= "ALTER" "JSON" [ "RELATIONAL" ] "DUALITY" "VIEW" [ "IF" "EXISTS" ]
									[ <schema> "." ] <name>
									( "ENABLE" | "DISABLE" ) "LOGICAL" "REPLICATION" [";"] ;

// CREATE PROPERTY GRAPH. Oracle's examples put a comma between the VERTEX and EDGE table lists.
//Vis_26112026_[261101104]_Added CREATE PROPERTY GRAPH
<create_property_graph>			::= "CREATE" [ "OR" "REPLACE" ] "PROPERTY" "GRAPH" [ "IF" "NOT" "EXISTS" ]
									[ <schema> "." ] <name>
									"VERTEX" "TABLES" "(" skipBalanced("(",")") ")"
									[ [ "," ] "EDGE" "TABLES" "(" skipBalanced("(",")") ")" ]
									[ "OPTIONS" "(" skipBalanced("(",")") ")" ] [";"] ;

//Vis_26112026_[261101105]_Added CREATE MLE ENV
<create_mle_env>				::= "CREATE" [ "OR" "REPLACE" ] "MLE" "ENV" [ "IF" "NOT" "EXISTS" ] [ <schema> "." ] <name>
									[ ( "CLONE" [ <schema> "." ] <name> )
									| ( [ "IMPORTS" "(" skipBalanced("(",")") ")" ] [ "LANGUAGE" "OPTIONS" <StringValue> ] ) ]
									[ "PURE" ] [";"] ;

// CREATE MLE MODULE. With AS, the module text (JavaScript) runs to the SQL*Plus "/" terminator line.
//Vis_26112026_[261101105]_Added CREATE MLE MODULE
<create_mle_module>				::= "CREATE" [ "OR" "REPLACE" ] "MLE" "MODULE" [ "IF" "NOT" "EXISTS" ] [ <schema> "." ] <name>
									"LANGUAGE" <name> [ "VERSION" <StringValue> ]
									( ( "USING" "BFILE" "(" skipBalanced("(",")") ")" )
									| ( "USING" ( "CLOB" | "BLOB" | "BFILE" ) ( ( "(" skipBalanced("(",")") ")" ) | skip(";") ) )
									| ( "AS" skip("/") "/" ) ) [";"] ;

// Not referenced by any rule: these literals only make keywords() produce tokens for characters
// that occur in MLE JavaScript module text (template strings `...${x}...`), so the lexer can read them.
//Vis_26112026_[261101105]_Added lexer tokens for MLE JavaScript module text
<mle_module_text_tokens>		::= "`" | "$" ;

//Vis_26112026_[261101106]_Added CREATE VECTOR INDEX
<create_vector_index>			::= "CREATE" "VECTOR" "INDEX" [ <schema> "." ] <name>
									"ON" [ <schema> "." ] <name> "(" skipBalanced("(",")") ")"
									[ "INCLUDE" "(" skipBalanced("(",")") ")" ]
									[ "GLOBAL" ]
									[ <vector_index_organization_clause> ]
									[ "QUANTIZATION" <name> "COMPRESSION" "RATIO" <NUMBER> ]
									[ "WITH" "TARGET" "ACCURACY" <NUMBER> ]
									[ "PARAMETERS" "(" skipBalanced("(",")") ")" ]
									[ <vector_index_replication_clause> ]
									[ "PARALLEL" <NUMBER> ]
									[ "ONLINE" ] [ "LOCAL" ] [";"] ;

//Vis_26112026_[261101106]_Helper: vector index ORGANIZATION clause
<vector_index_organization_clause> ::= "ORGANIZATION" ( ( "INMEMORY" [ "NEIGHBOR" ] "GRAPH" ) | ( [ "NEIGHBOR" ] "PARTITIONS" ) )
									[ [ "WITH" ] "DISTANCE" <name> ] ;

//Vis_26112026_[261101106]_Helper: vector index DUPLICATE/DISTRIBUTE clause
<vector_index_replication_clause> ::= ( "DUPLICATE" "ALL" )
									| ( "DISTRIBUTE" ( "AUTO" | ( "BY" ( ( "ROWID" "RANGE" ) | "PARTITION" | "SUBPARTITION" ) ) ) ) ;

//Vis_26112026_[261101093]_Added CREATE ICEBERG TABLE
<create_iceberg_table>			::= "CREATE" "ICEBERG" "TABLE" [ <schema> "." ] <name> "(" skipBalanced("(",")") ")"
									"WITHIN" "CATALOG" <name>
									"STORAGE" "LOCATION" <StringValue>
									"PARTITION" "BY" <iceberg_partition_transform> ( "," <iceberg_partition_transform> )* [";"] ;

//Vis_26112026_[261101093]_Helper: Iceberg partition transform
<iceberg_partition_transform>	::= ( ( "YEAR" | "MONTH" | "DAY" | "HOUR" ) "(" <name> ")" )
									| ( "BUCKET" "(" <NUMBER> "," <name> ")" ) ;

//Vis_26112026_[261101107]_Added CREATE LOGICAL PARTITION TRACKING
<create_logical_partition_tracking> ::= "CREATE" "LOGICAL" "PARTITION" "TRACKING" "ON" [ <schema> "." ] <name>
									"PARTITION" "BY" "RANGE" "(" skipBalanced("(",")") ")"
									[ "INTERVAL" "(" skipBalanced("(",")") ")" ]
									"(" skipBalanced("(",")") ")" [";"] ;

// CREATE MACRO: the scalar expression or subquery body runs to the statement terminator.
//Vis_26112026_[261101108]_Added CREATE MACRO
<create_macro>					::= "CREATE" [ "OR" "REPLACE" ] "MACRO" [ "IF" "NOT" "EXISTS" ] [ <schema> "." ] <name>
									[ "(" skipBalanced("(",")") ")" ]
									[ "ON" [ <schema> "." ] <name> ]
									( "AS" | "IS" ) skip(";") [";"] ;

//Vis_26112026_[261101108]_Added ALTER MACRO ... COMPILE
<alter_macro>					::= "ALTER" "MACRO" [ "IF" "EXISTS" ] [ <schema> "." ] <name> "COMPILE" [";"] ;

//Vis_26112026_[261101109]_Added CREATE TRUE CACHE
<create_true_cache>				::= "CREATE" "TRUE" "CACHE" [";"] ;



//Vis_26112026_[261101105]_Added ALTER MLE ENV
<alter_mle_env>					::= "ALTER" "MLE" "ENV" [ "IF" "EXISTS" ] [<schema> "."] <name>
									  (	 		( "ADD" "IMPORTS" "("  skipBalanced("(",")") ")")
											| 	( "DROP" "IMPORTS" "(" skipBalanced("(",")") ")")
											| 	( "ALTER" "IMPORTS" "(" skipBalanced("(",")") ")" )
											| 	("SET" "LANGUAGE" "OPTIONS" <option_string>)
											| ("COMPILE")
									   )  [";"] ;

//Vis_26112026_[261101105]_Helper: MLE ENV language option string
<option_string>					::= <name>;


//Vis_26112026_[261101105]_Added ALTER MLE MODULE ... SET METADATA
<alter_mle_module>				::= "ALTER" "MLE" "MODULE" [ "IF" "EXISTS" ] [<schema> "."] <name> "SET" "METADATA" "USING" "CLOB" ( ( "(" skipBalanced("(",")") ")" ) | <StringValue> | <name> ) [";"] ;


//Vis_26112026_[261101104]_Added ALTER PROPERTY GRAPH ... COMPILE
<alter_property_graph>			::= "ALTER" "PROPERTY" "GRAPH" [ "IF" "EXISTS" ] [ <schema>"."] <name> "COMPILE" [";"] ;


//Vis_26112026_[261101110]_Added CREATE APPLICATION IDENTITY
<create_application_Identity>	::= "CREATE" [ "OR" "REPLACE" ] "APPLICATION" "IDENTITY" ["IF" "NOT" "EXISTS" ]
										<name>  "MAPPED" "TO" <StringValue> [";"] ;
										
//Vis_26112026_[261101094]_Added CREATE ASSERTION
<create_assertion>				::=	"CREATE" "ASSERTION" [ "IF" "NOT" "EXISTS" ] [ <schema> "."]<name>
										"CHECK" "(" skipBalanced( "(",")" ) ")"
										[ <assertions_constraint_state> ]	 [";"] ;
										
// The 26ai BNF spells DEFERABLE; Oracle's examples (and the database) use DEFERRABLE. Both accepted.
// Every part is optional so that e.g. "... ) NOVALIDATE" or "... ) DISABLE" parse.
//Vis_26112026_[261101094]_Helper: assertion constraint state
<assertions_constraint_state>	::= 	[ ( [ "NOT" ] <assertion_deferrable> [ "INITIALLY" ( "DEFERRED" | "IMMEDIATE" ) ] )
										| ( "INITIALLY" [ "DEFERRED" | "IMMEDIATE" ] [ [ "NOT" ] <assertion_deferrable> ] ) ]
											[ "ENABLE" | "DISABLE" ]  [ "VALIDATE" | "NOVALIDATE" ]	  ;

//Vis_26112026_[261101094]_Helper: DEFERRABLE / DEFERABLE keyword
<assertion_deferrable>			::= "DEFERRABLE" | "DEFERABLE" ;

//Vis_26112026_[261101102]_Added CREATE DATA GRANT
<create_data_grant>				::= 	"CREATE" ["OR" "REPLACE" ] "DATA" "GRANT" [ "IF" "NOT" "EXISTS" ]
										  [ <schema> "." ] <name> "AS" <privilege_list>
										  "ON" [ <schema> "." ] <name>
										  [ "WHERE" <predicate> ]
										  "TO" <name_comma_list>
										  [ "START" "TIME" <timestamp> ]
										  [ "END" "TIME" <timestamp> ] [";"] ;

//Vis_26112026_[261101102]_Helper: data grant privilege list
<privilege_list>				::=		<privilege_item> ("," <privilege_item>)*;

// privilege [ ( [ ALL COLUMNS EXCEPT ] column [, column]... ) ]
//Vis_26112026_[261101102]_Helper: data grant privilege with optional column list
<privilege_item>				::=		<privilege> [ "(" [ "ALL" "COLUMNS" "EXCEPT" ] <name_comma_list> ")" ] ;

//Vis_26112026_[261101102]_Helper: data grant privilege
<privilege>						::= ("SELECT"|"UPDATE"|"INSERT"|"DELETE") ;

// Data grant predicate: free SQL condition, consumed up to the TO keyword.
//Vis_26112026_[261101102]_Helper: data grant WHERE predicate
<predicate>						::= skip("TO") ;


//Vis_26112026_[261101102]_Added CREATE DATA ROLE
<create_data_role>				::= "CREATE" [ "OR" "REPLACE" ] "DATA" "ROLE" [ "IF" "NOT" "EXISTS" ] <name>
									(  <external_role_clause> | <local_role_clause>) [";"] ;

//Vis_26112026_[261101102]_Helper: data role MAPPED TO clause
<external_role_clause>			::= "MAPPED" "TO" <StringValue> ;

//Vis_26112026_[261101102]_Helper: local data role ENABLED/DISABLED
<local_role_clause>				::= ["ENABLED"|"DISABLED"];

// CREATE DIRECTIVE: VALIDATE form (OR REPLACE allowed) is tried before the NOTIFY form.
//Vis_26112026_[261101095]_Added CREATE DIRECTIVE (VALIDATE and NOTIFY forms)
<create_directive>				::= <create_directive_validate> | <create_directive_notify> ;

// CREATE DIRECTIVE (NOTIFY). The BNF has no schema prefixes, but Oracle's examples use them.
//Vis_26112026_[261101095]_Added CREATE DIRECTIVE (NOTIFY)
<create_directive_notify>		::=  "CREATE" "DIRECTIVE" [ <schema> "." ] <notification_directive_name>
									"FOR" ( <table_notification_clause> | <json_relational_duality_view_clause> ) [";"];

//Vis_26112026_[261101095]_Helper: NOTIFY clause for a table
<table_notification_clause>		::= [ <schema> "." ] <name> "NOTIFY" [ "ON" ( "INSERT" | "UPDATE" | "DELETE" )+ ]
									  <notification_using_clause>
									  <notification_columns_clause>
									  [ <sys_context_clause> ]
									  [ "ENABLE" | "DISABLE" ]
									  [ <retention_clause> ] ;

//Vis_26112026_[261101095]_Helper: NOTIFY clause for a JSON relational duality view
<json_relational_duality_view_clause>	::=	[ <schema> "." ] <name> "NOTIFY" [ "ON" ( "INSERT" | "UPDATE" | "DELETE" )+ ]
											  <notification_using_clause>
											  [ <sys_context_clause> ]
											  [ "ENABLE" | "DISABLE" ]
											  [ <retention_clause> ] ;

// CREATE DIRECTIVE (VALIDATE)
//Vis_26112026_[261101095]_Added CREATE [OR REPLACE] DIRECTIVE (VALIDATE)
<create_directive_validate>		::= "CREATE" [ "OR" "REPLACE" ] "DIRECTIVE" [ <schema> "." ] <name>
									"FOR" [ <schema> "." ] <name>
									"VALIDATE" "ON" <directive_action_list>
									<directive_processing_clause>
									[ "VALIDATE" | "NOVALIDATE" ] [ "ENABLE" | "DISABLE" ]
									<directive_using_clause> [";"] ;

//Vis_26112026_[261101095]_Helper: VALIDATE ON action list
<directive_action_list>			::= ( "SELECT" [ "INSERT" | "UPDATE" ] )
									| ( "INSERT" [ "UPDATE" ] )
									| ( "UPDATE" [ "SELECT" ] ) ;

//Vis_26112026_[261101095]_Helper: BEFORE OBJECT / AFTER OBJECT / ON COMMIT
<directive_processing_clause>	::= ( "BEFORE" "OBJECT" ) | ( "AFTER" "OBJECT" ) | ( "ON" "COMMIT" ) ;

// USING { expr | plsql_anonymous_block | plsql_function }
//Vis_26112026_[261101095]_Helper: directive USING expression or PL/SQL block
<directive_using_clause>		::= "USING" ( ( [ "DECLARE" skip("BEGIN") ] "BEGIN" skipBalanced("BEGIN", ( "END" ";" )) "END" ";" )
											| skip(";") ) ;
