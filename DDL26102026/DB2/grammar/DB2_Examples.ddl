 (IN  phoneNo VARCHAR(20),
  IN  regionNo VARCHAR(8),
  OUT full_phone_xml XML)
 RETURNS VARCHAR(28)
 LANGUAGE SQL
 NO EXTERNAL ACTION
 BEGIN
   SET full_phone_xml = XMLELEMENT (NAME "phone", regionNo || phoneNo);
   RETURN regionNo || phoneNo;
 END
 
