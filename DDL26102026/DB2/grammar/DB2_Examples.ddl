 BEGIN
       DECLARE not_found CONDITION FOR SQLSTATE '02000';
       DECLARE EXIT HANDLER FOR not_found
         SET rating = -1;
       IF rating = 1
         THEN UPDATE employee
         SET salary = salary * 1.10, bonus = 1000
         WHERE empno = employee_number;
       ELSEIF rating = 2
         THEN UPDATE employee
         SET salary = salary * 1.05, bonus = 500
         WHERE empno = employee_number;
       ELSE UPDATE employee
         SET salary = salary * 1.03, bonus = 0
         WHERE empno = employee_number;
       END IF;
     END   
	 
   CREATE PROCEDURE ITERATOR()
     LANGUAGE SQL
     BEGIN
       DECLARE v_dept CHAR(3);
       DECLARE v_deptname VARCHAR(29);
       DECLARE v_admdept CHAR(3);
       DECLARE at_end INTEGER DEFAULT 0;
       DECLARE not_found CONDITION FOR SQLSTATE '02000';
       DECLARE c1 CURSOR FOR
         SELECT deptno, deptname, admrdept
         FROM department
         ORDER BY deptno;
       DECLARE CONTINUE HANDLER FOR not_found
         SET at_end = 1;
       OPEN c1;
       ins_loop:
       LOOP
         FETCH c1 INTO v_dept, v_deptname, v_admdept;
         IF at_end = 1 THEN
           LEAVE ins_loop;
         ELSEIF v_dept = 'D11' THEN
           ITERATE ins_loop;
         END IF;
         INSERT INTO department (deptno, deptname, admrdept)
         VALUES ('NEW', v_deptname, v_admdept);
       END LOOP;
       CLOSE c1;
     END	 
	 
 BEGIN
       DECLARE v_counter INTEGER;
       DECLARE v_firstnme VARCHAR(12);
       DECLARE v_midinit CHAR(1);
       DECLARE v_lastname VARCHAR(15);
       DECLARE at_end SMALLINT DEFAULT 0;
       DECLARE not_found CONDITION FOR SQLSTATE '02000';
       DECLARE c1 CURSOR FOR
         SELECT firstnme, midinit, lastname
           FROM employee;
       DECLARE CONTINUE HANDLER for not_found
         SET at_end = 1;
       SET v_counter = 0;
       OPEN c1;
       fetch_loop:
       LOOP
         FETCH c1 INTO v_firstnme, v_midinit, v_lastname;
         IF at_end <> 0 THEN LEAVE fetch_loop;
         END IF;
         SET v_counter = v_counter + 1;
       END LOOP fetch_loop;
       SET counter = v_counter;
       CLOSE c1;
     END	 
	 
 BEGIN
       DECLARE v_numRecords INTEGER DEFAULT 1;
       DECLARE v_counter INTEGER DEFAULT 0;
       DECLARE c1 CURSOR FOR
         SELECT CAST(salary AS DOUBLE)
           FROM staff
           WHERE DEPT = deptNumber
           ORDER BY salary;
       DECLARE EXIT HANDLER FOR NOT FOUND
         SET medianSalary = 6666;
       SET medianSalary = 0;
       SELECT COUNT(*) INTO v_numRecords
         FROM staff
         WHERE DEPT = deptNumber;
       OPEN c1;
       WHILE v_counter < (v_numRecords / 2 + 1) DO
         FETCH c1 INTO medianSalary;
         SET v_counter = v_counter + 1;
       END WHILE;
       CLOSE c1;
     END

BEGIN
   DECLARE WN INTEGER DEFAULT 1;
   DECLARE WND DATE;
   SET WND = START_TS;
   WHILE (WN < 53) DO
      SET WND = WND + 7 DAYS;
      PIPE (WN, WND, WEEK_ISO(WND));
      SET WN = WN + 1;
   END WHILE;
   RETURN;
END	 

BEGIN COMPOUND ATOMIC STATIC
     UPDATE ACCOUNTS SET ABALANCE = ABALANCE + delta 
       WHERE AID = aid;
     UPDATE TELLERS SET TBALANCE = TBALANCE + delta
       WHERE TID = tid;
     INSERT INTO TELLERS (TID, BID, TBALANCE) VALUES (:i, :branch_id, 0);
     COMMIT;
   END COMPOUND;
   
   
   CREATE VIEW DB2ADMIN.CURRENTQUOTE_VIEW AS
SELECT 
    SYMBOL,
    QUOTE,
    STATUS,
    UPDATED_AT
FROM CURRENTQUOTEs;

CREATE TABLE DB2ADMIN.CURRENTQUOTEs (
    SYMBOL VARCHAR(10) NOT NULL,       -- Stock symbol
    QUOTE DECIMAL(10, 2) NOT NULL,    -- Current quote value
    STATUS VARCHAR(10),               -- Status of the stock
    UPDATED_AT TIMESTAMP DEFAULT CURRENT TIMESTAMP, -- Last updated timestamp
    PRIMARY KEY (SYMBOL)
);

-- ============================================================
-- DB2 11.5 - ALTER TABLE TEST SCRIPT
-- Based on the Db2 11.5 ALTER TABLE syntax diagram
-- ============================================================


-- ============================================================
-- BASE TABLES
-- ============================================================

CREATE TABLE test_parent (
    id INTEGER NOT NULL PRIMARY KEY,
    code VARCHAR(30) UNIQUE
);

CREATE TABLE test_alter (
    id INTEGER,
    code VARCHAR(30),
    amount DECIMAL(10,2),
    quantity INTEGER,
    name VARCHAR(100),
    status VARCHAR(20),
    parent_id INTEGER
);


-- ============================================================
-- 1. ADD COLUMN
-- column-definition
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_integer INTEGER;

ALTER TABLE test_alter
    ADD COLUMN new_decimal DECIMAL(10,2);


-- ============================================================
-- 2. ADD COLUMN - NOT NULL
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_required INTEGER NOT NULL;


-- ============================================================
-- 3. ADD COLUMN - UNIQUE
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_unique VARCHAR(30)
        CONSTRAINT uq_new_unique UNIQUE;


-- ============================================================
-- 4. ADD COLUMN - PRIMARY KEY
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_pk INTEGER
        CONSTRAINT pk_new_pk PRIMARY KEY;


-- ============================================================
-- 5. ADD COLUMN - FOREIGN KEY / REFERENCES
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_parent INTEGER
        CONSTRAINT fk_new_parent
        REFERENCES test_parent(id);


-- ============================================================
-- 6. ADD COLUMN - FOREIGN KEY + ON DELETE
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_parent_delete INTEGER
        CONSTRAINT fk_new_parent_delete
        REFERENCES test_parent(id)
        ON DELETE CASCADE;


-- ============================================================
-- 7. ADD COLUMN - FOREIGN KEY + ON UPDATE
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_parent_update INTEGER
        CONSTRAINT fk_new_parent_update
        REFERENCES test_parent(id)
        ON UPDATE RESTRICT;


-- ============================================================
-- 8. ADD COLUMN - CHECK
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_check INTEGER
        CONSTRAINT chk_new_check
        CHECK (new_check IS NULL OR new_check >= 0);


-- ============================================================
-- 9. ADD COLUMN - DEFAULT constant
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_default INTEGER
        DEFAULT 100;


-- ============================================================
-- 10. ADD COLUMN - DEFAULT NULL
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_default_null INTEGER
        DEFAULT NULL;


-- ============================================================
-- 11. ADD COLUMN - DEFAULT CURRENT USER
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_user VARCHAR(128)
        DEFAULT CURRENT USER;


-- ============================================================
-- 12. ADD COLUMN - DEFAULT CURRENT SCHEMA
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_schema VARCHAR(128)
        DEFAULT CURRENT SCHEMA;


-- ============================================================
-- 13. ADD COLUMN - GENERATED ALWAYS
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_generated INTEGER
        GENERATED ALWAYS AS (quantity * 10);


-- ============================================================
-- 14. ADD COLUMN - GENERATED BY DEFAULT
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_generated_default INTEGER
        GENERATED BY DEFAULT AS (quantity * 20);


-- ============================================================
-- 15. ADD COLUMN - SECURITY LABEL
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_secure VARCHAR(50)
        SECURED WITH CONFIDENTIAL;


-- ============================================================
-- 16. ADD COLUMN - NOT HIDDEN
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_visible INTEGER
        NOT HIDDEN;


-- ============================================================
-- 17. ADD COLUMN - IMPLICITLY HIDDEN
-- ============================================================

ALTER TABLE test_alter
    ADD COLUMN new_hidden INTEGER
        IMPLICITLY HIDDEN;


-- ============================================================
-- 18. ADD TABLE-LEVEL PRIMARY KEY
-- ============================================================

ALTER TABLE test_alter
    ADD CONSTRAINT pk_test_alter
        PRIMARY KEY (id);


-- ============================================================
-- 19. ADD TABLE-LEVEL UNIQUE
-- ============================================================

ALTER TABLE test_alter
    ADD CONSTRAINT uq_test_alter_code
        UNIQUE (code);


-- ============================================================
-- 20. ADD TABLE-LEVEL CHECK
-- ============================================================

ALTER TABLE test_alter
    ADD CONSTRAINT chk_test_alter_amount
        CHECK (amount IS NULL OR amount >= 0);


-- ============================================================
-- 21. ADD TABLE-LEVEL FOREIGN KEY
-- ============================================================

ALTER TABLE test_alter
    ADD CONSTRAINT fk_test_alter_parent
        FOREIGN KEY (parent_id)
        REFERENCES test_parent(id);


-- ============================================================
-- 22. ALTER FOREIGN KEY
-- ============================================================

ALTER TABLE test_alter
    ALTER FOREIGN KEY fk_test_alter_parent
        ENFORCED;


-- ============================================================
-- 23. ALTER CHECK CONSTRAINT
-- ============================================================

ALTER TABLE test_alter
    ALTER CHECK chk_test_alter_amount
        ENFORCED;


-- ============================================================
-- 24. ALTER COLUMN - SET DATA TYPE
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN amount
        SET DATA TYPE DECIMAL(12,2);


-- ============================================================
-- 25. ALTER COLUMN - SET NOT NULL
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN name
        SET NOT NULL;


-- ============================================================
-- 26. ALTER COLUMN - DROP NOT NULL
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN name
        DROP NOT NULL;


-- ============================================================
-- 27. ALTER COLUMN - SET DEFAULT
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN amount
        SET DEFAULT 100;


-- ============================================================
-- 28. ALTER COLUMN - DROP DEFAULT
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN amount
        DROP DEFAULT;


-- ============================================================
-- 29. RENAME COLUMN
-- ============================================================

ALTER TABLE test_alter
    RENAME COLUMN name
    TO customer_name;


-- ============================================================
-- 30. DROP COLUMN
-- ============================================================

ALTER TABLE test_alter
    DROP COLUMN new_integer;


-- ============================================================
-- 31. DROP COLUMN CASCADE
-- ============================================================

ALTER TABLE test_alter
    DROP COLUMN new_decimal CASCADE;


-- ============================================================
-- 32. DROP COLUMN RESTRICT
-- ============================================================

ALTER TABLE test_alter
    DROP COLUMN new_default RESTRICT;


-- ============================================================
-- 33. DROP PRIMARY KEY
-- ============================================================

ALTER TABLE test_alter
    DROP PRIMARY KEY;


-- ============================================================
-- 34. DROP FOREIGN KEY
-- ============================================================

ALTER TABLE test_alter
    DROP FOREIGN KEY fk_test_alter_parent;


-- ============================================================
-- 35. DROP UNIQUE
-- ============================================================

ALTER TABLE test_alter
    DROP UNIQUE uq_test_alter_code;


-- ============================================================
-- 36. DROP CHECK
-- ============================================================

ALTER TABLE test_alter
    DROP CHECK chk_test_alter_amount;


-- ============================================================
-- 37. DROP CONSTRAINT
-- ============================================================

ALTER TABLE test_alter
    DROP CONSTRAINT pk_test_alter;


-- ============================================================
-- 38. DROP DISTRIBUTION
-- ============================================================

ALTER TABLE test_alter
    DROP DISTRIBUTION;


-- ============================================================
-- 39. ADD PERIOD
-- ============================================================

ALTER TABLE test_alter
    ADD PERIOD SYSTEM_TIME
        (period_start, period_end);


-- ============================================================
-- 40. DROP PERIOD
-- ============================================================

ALTER TABLE test_alter
    DROP PERIOD SYSTEM_TIME;


-- ============================================================
-- 41. DATA CAPTURE NONE
-- ============================================================

ALTER TABLE test_alter
    DATA CAPTURE NONE;


-- ============================================================
-- 42. DATA CAPTURE CHANGES
-- ============================================================

ALTER TABLE test_alter
    DATA CAPTURE CHANGES;


-- ============================================================
-- 43. DATA CAPTURE CHANGES INCLUDE LONGVAR COLUMNS
-- ============================================================

ALTER TABLE test_alter
    DATA CAPTURE CHANGES
        INCLUDE LONGVAR COLUMNS;


-- ============================================================
-- 44. ACTIVATE NOT LOGGED INITIALLY
-- ============================================================

ALTER TABLE test_alter
    ACTIVATE NOT LOGGED INITIALLY;


-- ============================================================
-- 45. ACTIVATE NOT LOGGED INITIALLY WITH EMPTY TABLE
-- ============================================================

ALTER TABLE test_alter
    ACTIVATE NOT LOGGED INITIALLY
        WITH EMPTY TABLE;


-- ============================================================
-- 46. PCTFREE
-- ============================================================

ALTER TABLE test_alter
    PCTFREE 10;


-- ============================================================
-- 47. LOCKSIZE ROW
-- ============================================================

ALTER TABLE test_alter
    LOCKSIZE ROW;


-- ============================================================
-- 48. APPEND ON
-- ============================================================

ALTER TABLE test_alter
    APPEND ON;


-- ============================================================
-- 49. APPEND OFF
-- ============================================================

ALTER TABLE test_alter
    APPEND OFF;


-- ============================================================
-- 50. VOLATILE
-- ============================================================

ALTER TABLE test_alter
    VOLATILE;


-- ============================================================
-- 51. NOT VOLATILE
-- ============================================================

ALTER TABLE test_alter
    NOT VOLATILE;


-- ============================================================
-- 52. CARDINALITY
-- ============================================================

ALTER TABLE test_alter
    VOLATILE CARDINALITY;


-- ============================================================
-- 53. COMPRESS YES
-- ============================================================

ALTER TABLE test_alter
    COMPRESS YES;


-- ============================================================
-- 54. COMPRESS NO
-- ============================================================

ALTER TABLE test_alter
    COMPRESS NO;


-- ============================================================
-- 55. COMPRESS ADAPTIVE
-- ============================================================

ALTER TABLE test_alter
    COMPRESS YES ADAPTIVE;


-- ============================================================
-- 56. VALUE COMPRESSION
-- ============================================================

ALTER TABLE test_alter
    COMPRESS YES
        ADAPTIVE
        VALUE COMPRESSION;


-- ============================================================
-- 57. LOG INDEX BUILD
-- ============================================================

ALTER TABLE test_alter
    LOG INDEX BUILD on;


-- ============================================================
-- 58. NULL ON / OFF
-- ============================================================

ALTER TABLE test_alter
    LOG INDEX BUILD
        NULL;


ALTER TABLE test_alter
    LOG INDEX BUILD
         OFF;


-- ============================================================
-- 59. ACTIVATE ROW ACCESS CONTROL
-- ============================================================

ALTER TABLE test_alter
    ACTIVATE ROW ACCESS CONTROL;


-- ============================================================
-- 60. DEACTIVATE ROW ACCESS CONTROL
-- ============================================================

ALTER TABLE test_alter
    DEACTIVATE ROW ACCESS CONTROL;


-- ============================================================
-- 61. ACTIVATE COLUMN ACCESS CONTROL
-- ============================================================

ALTER TABLE test_alter
    ACTIVATE COLUMN ACCESS CONTROL;


-- ============================================================
-- 62. DEACTIVATE COLUMN ACCESS CONTROL
-- ============================================================

ALTER TABLE test_alter
    DEACTIVATE COLUMN ACCESS CONTROL;


-- ============================================================
-- 63. ADD SECURITY POLICY
-- ============================================================

ALTER TABLE test_alter
    ADD SECURITY POLICY test_security_policy;


-- ============================================================
-- 64. DROP SECURITY POLICY
-- ============================================================

ALTER TABLE test_alter
    DROP SECURITY POLICY;


-- ============================================================
-- 65. ADD VERSIONING
-- ============================================================

ALTER TABLE test_alter
    ADD VERSIONING
        USE HISTORY TABLE test_alter_history;


