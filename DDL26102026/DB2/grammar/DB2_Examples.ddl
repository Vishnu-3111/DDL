  c1 INTEGER NOT NULL,
  c2 INTEGER
) ORGANIZE BY ROW;

CREATE TABLE t1_shadow AS
    (SELECT c1, c2 FROM t1)
  DATA INITIALLY DEFERRED
  REFRESH DEFERRED
  MAINTAINED BY REPLICATION
  ORGANIZE BY COLUMN;
  
