ALTER MODULE hr_module
ADD PROCEDURE calculate_salary (employee_id INT, bonus DECIMAL(10, 2))
SPECIFIC calc_salary_sp
DYNAMIC RESULT SETS 1
BEGIN
    DECLARE salary DECIMAL(10, 2);
    -- Calculate salary based on some logic
    SET salary = (SELECT base_salary + bonus FROM employees WHERE id = employee_id);
    -- Return the result set
    RETURN salary;
END;

