ALTER MODULE finance_module
ADD FUNCTION calculate_interest (principal DECIMAL(10, 2), rate FLOAT, years INT)
RETURNS DECIMAL(10, 2)
SPECIFIC calc_interest_sp
BEGIN
    DECLARE interest DECIMAL(10, 2);
    -- Simple interest calculation
    SET interest = principal * rate * years;
    RETURN interest;
END;

