CREATE TABLE TDEPT
 (DEPTNO   CHAR(3)     NOT NULL,
  DEPTNAME VARCHAR(36) NOT NULL,
  MGRNO    CHAR(6),
  ADMRDEPT CHAR(3)     NOT NULL,
  PRIMARY KEY(DEPTNO))
IN DEPARTX
   
CREATE TABLE "schem".PROJ
 (PROJNO   CHAR(6)      NOT NULL,
  PROJNAME VARCHAR(24)  NOT NULL,
  DEPTNO   CHAR(3)      NOT NULL,
  RESPEMP  CHAR(6)      NOT NULL,
  PRSTAFF  DECIMAL(5,2)         ,
  PRSTDATE DATE                 ,
  PRENDATE DATE                 ,
  MAJPROJ  CHAR(6)      NOT NULL)
IN SCHED
   
CREATE TABLE schem.EMPLOYEE_SALARY
(DEPTNO   CHAR(3)      NOT NULL,
DEPTNAME VARCHAR(36)  NOT NULL,
EMPNO    CHAR(6)      NOT NULL,
SALARY   DECIMAL(9,2) NOT NULL WITH DEFAULT)

CREATE TABLE EMPLOYEE1
     (ID          INTEGER NOT NULL,
      NAME        CHAR (30),
      SALARY      T_SALARY NOT NULL WITH DEFAULT,
      LIVING_DIST MILES    DEFAULT MILES(1) )
      
CREATE TABLE PERSON
     (SSN    INTEGER NOT NULL,
      NAME   CHAR (30),
      VOICE  AUDIO,
      PHOTO  IMAGE)
      
      
CREATE TABLE EMPLOYEE2
     (ID          SMALLINT NOT NULL,
      NAME        VARCHAR(9),
      DEPT        SMALLINT CHECK (DEPT BETWEEN 10 AND 100),
      JOB         CHAR(5) CHECK (JOB IN ('Sales','Mgr','Clerk')),
      HIREDATE    DATE,
      SALARY      DECIMAL(7,2),
      COMM        DECIMAL(7,2),
      PRIMARY KEY (ID),
      CONSTRAINT  YEARSAL CHECK (YEAR(HIREDATE) > 1986
        OR SALARY > 40500)
     )
     IN HUMRES
     
CREATE TABLE PROJECT1
(
      PROJNO      CHAR(6) NOT NULL,
      CONSTRAINT PK_PROJ PRIMARY KEY (PROJNO)
)
     
CREATE TABLE EMP_ACT
     (EMPNO       CHAR(6) NOT NULL,
      PROJNO      CHAR(6) NOT NULL,
      ACTNO       SMALLINT NOT NULL,
      EMPTIME     DECIMAL(5,2),
      EMSTDATE    DATE,
      EMENDATE    DATE,
      CONSTRAINT EMP_ACT_UNIQ UNIQUE (EMPNO,PROJNO,ACTNO),
      CONSTRAINT FK_ACT_PROJ FOREIGN KEY (PROJNO)
                             REFERENCES schem.PROJECT1 (PROJNO) ON DELETE CASCADE
     )
     IN SCHED
     
CREATE TABLE HOCKEY_GOALS
 ( BY_PLAYER      VARCHAR(30)   NOT NULL,
   BY_TEAM        VARCHAR(30)   NOT NULL,
   AGAINST_PLAYER VARCHAR(30)   NOT NULL,
   AGAINST_TEAM   VARCHAR(30)   NOT NULL,
   DATE_OF_GOAL   DATE          NOT NULL,
   DESCRIPTION    CLOB(5000) )
   
CREATE TABLE EXCEPTION_EMPLOYEE AS
     (SELECT EMPLOYEE.*,
       CURRENT TIMESTAMP AS TIMESTAMP,
       CAST ('' AS CLOB(32K)) AS MSG
     FROM EMPLOYEE
     ) WITH NO DATA
     
CREATE TABLE DOCUMENTS1
 (SUMMARY    VARCHAR(1000),
  REPORT     VARCHAR(2000))
  
CREATE TABLE CURRICULUM
 (SUMMARY    VARCHAR(1000),
  REPORT     VARCHAR(2000),
  EXERCISES  VARCHAR(1500))
  
CREATE TABLE DEPT
 (DEPTNO     SMALLINT      NOT NULL
    
    GENERATED ALWAYS AS IDENTITY  (START WITH 500, INCREMENT BY 1),
  DEPTNAME   VARCHAR(36)   NOT NULL,
  MGRNO      CHAR(6),
  ADMRDEPT   SMALLINT      NOT NULL,
  LOCATION   CHAR(30))
  
CREATE TABLE SALES1
     (CUSTOMER   VARCHAR(80),
      REGION     CHAR(5),
      YEAR       INTEGER)
   DISTRIBUTE BY HASH (YEAR)
   ORGANIZE BY DIMENSIONS (REGION, YEAR)
   
CREATE TABLE SALES2
     (CUSTOMER            VARCHAR(80),
      REGION              CHAR(5),
      PURCHASEDATE        DATE,
      PURCHASEYEARMONTH   INTEGER
                             GENERATED ALWAYS AS (INTEGER(PURCHASEDATE)/100))
   DISTRIBUTE BY HASH (REGION)
   ORGANIZE BY DIMENSIONS (PURCHASEYEARMONTH)
   
CREATE TABLE CUSTOMER1
     (CUSTOMERNUM      INTEGER,
      CUSTOMERNAME     VARCHAR(80),
      ADDRESS          VARCHAR(200),
      CITY             VARCHAR(50),
      COUNTRY          VARCHAR(50),
      CODE             VARCHAR(15),
      CUSTOMERNUMDIM   INTEGER
                          GENERATED ALWAYS AS (CUSTOMERNUM/50))
   ORGANIZE BY DIMENSIONS (CUSTOMERNUMDIM)
   
CREATE TABLE EMPLOYEE3
     (EMP_NO       CHAR(6)       NOT NULL,
      FIRST_NAME   VARCHAR(12)   NOT NULL,
      MID_INT      CHAR(1)       NOT NULL,
      LAST_NAME    VARCHAR(15)   NOT NULL,
      HIRE_DATE    DATE,
      JOB          CHAR(8),
      SALARY       DECIMAL(9,2),
      PRIMARY KEY (EMP_NO))
   OPTIONS
     (REMOTE_SERVER 'ORASERVER',
      REMOTE_SCHEMA 'J15USER1',
      REMOTE_TABNAME 'EMPLOYEE')
      
CREATE TABLE STUDENTS1
     (SCHOOL_ID     INTEGER   NOT NULL,
      PROGRAM_ID    INTEGER   NOT NULL,
      STUDENT_NUM   INTEGER   NOT NULL,
      STUDENT_ID    INTEGER   NOT NULL,
      FIRST_NAME    CHAR(30),
      LAST_NAME     CHAR(30),
      GPA           DOUBLE)
   ORGANIZE BY KEY SEQUENCE
     (STUDENT_ID
       STARTING FROM 1
       ENDING AT 1000000)
     DISALLOW OVERFLOW
     
CREATE TABLE DEPARTMENT
     (DEPTNO     SMALLINT      NOT NULL,
      DEPTNAME   VARCHAR(36)   NOT NULL,
      MGRNO      CHAR(6),
      ADMRDEPT   SMALLINT      NOT NULL,
      LOCATION   CHAR(30),
     CHECK (DEPTNAME DETERMINED BY DEPTNO) NOT ENFORCED)
     
CREATE TABLE TOASTMASTERS1
