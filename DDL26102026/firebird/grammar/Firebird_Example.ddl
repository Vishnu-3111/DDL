select fieldcount,
  count(relation) as num_tables
from (select r.rdb$relation_name as relation,
        count(*) as fieldcount
      from rdb$relations 
         join rdb$relation_fields  rf
          on rf.rdb$relation_name = r.rdb$relation_name
      group by relation)
group by fieldcount


