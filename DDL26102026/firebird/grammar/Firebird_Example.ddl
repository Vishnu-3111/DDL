INSERT INTO People
VALUES (_ISO8859_1 'Hans-Jörg Schäfer');

INSERT INTO cars (make, model, year)
  SELECT make, model, year
  FROM new_cars;

INSERT INTO cars
  SELECT * FROM new_cars;

INSERT INTO Members (number, name)
  SELECT number, name FROM NewMembers
    WHERE Accepted = 1
UNION ALL
  SELECT number, name FROM SuspendedMembers
    WHERE Vindicated = 1

INSERT INTO numbers(num)
  WITH RECURSIVE r(n) as (
    SELECT 1 FROM rdb$database
    UNION ALL
    SELECT n+1 FROM r WHERE n < 100
  )
SELECT n FROM r  ;


UPDATE People
  SET firstname = 'Boris'
  WHERE lastname = 'Johnson';

UPDATE employee e
  SET salary = salary * 1.05
  WHERE EXISTS(
         SELECT *
           FROM employee_project ep
           WHERE e.emp_no = ep.emp_no);
		   
UPDATE employees
SET salary = salary + 50
ORDER BY salary ASC
ROWS 20;

UPDATE Scholars
SET firstname = 'Hugh', lastname = 'Pickering'
WHERE firstname = 'Henry' and lastname = 'Higgins'
RETURNING id, old.lastname, new.lastname;


UPDATE OR INSERT INTO Cows (Name, Number, Location)
  VALUES ('Suzy Creamcheese', 3278823, 'Green Pastures')
  MATCHING (Number)
  RETURNING old.*, new.*
  
DELETE FROM employee e
  WHERE NOT EXISTS(
    SELECT *
    FROM employee_project ep
     WHERE e.emp_no = ep.emp_no);
	 

DELETE FROM Cities
  WHERE CURRENT OF Cur_Cities;

DELETE FROM Submissions
  WHERE date_entered < '1-Jan-2002'
  PLAN (Submissions INDEX ix_subm_date);
  
DELETE FROM Sales
  ORDER BY custno DESC ROWS 1 to 10;
  
DELETE FROM Dumbbells
  ORDER BY iq DESC
  ROWS 1
  RETURNING lastname, iq into :lname, :iq;
  
  
MERGE INTO PRODUCT_INVENTORY AS TARGET
USING (
  SELECT
    SL.ID_PRODUCT,
    SUM(SL.QUANTITY)
  FROM SALES_ORDER_LINE SL
  JOIN SALES_ORDER  S ON S.ID = SL.ID_SALES_ORDER
  WHERE S.BYDATE = CURRENT_DATE
  AND SL.ID_PRODUCT = ID_PRODUCT
  GROUP BY 1
) AS SRC (ID_PRODUCT, QUANTITY)
ON TARGET.ID_PRODUCT = SRC.ID_PRODUCT
WHEN MATCHED AND TARGET.QUANTITY - SRC.QUANTITY  THEN
  DELETE
WHEN MATCHED THEN
  UPDATE SET
    TARGET.QUANTITY = TARGET.QUANTITY - SRC.QUANTITY,
    TARGET.BYDATE = CURRENT_DATE
RETURNING OLD.QUANTITY, NEW.QUANTITY, SRC.QUANTITY
INTO : OLD_QUANTITY, :NEW_QUANTITY, :DIFF_QUANTITY

EXECUTE BLOCK
AS
declare i INT = 0;
BEGIN
  WHILE (i < 128) DO
  BEGIN
    INSERT INTO AsciiTable VALUES (:i, ascii_char(:i));
    i = i + 1;
  END
END

EXECUTE BLOCK (x DOUBLE PRECISION = ?, y DOUBLE PRECISION = ?)
RETURNS (gmean DOUBLE PRECISION)
AS
BEGIN
  gmean = SQRT(x*y);
  SUSPEND;
END

EXECUTE BLOCK (smallest INT = ?, largest INT = ?)
RETURNS (number INT, square BIGINT, cube BIGINT, fourth BIGINT)
AS
BEGIN
  number = smallest;
  WHILE (number <= largest) DO
  BEGIN
    square = number * number;
    cube   = number * square;
    fourth = number * cube;
    SUSPEND;
    number = number + 1;
  END
END

SET TRANSACTION
  READ WRITE
  WAIT
  ISOLATION LEVEL SNAPSHOT;
  
COMMIT;

SAVEPOINT Y;

ROLLBACK TO Y;

CREATE ROLE SELECT_ALL
  SET SYSTEM PRIVILEGES TO SELECT_ANY_OBJECT_IN_DATABASE;
  
ALTER ROLE SELECT_ALL
  SET SYSTEM PRIVILEGES TO SELECT_ANY_OBJECT_IN_DATABASE;
  
ALTER ROLE SELLERS
  DROP SYSTEM PRIVILEGES;
  
DROP ROLE SELLERS;


EXECUTE PROCEDURE MakeFullName
  :FirstName, :MiddleName, :LastName
  RETURNING_VALUES :FullName;
  
  
EXECUTE PROCEDURE MakeFullName ('J', 'Edgar', 'Hoover');

EXECUTE PROCEDURE MakeFullName
  ('Mr./Mrs. ' || FirstName, MiddleName, upper(LastName))
  RETURNING_VALUES (FullName);
  
  
WITH RECURSIVE PEDIGREE (
  CODE_HORSE,
  CODE_FATHER,
  CODE_MOTHER,
  NAME,
  MARK,
  DEPTH)
AS (SELECT
      HORSE.CODE_HORSE,
      HORSE.CODE_FATHER,
      HORSE.CODE_MOTHER,
      HORSE.NAME,
      CAST('' AS VARCHAR(80)),
      0
    FROM
      HORSE
    WHERE
      HORSE.CODE_HORSE = CODE_HORSE
    UNION ALL
    SELECT
      HORSE.CODE_HORSE,
      HORSE.CODE_FATHER,
      HORSE.CODE_MOTHER,
      HORSE.NAME,
      'F' || PEDIGREE.MARK,
      PEDIGREE.DEPTH + 1
    FROM
      HORSE
      JOIN PEDIGREE
        ON HORSE.CODE_HORSE = PEDIGREE.CODE_FATHER
    WHERE
      PEDIGREE.DEPTH < MAX_DEPTH
    UNION ALL
    SELECT
      HORSE.CODE_HORSE,
      HORSE.CODE_FATHER,
      HORSE.CODE_MOTHER,
      HORSE.NAME,
      'M' || PEDIGREE.MARK,
      PEDIGREE.DEPTH + 1
    FROM
      HORSE
      JOIN PEDIGREE
        ON HORSE.CODE_HORSE = PEDIGREE.CODE_MOTHER
    WHERE
      PEDIGREE.DEPTH < MAX_DEPTH
)
SELECT
  CODE_HORSE,
  NAME,
  MARK,
  DEPTH
FROM
  PEDIGREE ;
  
  
  
  WITH RECURSIVE DEPT_YEAR_BUDGET AS (
  SELECT
      FISCAL_YEAR,
      DEPT_NO,
      SUM(PROJECTED_BUDGET) BUDGET
  FROM PROJ_DEPT_BUDGET
  GROUP BY FISCAL_YEAR, DEPT_NO
)
SELECT
    D.DEPT_NO,
    D.INDENT || D.DEPARTMENT DEPARTMENT,
    DYB_2008.BUDGET AS BUDGET_08,
    DYB_2009.BUDGET AS BUDGET_09
FROM DEPT_TREE D
    LEFT JOIN DEPT_YEAR_BUDGET DYB_2008 ON
      D.DEPT_NO = DYB_2008.DEPT_NO AND
      DYB_2008.FISCAL_YEAR = 2008
    LEFT JOIN DEPT_YEAR_BUDGET DYB_2009 ON
      D.DEPT_NO = DYB_2009.DEPT_NO AND
      DYB_2009.FISCAL_YEAR = 2009;
	  
-- ============================================================
-- FIREBIRD ALTER TABLE - COMPLETE TEST SCRIPT
-- ============================================================

-- ------------------------------------------------------------
-- BASE TABLES
-- ------------------------------------------------------------

CREATE TABLE test_parent (
    id INTEGER PRIMARY KEY,
    code VARCHAR(30) UNIQUE
);

CREATE TABLE test_alter (
    id INTEGER,
    code VARCHAR(30),
    amount DECIMAL(10,2),
    quantity INTEGER,
    name VARCHAR(100),
    status VARCHAR(20),
    parent_id INTEGER
);

-- ============================================================
-- 1. ADD COLUMN
-- ============================================================

ALTER TABLE test_alter
    ADD new_integer INTEGER;

ALTER TABLE test_alter
    ADD new_code VARCHAR(30);

ALTER TABLE test_alter
    ADD new_amount DECIMAL(10,2);

-- ADD COLUMN WITH DEFAULT

ALTER TABLE test_alter
    ADD new_default INTEGER DEFAULT 100;

-- ADD COLUMN WITH NOT NULL

ALTER TABLE test_alter
    ADD new_required INTEGER NOT NULL;

-- ADD COLUMN WITH DEFAULT + NOT NULL

ALTER TABLE test_alter
    ADD new_status INTEGER DEFAULT 0 NOT NULL;

-- ============================================================
-- 2. ADD COLUMN WITH COLUMN-LEVEL PRIMARY KEY
-- ============================================================

ALTER TABLE test_alter
    ADD new_pk INTEGER
        CONSTRAINT pk_new_pk PRIMARY KEY;

-- ============================================================
-- 3. ADD COLUMN WITH COLUMN-LEVEL UNIQUE
-- ============================================================

ALTER TABLE test_alter
    ADD new_unique VARCHAR(30)
        CONSTRAINT uq_new_unique UNIQUE;

-- ============================================================
-- 4. ADD COLUMN WITH COLUMN-LEVEL CHECK
-- ============================================================

ALTER TABLE test_alter
    ADD new_check INTEGER
        CONSTRAINT chk_new_check
        CHECK (new_check IS NULL OR new_check >= 0);

-- ============================================================
-- 5. ADD COLUMN WITH COLUMN-LEVEL FOREIGN KEY
-- ============================================================

ALTER TABLE test_alter
    ADD new_parent INTEGER
        CONSTRAINT fk_new_parent
        REFERENCES test_parent(id);

-- ============================================================
-- 6. ADD TABLE-LEVEL PRIMARY KEY
-- ============================================================

ALTER TABLE test_alter
    ADD CONSTRAINT pk_test_alter
        PRIMARY KEY (id);

-- ============================================================
-- 7. ADD TABLE-LEVEL UNIQUE
-- ============================================================

ALTER TABLE test_alter
    ADD CONSTRAINT uq_test_alter_code
        UNIQUE (code);

-- ============================================================
-- 8. ADD TABLE-LEVEL CHECK
-- ============================================================

ALTER TABLE test_alter
    ADD CONSTRAINT chk_test_alter_amount
        CHECK (amount IS NULL OR amount >= 0);

-- ============================================================
-- 9. ADD TABLE-LEVEL FOREIGN KEY
-- ============================================================

ALTER TABLE test_alter
    ADD CONSTRAINT fk_test_alter_parent
        FOREIGN KEY (parent_id)
        REFERENCES test_parent(id);

-- ============================================================
-- 10. ADD FOREIGN KEY WITH DELETE ACTION
-- ============================================================

ALTER TABLE test_alter
    ADD CONSTRAINT fk_test_alter_parent_delete
        FOREIGN KEY (parent_id)
        REFERENCES test_parent(id)
        ON DELETE CASCADE;

-- ============================================================
-- 11. ADD FOREIGN KEY WITH UPDATE ACTION
-- ============================================================

ALTER TABLE test_alter
    ADD CONSTRAINT fk_test_alter_parent_update
        FOREIGN KEY (parent_id)
        REFERENCES test_parent(id)
        ON UPDATE CASCADE;

-- ============================================================
-- 12. ADD FOREIGN KEY WITH DELETE + UPDATE ACTION
-- ============================================================

ALTER TABLE test_alter
    ADD CONSTRAINT fk_test_alter_parent_actions
        FOREIGN KEY (parent_id)
        REFERENCES test_parent(id)
        ON DELETE SET NULL
        ON UPDATE CASCADE;

-- ============================================================
-- 13. DROP COLUMN
-- ============================================================

ALTER TABLE test_alter
    DROP new_code;

-- ============================================================
-- 14. DROP CONSTRAINT
-- ============================================================

ALTER TABLE test_alter
    DROP CONSTRAINT uq_test_alter_code;

-- ============================================================
-- 15. ALTER COLUMN - RENAME
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN name TO customer_name;

-- ============================================================
-- 16. ALTER COLUMN - POSITION
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN customer_name POSITION 2;

-- ============================================================
-- 17. ALTER COLUMN - TYPE
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN amount TYPE DECIMAL(12,2);

-- ============================================================
-- 18. ALTER COLUMN - SET DEFAULT
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN amount SET DEFAULT 100;

-- ============================================================
-- 19. ALTER COLUMN - DROP DEFAULT
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN amount DROP DEFAULT;

-- ============================================================
-- 20. ALTER COLUMN - SET NOT NULL
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN customer_name SET NOT NULL;

-- ============================================================
-- 21. ALTER COLUMN - DROP NOT NULL
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN customer_name DROP NOT NULL;

-- ============================================================
-- 22. ALTER COLUMN - COMPUTED BY
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN amount
    COMPUTED BY (quantity * 10);

-- ============================================================
-- 23. ALTER COLUMN - COMPUTED BY WITH TYPE
-- ============================================================

ALTER TABLE test_alter
    ALTER COLUMN amount
    TYPE DECIMAL(12,2)
    COMPUTED BY (quantity * 10);

-- ============================================================
-- 24. ALTER COLUMN - IDENTITY GENERATED ALWAYS
-- ============================================================

CREATE TABLE test_identity_alter (
    id INTEGER GENERATED BY DEFAULT AS IDENTITY,
    name VARCHAR(100)
);

ALTER TABLE test_identity_alter
    ALTER COLUMN id SET GENERATED ALWAYS;

-- ============================================================
-- 25. ALTER COLUMN - IDENTITY GENERATED BY DEFAULT
-- ============================================================

ALTER TABLE test_identity_alter
    ALTER COLUMN id SET GENERATED BY DEFAULT;

-- ============================================================
-- 26. ALTER COLUMN - IDENTITY RESTART
-- ============================================================

ALTER TABLE test_identity_alter
    ALTER COLUMN id RESTART;

-- ============================================================
-- 27. ALTER COLUMN - IDENTITY RESTART WITH
-- ============================================================

ALTER TABLE test_identity_alter
    ALTER COLUMN id RESTART WITH 1000;

-- ============================================================
-- 28. ALTER COLUMN - IDENTITY SET INCREMENT
-- ============================================================

ALTER TABLE test_identity_alter
    ALTER COLUMN id SET INCREMENT BY 10;

-- ============================================================
-- 29. ALTER COLUMN - DROP IDENTITY
-- ============================================================

ALTER TABLE test_identity_alter
    ALTER COLUMN id DROP IDENTITY;

-- ============================================================
-- 30. SQL SECURITY INVOKER
-- ============================================================

ALTER TABLE test_alter
    ALTER SQL SECURITY INVOKER;

-- ============================================================
-- 31. SQL SECURITY DEFINER
-- ============================================================

ALTER TABLE test_alter
    ALTER SQL SECURITY DEFINER;

-- ============================================================
-- 32. DROP SQL SECURITY
-- ============================================================

ALTER TABLE test_alter
    DROP SQL SECURITY;

-- ============================================================
-- 33. ENABLE PUBLICATION
-- ============================================================

ALTER TABLE test_alter
    ENABLE PUBLICATION;

-- ============================================================
-- 34. DISABLE PUBLICATION
-- ============================================================

ALTER TABLE test_alter
    DISABLE PUBLICATION;