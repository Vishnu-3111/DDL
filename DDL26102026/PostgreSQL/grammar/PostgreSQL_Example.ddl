-- PostgreSQL ALTER TABLE - syntax coverage

CREATE TABLE test_alter_parent (
    id INTEGER PRIMARY KEY using index Tablespace nameoftable,
    name TEXT
);

CREATE TABLE test_alter (
    id INTEGER,
    name TEXT,
    amount NUMERIC,
    status TEXT,
    parent_id INTEGER,
    generated_value INTEGER GENERATED ALWAYS AS (amount::INTEGER * 2) STORED
);

-- ADD COLUMN
ALTER TABLE test_alter
    ADD COLUMN new_col INTEGER;

ALTER TABLE test_alter
    ADD COLUMN IF NOT EXISTS new_col2 INTEGER;

-- ADD COLUMN with constraints
ALTER TABLE test_alter
    ADD COLUMN constrained_col INTEGER
        CONSTRAINT chk_constrained CHECK (constrained_col >= 0)
       ;

ALTER TABLE test_alter
    ADD COLUMN unique_col INTEGER
        CONSTRAINT uq_unique_col UNIQUE;

ALTER TABLE test_alter
    ADD COLUMN fk_col INTEGER
        REFERENCES test_alter_parent(id)
        ON DELETE CASCADE
        ON UPDATE SET NULL;

-- DROP COLUMN
ALTER TABLE test_alter
    DROP COLUMN new_col;

ALTER TABLE test_alter
    DROP COLUMN IF EXISTS new_col2 CASCADE;

-- ALTER COLUMN TYPE
ALTER TABLE test_alter
    ALTER COLUMN amount SET DATA TYPE NUMERIC(12,2);

-- ALTER COLUMN COLLATE
ALTER TABLE test_alter
    ALTER COLUMN name TYPE TEXT COLLATE "C";

-- DEFAULT
ALTER TABLE test_alter
    ALTER COLUMN status SET DEFAULT 'ACTIVE';

ALTER TABLE test_alter
    ALTER COLUMN status DROP DEFAULT;

-- NOT NULL / NULL
ALTER TABLE test_alter
    ALTER COLUMN status SET NOT NULL;

ALTER TABLE test_alter
    ALTER COLUMN status DROP NOT NULL;

-- GENERATED EXPRESSION
ALTER TABLE test_alter
    ALTER COLUMN generated_value
    SET EXPRESSION AS (amount::INTEGER * 3);

ALTER TABLE test_alter
    ALTER COLUMN generated_value
    DROP EXPRESSION;

-- IDENTITY
ALTER TABLE test_alter
    ADD COLUMN identity_col INTEGER
        GENERATED BY DEFAULT AS IDENTITY;

ALTER TABLE test_alter
    ALTER COLUMN identity_col SET GENERATED ALWAYS;

ALTER TABLE test_alter
    ALTER COLUMN identity_col SET GENERATED BY DEFAULT;

ALTER TABLE test_alter
    ALTER COLUMN identity_col RESTART WITH 100;

ALTER TABLE test_alter
    ALTER COLUMN identity_col RESTART 200;

ALTER TABLE test_alter
    ALTER COLUMN identity_col SET INCREMENT BY 5;

ALTER TABLE test_alter
    ALTER COLUMN identity_col DROP IDENTITY;

-- STATISTICS
ALTER TABLE test_alter
    ALTER COLUMN amount SET STATISTICS 500;

ALTER TABLE test_alter
    ALTER COLUMN amount SET STATISTICS DEFAULT;

-- ATTRIBUTE OPTIONS
ALTER TABLE test_alter
    ALTER COLUMN amount SET (n_distinct = 100);

ALTER TABLE test_alter
    ALTER COLUMN amount RESET (n_distinct);

-- STORAGE
ALTER TABLE test_alter
    ALTER COLUMN name SET STORAGE EXTENDED;

ALTER TABLE test_alter
    ALTER COLUMN name SET STORAGE MAIN;

ALTER TABLE test_alter
    ALTER COLUMN name SET STORAGE EXTERNAL;

ALTER TABLE test_alter
    ALTER COLUMN name SET STORAGE PLAIN;

ALTER TABLE test_alter
    ALTER COLUMN name SET STORAGE DEFAULT;

-- COMPRESSION
ALTER TABLE test_alter
    ALTER COLUMN name SET COMPRESSION pglz;

ALTER TABLE test_alter
    ALTER COLUMN name SET COMPRESSION default;

-- ADD CHECK constraint
ALTER TABLE test_alter
    ADD CONSTRAINT chk_amount CHECK (amount >= 0);

ALTER TABLE test_alter
    ADD CONSTRAINT chk_status CHECK (status IS NOT NULL) NOT VALID;

-- ADD NOT NULL table constraint
ALTER TABLE test_alter
    ADD CONSTRAINT nn_name NOT NULL name;

-- ADD UNIQUE
ALTER TABLE test_alter
    ADD CONSTRAINT uq_test_alter UNIQUE (name);

ALTER TABLE test_alter
    ADD CONSTRAINT uq_test_alter_nulls UNIQUE NULLS NOT DISTINCT (status);

-- ADD PRIMARY KEY
ALTER TABLE test_alter
    ADD CONSTRAINT pk_test_alter PRIMARY KEY (id);

-- ADD FOREIGN KEY
ALTER TABLE test_alter
    ADD CONSTRAINT fk_test_alter
    FOREIGN KEY (parent_id)
    REFERENCES test_alter_parent(id)
    MATCH SIMPLE
    ON DELETE CASCADE
    ON UPDATE CASCADE;

ALTER TABLE test_alter
    ADD CONSTRAINT fk_test_alter_setnull
    FOREIGN KEY (parent_id)
    REFERENCES test_alter_parent(id)
    ON DELETE SET NULL
    ON UPDATE SET DEFAULT
    NOT VALID;

-- DEFERRABLE constraints
ALTER TABLE test_alter
    ADD CONSTRAINT uq_deferred UNIQUE (status)
    DEFERRABLE INITIALLY DEFERRED;

-- EXCLUDE constraint
CREATE EXTENSION IF NOT EXISTS btree_gist;



-- Constraint options
ALTER TABLE test_alter
    ALTER CONSTRAINT fk_test_alter
    DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE test_alter
    ALTER CONSTRAINT fk_test_alter
    NOT DEFERRABLE;

ALTER TABLE test_alter
    ALTER CONSTRAINT fk_test_alter
    ENFORCED;

ALTER TABLE test_alter
    ALTER CONSTRAINT fk_test_alter
    NOT ENFORCED;

-- Constraint inheritance
ALTER TABLE test_alter
    ALTER CONSTRAINT nn_name INHERIT;

ALTER TABLE test_alter
    ALTER CONSTRAINT nn_name NO INHERIT;

-- VALIDATE constraint
ALTER TABLE test_alter
    VALIDATE CONSTRAINT chk_status;

ALTER TABLE test_alter
    VALIDATE CONSTRAINT fk_test_alter_setnull;

-- DROP constraint
ALTER TABLE test_alter
    DROP CONSTRAINT chk_amount;

ALTER TABLE test_alter
    DROP CONSTRAINT IF EXISTS chk_status CASCADE;

-- DISABLE / ENABLE TRIGGER
ALTER TABLE test_alter
    DISABLE TRIGGER ALL;

ALTER TABLE test_alter
    ENABLE TRIGGER ALL;

ALTER TABLE test_alter
    DISABLE TRIGGER USER;

ALTER TABLE test_alter
    ENABLE TRIGGER USER;

ALTER TABLE test_alter
    ENABLE REPLICA TRIGGER trigger_name;

ALTER TABLE test_alter
    ENABLE ALWAYS TRIGGER trigger_name;

-- DISABLE / ENABLE RULE
ALTER TABLE test_alter
    DISABLE RULE rewrite_rule_name;

ALTER TABLE test_alter
    ENABLE RULE rewrite_rule_name;

ALTER TABLE test_alter
    ENABLE REPLICA RULE rewrite_rule_name;

ALTER TABLE test_alter
    ENABLE ALWAYS RULE rewrite_rule_name;

-- ROW LEVEL SECURITY
ALTER TABLE test_alter
    DISABLE ROW LEVEL SECURITY;

ALTER TABLE test_alter
    ENABLE ROW LEVEL SECURITY;

ALTER TABLE test_alter
    FORCE ROW LEVEL SECURITY;

ALTER TABLE test_alter
    NO FORCE ROW LEVEL SECURITY;

-- CLUSTER
ALTER TABLE test_alter
    CLUSTER ON index_name;

ALTER TABLE test_alter
    SET WITHOUT CLUSTER;

-- ACCESS METHOD
ALTER TABLE test_alter
    SET ACCESS METHOD heap;

ALTER TABLE test_alter
    SET ACCESS METHOD DEFAULT;

-- LOGGED / UNLOGGED
ALTER TABLE test_alter
    SET LOGGED;

ALTER TABLE test_alter
    SET UNLOGGED;

-- STORAGE PARAMETERS
ALTER TABLE test_alter
    SET (fillfactor = 80);

ALTER TABLE test_alter
    SET (fillfactor = 90, autovacuum_enabled = true);

ALTER TABLE test_alter
    RESET (fillfactor);

-- INHERIT
ALTER TABLE test_alter
    INHERIT test_alter_parent;

ALTER TABLE test_alter
    NO INHERIT test_alter_parent;

-- TYPE
ALTER TABLE test_alter
    OF test_type;

ALTER TABLE test_alter
    NOT OF;

-- OWNER
ALTER TABLE test_alter
    OWNER TO CURRENT_USER;

ALTER TABLE test_alter
    OWNER TO CURRENT_ROLE;

ALTER TABLE test_alter
    OWNER TO SESSION_USER;

-- REPLICA IDENTITY
ALTER TABLE test_alter
    REPLICA IDENTITY DEFAULT;

ALTER TABLE test_alter
    REPLICA IDENTITY FULL;

ALTER TABLE test_alter
    REPLICA IDENTITY NOTHING;

ALTER TABLE test_alter
    REPLICA IDENTITY USING INDEX test_unique_index;

-- RENAME COLUMN
ALTER TABLE test_alter
    RENAME COLUMN name TO new_name;

-- RENAME CONSTRAINT
ALTER TABLE test_alter
    RENAME CONSTRAINT uq_test_alter TO uq_test_alter_new;

-- RENAME TABLE
ALTER TABLE IF EXISTS test_alter
    RENAME TO test_alter_new;

-- SET SCHEMA
ALTER TABLE test_alter_new
    SET SCHEMA public;



ALTER TABLE test_partitioned
    ATTACH PARTITION test_default_partition
    DEFAULT;

-- PARTITION DETACH
ALTER TABLE test_partitioned
    DETACH PARTITION test_partition;

